// =============================================================================
// RELAY — DATA FOUNDATION
// =============================================================================
//
// This file is the whole product's data foundation. `packages/db/src/tenancy.ts`,
// `packages/db/src/sequence.ts`, both seeds, the checked-in migration history,
// every `apps/api` service and every integration test are written against what
// is declared here. Nothing was migrated from existing code: there was none.
// Every table below was authored from the read-only specification under
// `docs/workflows/`, and `docs/decisions/data-model.md` is the narrative
// companion that carries the reasoning this file only summarises.
//
// -----------------------------------------------------------------------------
// HOW THIS FILE CITES
// -----------------------------------------------------------------------------
//
// A document citation names a file under `docs/workflows/` with its line, so
// `README.md` below is the catalogue index in that directory and never the one at
// the repository root. A frame is cited by NUMBER ALONE — every one of the 1,022
// corpus filenames embeds a third-party product name, so a filename citation
// would breach `PROJECT_RULE_R4` while a number does not. No corpus path and no
// image filename appears anywhere in this file.
//
// The five binding project rules are cited by requirement label — `R1` server-side
// authorization, `R2` corpus and specification handling, `R3` uncertainty is never
// permission to omit, `R4` third-party identity exclusion, `R5` a shared component
// is implemented once. Their platform identifiers are deliberately not written
// here, because each of those identifiers embeds the product name `R4` forbids in
// source and in comments. The same convention is held by
// `packages/shared/src/config/constants.ts`, so the two files agree.
//
// ZERO FRAMES WERE OPENED TO AUTHOR THIS FILE. Every fact below was resolved from
// catalogue prose, which `R2` requires to be attempted first and which was
// sufficient throughout. `R5` does not govern this file at all: it declares no
// component contract.
//
// -----------------------------------------------------------------------------
// THE DOC-COMMENT CONTRACT — READ THIS BEFORE ADDING A MODEL
// -----------------------------------------------------------------------------
//
// Every model carries a `///` doc-comment stating three facts, in this order,
// because three separate obligations are discharged mechanically by them:
//
//   1. ENTITY — its `E-*` identifier, or an explicit statement that it is a field
//      group of a named entity, a per-viewer relation, a credential record, a
//      page-content structure, or infrastructure. This is what makes the
//      closed-set check countable off the file itself: grep the file for
//      `ENTITY  E-` and exactly twenty distinct identifiers answer.
//   2. TENANCY — one token from the closed vocabulary below, and the line ALWAYS
//      LEADS WITH THAT TOKEN so the classification is greppable rather than only
//      readable. `packages/db/src/tenancy.ts` holds an EXPLICIT per-model
//      classification rather than a blanket predicate, because some models
//      legitimately carry no tenant key and a blanket predicate would either break
//      them or be quietly relaxed for everything — and a classification it has to
//      infer from prose is a classification it will get wrong.
//
//      The vocabulary is six tokens, not the three an ordinary tenant model needs,
//      because five models genuinely are not ordinary tenant rows and saying so is
//      the point. Every one of the six is a distinct predicate for the extension:
//
//        TENANT-SCOPED     — carries `workspaceId`; the predicate binds to it. 44
//                            models. Two of them carry it NULLABLE and both say why
//                            at the column: `SearchQuery` is MIXED-SCOPE below, and
//                            `AuditLogEntry` must be able to record a denial from a
//                            caller with no workspace resolved yet.
//        CATALOG-GLOBAL    — published data an unauthenticated visitor reads in
//                            full; carries NO tenant key and no traversal into
//                            tenant data. `Plan`, `PlanPromotionalOffer`, `App`.
//        VIEWER-OWNED      — belongs to one account and is readable only by them;
//                            tenant-keyed as well, so both predicates apply.
//        SUBJECT-KEYED     — a credential record reached only through the subject it
//                            authenticates, never enumerated by workspace. A tenant
//                            predicate here would imply a read that LISTS
//                            credentials, and there is none.
//        PUBLIC-SUBMISSION — the marketing population: no tenant key, no account,
//                            no session. A tenant column would make a marketing
//                            read a tenant read.
//        MIXED-SCOPE       — one model whose variance IS a security boundary, so the
//                            extension must branch on a discriminator rather than
//                            apply one predicate. `SearchQuery` alone.
//
//      A new model picks one of the six. A seventh token means a new predicate, and
//      a new predicate belongs in `tenancy.ts` before it appears here.
//   3. RETENTION — the `S-RETENTION` retention class. That contract requires a
//      retention class per data kind "declared where the data is modelled"
//      (`00-product-overview.md` L594), and a doc-comment beside the columns is
//      the honest place for it.
//
// A model that cannot fill all three is not ready to be added.
//
// -----------------------------------------------------------------------------
// CONVENTIONS, PICKED ONCE AND HELD UNIFORMLY
// -----------------------------------------------------------------------------
//
//   - MODEL NAMES are authored PascalCase and describe what the thing does. The
//     `E-*` identifiers are NOT authored and are recorded in the doc-comments.
//     Two models are named away from their identifier because the obvious name
//     would shadow a platform global: `E-FILE` is `StoredFile` and `E-LIST` is
//     `ChannelList`. `E-CHANNEL` is `Conversation`, because the catalogue makes a
//     direct message a variant of the same record (`README.md` L327) and because
//     every constraint that depends on it reads `conversationId`.
//   - PHYSICAL NAMES are snake_case, applied uniformly: every model carries
//     `@@map` and every scalar field carries `@map`. The convention is uniform
//     rather than partial on purpose — `packages/db/src/sequence.ts` takes a
//     row-level lock through raw SQL, and unquoted lowercase identifiers work
//     there directly while a mixed scheme would need quoting on some names and
//     not others.
//   - PRIMARY KEYS are opaque server-generated strings with a structural
//     `cuid()` default. `Message.clientId` is a separate, client-supplied value
//     and is described where it is declared.
//   - ABSOLUTE INSTANTS are `DateTime` with `@db.Timestamptz(3)` everywhere. A
//     timestamp without a zone is a different fact from the one this product
//     needs, and mixing the two is how a deadline becomes ambiguous.
//   - NULLABILITY IS ALWAYS EXPLICIT. A field the catalogue shows as optional is
//     optional; a field it shows as always present is not. An empty string is
//     never stored as a sentinel for "absent".
//   - `@default(...)` IS STRUCTURAL ONLY — `cuid()`, `now()`, `false`, `0`, an
//     enum's neutral member. `R3` forbids a policy value at a point of use, and a
//     schema default is worse than an inline literal because no configuration can
//     ever reach it. There is not one expiry, window, threshold or limit in a
//     default in this file.
//   - NO PREVIEW FEATURE, no second generator, no multi-file split. The boring
//     shape is the supported one.
//
// -----------------------------------------------------------------------------
// TWO READINGS OF THE PER-VIEWER RELATION COUNT, NEITHER ASSERTED
// -----------------------------------------------------------------------------
//
// The catalogue's per-viewer relation table carries TEN body rows, counted at
// source beneath its header (`README.md` L361, rows L363–L372). The project's own
// build specification gives the figure for that same table as ELEVEN. Both
// readings exist and NEITHER IS ASSERTED HERE: no eleventh placement is invented
// to satisfy the larger reading, and neither reading is deleted to tidy the
// smaller one. This file declares exactly the placements the catalogue's table
// carries. `R2` requires a defect in the read-only specification to be recorded
// rather than corrected in place, so the disagreement is described in
// `docs/decisions/catalog-defects.md` and carried in
// `docs/decisions/data-model.md`; it is not diagnosed here.
//
// One consequence for counting this file: nine of the ten placements are join
// tables below, and the tenth — dismissed banners and dismissed explanatory
// blocks — is a placement onto the viewer's own `E-PREFERENCE` record rather than
// a new table. A reader counting tables will therefore find nine, and that is the
// placement being right rather than a placement missing.
// =============================================================================

// -----------------------------------------------------------------------------
// DATASOURCE
// -----------------------------------------------------------------------------
//
// PostgreSQL 16 is the target, and two of its properties are load-bearing rather
// than incidental: a row-level lock inside an ordinary transaction, which is what
// makes the gapless per-conversation counter possible, and NULLs treated as
// distinct in a unique index, which is what lets one constraint deduplicate every
// client-generated send while leaving server-originated messages unconstrained.
//
// `DATABASE_URL` is validated by `packages/shared/src/config/env.ts` and
// documented with a working local default in `.env.example`. It is read from the
// environment and never written here.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// GENERATOR
// -----------------------------------------------------------------------------
//
// NO `output` OVERRIDE, DELIBERATELY. The client generates to its default location
// under `node_modules` and is consumed only through `@prisma/client`. That is a
// package-wide ruling with three consequences that all point the same way: it
// keeps generated code outside `packages/db/tsconfig.json`'s `include`, it is
// already covered by the root `.gitignore`, and it is what `turbo.json`'s
// `outputs` describes.
//
// Prisma 6.19.x emits a deprecation notice about a future release requiring an
// explicit `output`. The notice is ACCEPTED AND NOT ACTED ON: Prisma 7 is
// deliberately not adopted, because the workspace-isolation chokepoint in
// `packages/db/src/tenancy.ts` is built on the 6.x client-extension API and that
// mechanism is what makes isolation provable at the data layer rather than
// conventional. Adding an `output` here to silence the notice would move the
// client into this package, where the compiler and the ignore rules would both
// have to be changed to accommodate it.
generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMERATIONS
// =============================================================================
//
// Every member below is evidenced by the catalogue. Where the catalogue names a
// field but never enumerates its values, the column is a string rather than an
// enum, and says so — inventing members would be authoring behaviour the
// specification does not carry, while dropping the column would be the omission
// `R3` prohibits.

/// How a conversation presents itself.
///
/// The load-bearing field of `E-CHANNEL` and the reason Phase 2's direct messages
/// need NO schema rework. The catalogue records that a direct message has no
/// observable of its own — no hash-prefixed name, no member count, no topic or
/// description, no details pane — while carrying the same bookmark row, header
/// shape, message list and composer, so "the two are variants of one conversation
/// rather than unrelated surfaces" (`README.md` L327). Declaring the discriminator
/// now is what makes that true of the schema and not only of the prose.
enum ConversationType {
  CHANNEL
  DIRECT_MESSAGE

  @@map("conversation_type")
}

/// Who may see a conversation exists and ask to read it.
///
/// Exactly two, and the count is part of the contract rather than an artefact of
/// what happened to be captured: the creation wizard's second step "offers exactly
/// two visibility options" (`02-channels.md` L984), and the pair is convertible in
/// both directions afterwards (`02-channels.md` L782).
///
/// The member order matches `CHANNEL_VISIBILITIES` in
/// `packages/shared/src/config/constants.ts`, which is the single definition point
/// for the set as the product renders it. This enum is the storage form of the
/// same two values, not a second opinion about them.
enum ConversationVisibility {
  PUBLIC
  PRIVATE

  @@map("conversation_visibility")
}

/// Where a message came from.
///
/// A REQUIRED discriminator over an author union whose every branch is OPTIONAL.
/// The catalogue is explicit that "authorship is a union and it is optional on
/// every branch": a message may be authored by a person, posted by an app, sent by
/// a workflow, or emitted by the system with no author at all, "so no single author
/// edge may be mandatory" (`README.md` L411). The diagram says the same three
/// times over, with `may author`, `may post` and `may send` all optional on both
/// ends (`README.md` L429, L444, L445).
///
/// The obvious alternative — a mandatory author with a synthetic account standing
/// in for the system — is rejected and the reason is a leak rather than a taste:
/// a synthetic account is an account, so it appears in member lists, facepiles and
/// autocomplete, which are three of the eight projections `R1` requires to be
/// authorized independently.
enum MessageOrigin {
  PERSON
  APP
  WORKFLOW
  SYSTEM

  @@map("message_origin")
}

/// Which system event a system message reports.
///
/// The catalogue evidences three forms directly on the message entity — an
/// invitation-accepted message authored by the other person and carrying its own
/// notification-suppression affordance, a joined message in the same shape but
/// authored by the reader and carrying none, and a huddle entry rendered with an
/// icon tile and no author name at all (`README.md` L328, frames 110, 299, 301) —
/// and five more as the conversation's own event history: joins, renames quoting
/// both names, description changes quoting the new text, additions of a member by
/// another member, archiving and unarchiving (`02-channels.md` L805, frames 79,
/// 100, 134, 138).
///
/// Every member below is one of those. None is invented, and the sentence each one
/// renders is authored for this product in `packages/shared/src/copy/en.ts` — `R4`
/// permits the event, never the wording a frame shows for it.
enum SystemMessageSubtype {
  INVITATION_ACCEPTED
  MEMBER_JOINED
  MEMBER_ADDED
  CONVERSATION_RENAMED
  CONVERSATION_DESCRIPTION_CHANGED
  CONVERSATION_ARCHIVED
  CONVERSATION_UNARCHIVED
  HUDDLE_ENTRY

  @@map("system_message_subtype")
}

/// Which of the two huddle system-message forms a row renders.
///
/// The catalogue reports the subtype "in two variants": a tinted live variant
/// naming who joined and badged live, with a sub-line naming who else is present or
/// has been notified; and a neutral summary variant titled with the session's topic
/// and timestamped, with a sub-line naming the participants and the elapsed
/// duration (`README.md` L328, frames 268, 300).
enum HuddleMessageVariant {
  LIVE
  SUMMARY

  @@map("huddle_message_variant")
}

/// Where a message is in its own delivery lifecycle.
///
/// Three states, each evidenced: a draft state autosaved without an explicit action
/// and counted on the sidebar's drafts-and-sent row, a scheduled state with a
/// future send time, and a sent state grouped by send date (`README.md` L328,
/// `03-messaging-and-composer.md` L651, frames 361, 362, 363, 342).
///
/// This has NO default. A draft, a scheduled send and a delivered message are three
/// real branches rather than one behaviour with two exceptions, so every writer
/// states which it is creating.
enum MessageDeliveryState {
  DRAFT
  SCHEDULED
  SENT

  @@map("message_delivery_state")
}

/// How much a person wants to hear from one conversation.
///
/// "All messages, mentions or off", surfaced both as a four-option menu and as a
/// radio group (`02-channels.md` L788, frames 89, 90, 96). The fourth menu option
/// is the separate mute flag, which is why it is a column of its own on the
/// membership relation and not a fourth member here.
enum NotificationScope {
  ALL_MESSAGES
  MENTIONS
  OFF

  @@map("notification_scope")
}

/// Which sidebar group a person keeps a conversation in.
///
/// One of the six per-member facts that must not live on the conversation:
/// "membership of a sidebar group — channels, starred, or a user-created section —
/// rendered as grouping and nesting" (`02-channels.md` L804, frames 86, 120). The
/// user-created case names its section, which is why the membership relation
/// carries a section reference beside this discriminator.
enum SidebarPlacement {
  DEFAULT_GROUP
  STARRED_GROUP
  CUSTOM_SECTION

  @@map("sidebar_placement")
}

/// What kind of account a person holds in one workspace.
///
/// Five types, matching the authored capability matrix in
/// `docs/decisions/role-matrix.md` and the role enumeration
/// `apps/api/src/authz/roles.ts` evaluates against. The guest's single-channel and
/// multi-channel forms are two forms of ONE type rather than two types — the
/// multi-channel allowance is a flag on the account, because its stated effect is
/// commercial rather than functional (`README.md` L326, frame 50).
///
/// The matrix itself is AUTHORED, not observed, and that is worth stating where the
/// values are declared. The corpus expresses visible authorization in four frames
/// and is a single authenticated session in one workspace, so it can never show
/// what a different viewer, a different role or a de-authorized viewer would see.
/// `docs/decisions/role-matrix.md` is therefore a precondition for the denial
/// suite rather than a byproduct of it.
enum AccountType {
  OWNER
  ADMIN
  MEMBER
  GUEST
  EXTERNAL_COLLABORATOR

  @@map("account_type")
}

/// How an account counts for billing, which is not a function of its type.
///
/// The catalogue is explicit that this "is not a simple function of account type: a
/// guest permitted to join more than one channel is billed as a full member"
/// (`README.md` L326, frame 50). A derived value would therefore be wrong, so the
/// classification is stored and the multi-channel allowance that drives it is
/// stored beside it.
enum BillingClassification {
  FULL_MEMBER
  GUEST

  @@map("billing_classification")
}

/// A viewer's colour-mode choice, held as a three-option segmented control
/// (`README.md` L342, frame 536).
///
/// This is per-viewer, so it lives on the viewer's own preference record and never
/// on any shared object. `SYSTEM` follows the operating system rather than naming a
/// third mode of its own.
enum ColorMode {
  LIGHT
  DARK
  SYSTEM

  @@map("color_mode")
}

/// How tightly a viewer wants message rows packed.
///
/// Per-viewer, and structural rather than cosmetic: the shell gate requires density
/// to switch "between the avatar-led and compact row anatomies rather than only
/// changing spacing" (`00-product-overview.md` L907, frames 549, 560).
enum MessageDensity {
  COMFORTABLE
  COMPACT

  @@map("message_density")
}

/// What an invitation offers the person who accepts it.
///
/// "Member or guest, the guest option carrying a limitation sub-label"
/// (`README.md` L339, `01-onboarding-and-auth.md` L780, frame 49). An accepted
/// invitation resolves to an `AccountType`; this enum is what was OFFERED, which is
/// a different fact and is why the two sets are not shared.
enum InvitationRole {
  MEMBER
  GUEST

  @@map("invitation_role")
}

/// How far an invitation's grant reaches.
///
/// "Workspace-wide from the full modal and channel-scoped from the reduced one"
/// (`01-onboarding-and-auth.md` L782, frames 40, 364), with the disambiguation
/// dialog stating that the channel-scoped form goes to just that channel
/// (`README.md` L339, frame 65).
enum InvitationScope {
  WORKSPACE
  CONVERSATION

  @@map("invitation_scope")
}

/// Whether a workspace sent an invitation or received one.
///
/// First-class rather than a view: the external register "is divided into received
/// and sent so direction is first-class" (`README.md` L339, frames 501, 502).
enum InvitationDirection {
  SENT
  RECEIVED

  @@map("invitation_direction")
}

/// How an invitation reached its recipient.
///
/// "Stated as email by the form and as email or link by the outbound register"
/// (`README.md` L339, frames 498, 502). Both readings are carried as members
/// because both surfaces are evidence.
enum InvitationDeliveryMechanism {
  EMAIL
  LINK

  @@map("invitation_delivery_mechanism")
}

/// Where an invitation is in its lifecycle.
///
/// The state set is NOT merely pending-or-accepted. The administration console can
/// revoke a pending invitation (`README.md` L339, frame 654), and a request status
/// is tracked on its own tab (`README.md` L339, frame 653), so both are members.
/// `EXPIRED` is not a member: expiry is a comparison against a stored absolute
/// instant, and a stored state would be a second copy of that fact that a clock
/// would silently make wrong.
enum InvitationState {
  REQUESTED
  PENDING
  ACCEPTED
  REVOKED

  @@map("invitation_state")
}

/// What happened when an invitation was delivered.
///
/// Observed as a bounced annotation appended to the recipient address on a pending
/// record (`README.md` L339, frame 654). Only two members are evidenced, and no
/// third is invented.
enum InvitationDeliveryOutcome {
  DELIVERED
  BOUNCED

  @@map("invitation_delivery_outcome")
}

/// What an external organization's members may do in a conversation they are
/// invited into.
///
/// Held "against the organization rather than the person", offering post-and-invite
/// or only-post, where only-post withholds the ability to bring their own coworkers
/// (`README.md` L340, frames 66, 502).
enum ExternalChannelPermission {
  POST_ONLY
  POST_AND_INVITE

  @@map("external_channel_permission")
}

/// Which corpus a stored query was resolved against.
///
/// THIS IS A SECURITY BOUNDARY, NOT A CONVENIENCE. The catalogue says so in those
/// terms: the two corpus scopes "are served by two separate read paths, and a
/// public query is never resolved by the workspace-scoped path — attaching a public
/// unauthenticated query to the reads that carry workspace content is precisely the
/// confusion `S-AUTHZ-READ` exists to prevent" (`README.md` L343).
///
/// The consequence for this schema is that the workspace-scoped variant requires
/// both an actor and a workspace while the public variant may have neither, which
/// is why both of those columns are nullable on the query model and why the
/// nullability is documented there as variance rather than laxity.
enum SearchCorpusScope {
  WORKSPACE
  PUBLIC_HELP

  @@map("search_corpus_scope")
}

/// How a result set was ordered.
///
/// "Most relevant, oldest, newest, A to Z or Z to A" (`README.md` L343, frame 702).
enum SearchSortOrder {
  MOST_RELEVANT
  OLDEST
  NEWEST
  A_TO_Z
  Z_TO_A

  @@map("search_sort_order")
}

/// Whether a result set rendered as rows or as tiles.
///
/// "List or grid, offered on the files and canvases tabs" (`README.md` L343, frames
/// 689, 704).
enum SearchLayoutMode {
  LIST
  GRID

  @@map("search_layout_mode")
}

/// What kind of thing an uploaded or recorded attachment is.
///
/// Drawn from the forms the catalogue evidences: a document with a preview card, an
/// image, a video clip with a scrubber, an audio clip with a waveform, and a snippet
/// shared as a file (`README.md` L332, `03-messaging-and-composer.md` L649, frames
/// 208, 190, 200, 144).
enum FileKind {
  DOCUMENT
  IMAGE
  VIDEO_CLIP
  AUDIO_CLIP
  SNIPPET

  @@map("file_kind")
}

/// Where an upload is in its own lifecycle.
///
/// The pending tile in the composer and the in-progress bordered placeholder block
/// are both evidenced (`README.md` L332, frames 165, 321), and a terminal pair is
/// required for the mechanism to be usable at all. Uploads are pre-signed, so the
/// bytes never transit the API and this column is the API's only view of progress.
enum UploadState {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED

  @@map("upload_state")
}

/// How a structured list renders.
///
/// "Table or board, with filter, sort, hide-fields and group-by settings"
/// (`README.md` L335, frame 469).
enum ListLayout {
  TABLE
  BOARD

  @@map("list_layout")
}

/// A sort direction, evidenced with multiple sort levels on a list view
/// (`README.md` L335, frame 474).
enum SortDirection {
  ASCENDING
  DESCENDING

  @@map("sort_direction")
}

/// Which population a workflow is published to.
///
/// "Publication scope across your-workflows and all-published-workflows"
/// (`README.md` L337, frame 568).
enum WorkflowPublicationScope {
  AUTHOR_ONLY
  ALL_PUBLISHED

  @@map("workflow_publication_scope")
}

/// How a subscription tier is acquired.
///
/// "Self-service or sales-assisted" (`README.md` L341, frame 968). Catalogue scope:
/// this is a published property of a tier and carries nothing about any workspace.
enum PlanAcquisitionMode {
  SELF_SERVICE
  SALES_ASSISTED

  @@map("plan_acquisition_mode")
}

/// Which of the two billing periods a workspace is on.
///
/// "A two-valued selection" (`README.md` L325, frames 346, 616). The catalogue
/// evidences the count and the selection, so both members are carried and no third
/// is invented.
enum BillingPeriod {
  MONTHLY
  ANNUAL

  @@map("billing_period")
}

/// What kind of instrument a workspace has stored.
///
/// "Card or bank account" (`README.md` L325, frame 611). The instrument itself is
/// never in this database — see `WorkspaceStoredPaymentMethod`, which holds the
/// masked field set and one opaque record identifier.
enum PaymentMethodKind {
  CARD
  BANK_ACCOUNT

  @@map("payment_method_kind")
}

/// How a workspace settles what it owes.
///
/// "Payment settlement mode, immediate or invoiced" (`README.md` L325, frame 611).
enum SettlementMode {
  IMMEDIATE
  INVOICED

  @@map("settlement_mode")
}

/// Whether a marketing-consent row records a grant or a withdrawal.
///
/// Both are ACTS and both are ROWS. `S-MARKETING` requires that "a withdrawal is
/// recorded with the same fidelity as the grant"
/// (`00-product-overview.md` L584), so a withdrawal is a second row of the same
/// shape rather than a deletion or a flag flipped on the first. Erasing the grant
/// would erase the proof that the purpose was ever permitted.
enum MarketingConsentAct {
  GRANTED
  WITHDRAWN

  @@map("marketing_consent_act")
}

/// Whether an audited attempt was permitted or refused.
///
/// The audit log exists for both, and the refusal is the more interesting of the
/// two: a denial produced no row, changed no state and returned no content, so
/// without a record it leaves no trace at all and a pattern of probing is
/// invisible.
enum AuditOutcome {
  ALLOWED
  DENIED

  @@map("audit_outcome")
}

/// What kind of principal an audited attempt came from.
///
/// `ANONYMOUS` is the member that matters most and the reason the actor reference
/// on an audit row is nullable: a denial can come from a caller with no valid
/// session at all, and that is precisely the attempt worth recording.
enum AuditActorType {
  ACCOUNT
  ANONYMOUS
  APP
  WORKFLOW
  SYSTEM

  @@map("audit_actor_type")
}

/// Whether a stored idempotency outcome was executed now or replayed from a record.
///
/// The two members are the storage form of `IDEMPOTENCY_OUTCOMES` in
/// `packages/shared/src/schemas/idempotency.ts`, which reports the distinction in
/// the response body rather than leaving a client to infer it from a status code.
enum IdempotencyOutcome {
  EXECUTED
  REPLAYED

  @@map("idempotency_outcome")
}

/// The result of one diagnostic check.
///
/// "Drawn from the observed set of pass, in progress, pending and permission
/// denied, several of which coexist in one table" (`README.md` L342, frame 565).
/// The coexistence is why this is a per-check value and not a per-run one.
enum DiagnosticsStatus {
  PASSED
  IN_PROGRESS
  PENDING
  PERMISSION_DENIED

  @@map("diagnostics_status")
}

/// What a participant has behind their camera.
///
/// "None, blurred or an image" (`README.md` L333, frame 293). Per participant
/// rather than per session, which is why it lives on the viewer–huddle relation.
enum CameraBackgroundMode {
  NONE
  BLURRED
  IMAGE

  @@map("camera_background_mode")
}

/// How captions are displayed.
///
/// "A closed-caption or side-by-side display option" (`README.md` L333, frame 287).
enum CaptionsDisplay {
  CLOSED_CAPTION
  SIDE_BY_SIDE

  @@map("captions_display")
}

// =============================================================================
// THE TENANT ROOT AND ITS SIX FIELD GROUPS
// =============================================================================

/// ENTITY     `E-WORKSPACE` — the tenant.
/// TENANCY    TENANT-SCOPED (it IS the tenant; every other tenant row carries
///            `workspaceId` pointing here, and `packages/db/src/tenancy.ts`
///            filters this model on its own primary key).
/// RETENTION  `S-RETENTION` class: workspace-lifetime. Retained while the
///            workspace exists; deletion is a terminal, authorized, audited
///            operation that must reach every derived store — search indexes,
///            caches, materialised aggregates, previews and queued notification
///            payloads — and the deleted state is a rendered terminal card rather
///            than a disappearance (`21-states.md` L499, frame 583).
///
/// This record is the SOLE holder of tenant commercial state, and the separation is
/// a read-path boundary rather than a modelling preference. Its own identity and
/// configuration fields carry no tier: the about page renders the workspace's tier
/// as a label-and-value row, but "a rendering is not a placement" and the value it
/// prints is resolved from the commercial-position group (`README.md` L325,
/// frame 640). Six field groups hang off this record and are declared as their own
/// tables keyed by it, which the catalogue expressly permits — "a build may persist
/// any group as its own table keyed by the owning record; what the group fixes is
/// where the values belong" (`README.md` L321).
///
/// NO SECRET OF ANY CLASS IS A FIELD OF THIS RECORD or of any of its groups. The
/// invite-link configuration below is a set of settings, not a token: the tokens
/// themselves are `CapabilityLink` rows holding a selector and a keyed verifier.
model Workspace {
  id String @id @default(cuid()) @map("id")

  /// Rendered in the sidebar header with a caret and again as the switcher's first
  /// row (`00-product-overview.md` L820, frame 715).
  name String @map("name")

  /// The workspace-chosen subdomain, from which the fully-qualified sign-in domain
  /// is composed with a fixed suffix (`01-onboarding-and-auth.md` L781, frames 717,
  /// 719). Stored as the chosen part rather than the composed string, so the suffix
  /// lives in configuration and one deployment's domain is not baked into rows.
  subdomain String @unique @map("subdomain")

  /// The composed fully-qualified sign-in domain, rendered beneath the name in both
  /// the switcher and the workspace menu (`00-product-overview.md` L820, frames 566,
  /// 724). Stored because it is rendered on surfaces that do not otherwise know the
  /// suffix, and unique because it resolves a sign-in address to one workspace.
  signInDomain String @unique @map("sign_in_domain")

  /// The square icon used in the rail's head and on other workspaces' switcher rows;
  /// the current workspace's own row carries no icon tile
  /// (`00-product-overview.md` L820, frame 724). Nullable — a workspace created
  /// through the wizard has none until one is uploaded. Held as a reference to a
  /// `StoredFile` rather than as bytes.
  iconFileId String? @map("icon_file_id")

  /// An email domain whose holders may join without an invitation, offered as a
  /// pre-ticked checkbox that names the domain (`README.md` L325,
  /// `01-onboarding-and-auth.md` L781, frames 8, 653). Nullable: self-joining is
  /// off when no domain is set. A PRE-TICKED RENDERING IS NOT A STORED TRUE — the
  /// wizard's default tick is presentation, and this column records what the person
  /// actually committed.
  selfJoinEmailDomain String? @map("self_join_email_domain")

  /// Whether the workspace's joining policy currently admits self-joining at all,
  /// separately from whether a domain is configured (`README.md` L325, frame 575).
  selfJoinEnabled Boolean @default(false) @map("self_join_enabled")

  /// The workspace-level half of the INVITE-LINK CONFIGURATION the console renders
  /// beside that self-joining domain (`README.md` L325, frame 653).
  ///
  /// THE CONFIGURATION'S OWN FIELD SET IS NOT ENUMERATED ANYWHERE, so this is the
  /// smallest coherent reading consistent with the adjacent evidenced fields: a
  /// workspace-level switch governing whether a shareable link may be issued at all,
  /// alongside `invitationRestrictedToAdmins` below, which governs who may issue one.
  /// Everything else the console shows about a link — its expiry, its revocation, its
  /// redemption count — is per link and lives on `CapabilityLink`, so nothing is
  /// duplicated here. Registered with its options in `docs/decisions/gap-register.md`;
  /// `R3` forbids omitting a mechanism because a value or a field set is uncertain.
  inviteLinkEnabled Boolean @default(false) @map("invite_link_enabled")

  /// Workspace language and the display-name policy, both rendered on the
  /// settings surface (`README.md` L325, frame 575). The language is a tag rather
  /// than an enum because the catalogue never enumerates the set offered.
  language          String @map("language")
  displayNamePolicy String @map("display_name_policy")

  // DEFAULT CHANNELS FOR NEW MEMBERS (`README.md` L325, frame 575) is deliberately not a
  // column here, and this note is part of satisfying the gate rather than an aside. The
  // same fact is evidenced from the other side as the conversation's own
  // administrator-only auto-add toggle, "a workspace-scoped, administrator-only toggle
  // that adds anyone who joins the workspace to this channel"
  // (`02-channels.md` L803, frames 72, 73) — so the workspace's default-channel set IS
  // the set of conversations whose `autoAddOnJoin` is set. Holding it twice would be two
  // places for one fact, and the two would eventually disagree about which channels a
  // new member joins. The invite modal's helper text that references the set
  // (`01-onboarding-and-auth.md` L781, frame 44) reads it from there.

  /// Whether issuing invitations is restricted to owners and administrators
  /// (`01-onboarding-and-auth.md` L781, frame 52). A rendering of this as a disabled
  /// control is presentation only: `R1` requires the server to check it at the point
  /// of execution regardless, which `apps/api/src/authz/policy.ts` does.
  invitationRestrictedToAdmins Boolean @default(false) @map("invitation_restricted_to_admins")

  /// The terms-of-service reference the about page renders with a review link
  /// (`README.md` L325, frame 640). Nullable: not every workspace has one recorded.
  termsOfServiceReference String? @map("terms_of_service_reference")

  /// Absolute instants. `createdAt` is the date created the about page renders
  /// (`README.md` L325, frame 640). `deletedAt` is the terminal state whose card
  /// renders inside the public chrome (`21-states.md` L499, frame 583) — a soft
  /// terminal marker, so that a tenant's rows remain reachable for the authorized,
  /// audited deletion that must sweep them from every derived store.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  icon StoredFile? @relation("WorkspaceIcon", fields: [iconFileId], references: [id], onDelete: SetNull)

  // The six field groups, each keyed by this record.
  commercialPosition  WorkspaceCommercialPosition?
  billingAccount      WorkspaceBillingAccount?
  storedPaymentMethod WorkspaceStoredPaymentMethod[]
  billingContacts     WorkspaceBillingContact[]
  billingHistory      WorkspaceBillingHistoryEntry[]
  renewalEstimate     WorkspaceRenewalEstimate?

  // Tenant rows. Every one of these carries a non-nullable `workspaceId`, so the
  // isolation predicate binds without ever having to reach a parent row first.
  users                User[]
  userGroups           UserGroup[]
  userGroupMembers     UserGroupMember[]
  preferences          UserPreference[]
  conversations        Conversation[]
  conversationMembers  ConversationMembership[]
  conversationCounters ConversationCounter[]
  bookmarkFolders      ConversationBookmarkFolder[]
  bookmarks            ConversationBookmark[]
  sidebarSections      SidebarSection[]
  messages             Message[]
  reactions            Reaction[]
  customEmoji          CustomEmoji[]
  emojiPacks           EmojiPack[]
  threads              Thread[]
  files                StoredFile[]
  huddles              Huddle[]
  canvases             Canvas[]
  lists                ChannelList[]
  listRecords          ChannelListRecord[]
  workflows            Workflow[]
  appInstallations     AppInstallation[]
  notifications        Notification[]
  invitations          Invitation[]
  externalOrgs         ExternalOrganization[]
  searchQueries        SearchQuery[]
  searchHistory        SearchHistoryEntry[]
  capabilityLinks      CapabilityLink[]
  viewerMessageState   ViewerMessageState[]
  viewerThreadState    ViewerThreadState[]
  viewerCanvasState    ViewerCanvasState[]
  viewerListState      ViewerListState[]
  viewerAppState       ViewerAppState[]
  viewerFileState      ViewerFileState[]
  viewerHuddleState    ViewerHuddleState[]
  sessions             Session[]
  auditEntries         AuditLogEntry[]
  idempotencyKeys      IdempotencyKey[]
  groupDefaultChannels UserGroupDefaultConversation[]
  invitationScopes     InvitationConversationScope[]
  externalScopes       ExternalOrganizationConversationScope[]

  @@index([deletedAt])
  @@map("workspace")
}

/// ENTITY     Field group of `E-WORKSPACE` — commercial position. NOT a
///            twenty-first entity: the catalogue names it inside that entity's row
///            as "a tenant-scoped field group of this entity, and the single tenant
///            source for every commercial value in this product" (`README.md` L325).
/// TENANCY    TENANT-SCOPED. Read only under `S-AUTHZ-READ`, and kept apart from the
///            workspace's identity and configuration fields so a tier has exactly
///            one home.
/// RETENTION  `S-RETENTION` class: workspace-lifetime, commercial. Retained with the
///            workspace; the entitlement set is recomputed rather than aged.
///
/// THE COMMERCIAL EDGE RUNS IN ONE DIRECTION ONLY, AND THAT IS WHY `planTierId`
/// BELOW IS A PLAIN SCALAR WITH NO PRISMA RELATION.
///
/// The catalogue states that "no relationship runs from this entity to a workspace,
/// a channel or any other tenant object" of the publicly readable tier, "in this
/// model or in any area document's diagram" (`README.md` L341), and the reading rule
/// repeats it: the one edge between the two populations "runs from `E-WORKSPACE`'s
/// commercial position field group to the `E-PLAN` tier it references, and it runs in
/// that direction only" (`README.md` L411).
///
/// Prisma requires BOTH sides of a declared relation. Declaring one here would
/// therefore put a back-relation field on the tier model pointing at a tenant
/// object, and the tier is read in full by an unauthenticated visitor on the public
/// pricing page. Two options existed:
///
///   - CHOSEN — hold the tier as a plain scalar reference column with no Prisma
///     relation, so the tier model ends up with ZERO traversal paths into tenant
///     data and the rule is verifiable by inspection rather than by discipline.
///     Referential integrity for this one column is the policy layer's job, in
///     `apps/api/src/services/workspace.ts`, which resolves the tier before writing
///     it. Where two approaches are equally viable the build takes the one that
///     keeps the security contracts easiest to verify, and a column a reviewer can
///     see has no relation is easier to verify than a relation a reviewer must
///     believe nobody traverses.
///   - REJECTED — a declared relation with a back-relation field on the tier,
///     defended by a convention never to traverse it. Rejected because the
///     convention is exactly what `R1` refuses to rely on: the traversal would be
///     available to every caller of the generated client, including the read that
///     serves a signed-out pricing page, and "nobody traverses it" is a review
///     outcome rather than a structural property.
///
/// The judgement is registered in `docs/decisions/gap-register.md` with its options
/// and rationale. The same one-directional rule holds a second time for third-party
/// software: a workspace's tier for an app lives in `AppInstallation` and never among
/// the app's publicly readable catalogue fields.
///
/// NO PROMOTIONAL CODE VALUE APPEARS HERE OR ANYWHERE IN THIS SCHEMA. Only the
/// RESULT of a redemption does — which promotion was applied, when, and to which
/// tier. A promotional code is an `S-SECRET` class-A artefact, held as a keyed
/// verifier on a separately secured redemption record whose table arrives with the
/// commercial phase (`README.md` L325, L341).
model WorkspaceCommercialPosition {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @unique @map("workspace_id")

  /// A REFERENCE to a published tier and never a copy of it, first populated by the
  /// setup wizard's terminal step rather than defaulted, and thereafter the tier
  /// currently billed (`README.md` L325, `01-onboarding-and-auth.md` L790, frames
  /// 17, 346, 600). No Prisma relation is declared — see this model's doc-comment.
  /// Nullable only for the window between workspace creation and the wizard's
  /// terminal step; `apps/api/src/services/workspace.ts` closes it.
  planTierId String? @map("plan_tier_id")

  billingPeriod BillingPeriod? @map("billing_period")

  /// Trial state: an active flag, the length as offered, and an ABSOLUTE END DATE
  /// (`README.md` L325, frames 550, 566, 610).
  ///
  /// THE LENGTH IS TWO INSTANTS, NOT A DURATION COLUMN. The catalogue lists a length
  /// beside the end date, and the obvious column for it would be a number of days —
  /// which would be a SECOND duration in a schema whose whole discipline is that a
  /// deadline is the moment it resolves to. Storing the start instant instead gives the
  /// length as `trialEndsAt - trialStartedAt` and costs nothing: both facts are
  /// recoverable, neither can drift from the other, and a trial granted last month keeps
  /// the length it was granted with even after the configured default changes.
  ///
  /// The "remaining duration in whole days" the surfaces render is likewise COMPUTED
  /// FROM `trialEndsAt` and is deliberately not a column — a stored remainder is a second
  /// copy of a fact a clock makes wrong, and the gate requires the countdown to be
  /// computed with correct singular and plural forms and no observed value appearing as a
  /// literal (`00-product-overview.md` L909).
  trialActive    Boolean   @default(false) @map("trial_active")
  trialStartedAt DateTime? @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt    DateTime? @map("trial_ends_at") @db.Timestamptz(3)

  /// Billable member count and the renewal date (`README.md` L325, frames 611, 616).
  billableMemberCount Int?      @default(0) @map("billable_member_count")
  renewsAt            DateTime? @map("renews_at") @db.Timestamptz(3)

  /// The RESOLVED entitlement set — what makes a gate badge render beside one menu
  /// row and not its siblings (`README.md` L325, frames 500, 550, 700). Held as a
  /// structured value because the capability keys are the published tier's
  /// vocabulary rather than this record's, and resolution is a per-workspace answer
  /// over that vocabulary. The published capability map itself stays on the tier:
  /// "the capability map is a published definition, never a resolved answer"
  /// (`README.md` L341).
  resolvedEntitlements Json? @map("resolved_entitlements")

  /// The result of applying a promotion — which promotion, when, and to which tier —
  /// with its own end instant, distinct from the trial's (`README.md` L325, frames
  /// 203, 560, 669, 677). The code that was redeemed is not here; see the model
  /// doc-comment.
  appliedPromotionalOfferId String?   @map("applied_promotional_offer_id")
  appliedPromotionAt        DateTime? @map("applied_promotion_at") @db.Timestamptz(3)
  appliedPromotionEndsAt    DateTime? @map("applied_promotion_ends_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([trialEndsAt])
  @@map("workspace_commercial_position")
}

/// ENTITY     Field group of `E-WORKSPACE` — billing account (`README.md` L325).
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: financial record, workspace-lifetime plus the
///            statutory window a deployment states. Governed by `S-PII`, not by
///            `S-SECRET`: a billing address must stay QUERYABLE, so no field here is
///            a verifier and none is in a sealed store. `S-PII` redaction applies —
///            no value below ever reaches a log, an error report, an analytics
///            event, a URL or a cache key, and where one must be referenced
///            elsewhere it is referenced by this row's opaque identifier.
model WorkspaceBillingAccount {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @unique @map("workspace_id")

  /// The billing address, stated to appear on every invoice (`README.md` L325,
  /// frames 611, 612, 613, 671). The second address line is optional; the postal
  /// code accepts an extended form, so it is a string rather than a constrained
  /// pattern.
  organisationName String  @map("organisation_name")
  countryOrRegion  String  @map("country_or_region")
  addressLine1     String  @map("address_line_1")
  addressLine2     String? @map("address_line_2")
  city             String  @map("city")
  state            String? @map("state")
  postalCode       String  @map("postal_code")

  /// A three-letter code with no control of its own — it is derived from the
  /// address rather than chosen (`README.md` L325, frame 611).
  currency String @map("currency")

  settlementMode SettlementMode @map("settlement_mode")

  /// Billing-notification frequency and the purchase-authorization policy governing
  /// which accounts may purchase (`README.md` L325, frames 671, 672). Both are
  /// strings because the catalogue evidences the fields and never enumerates their
  /// value sets; inventing members would author behaviour the specification does not
  /// carry. The policy is presentation only until the server checks it: `R1` puts
  /// the decision in `apps/api/src/authz/policy.ts`.
  billingNotificationFrequency String? @map("billing_notification_frequency")
  purchaseAuthorizationPolicy  String? @map("purchase_authorization_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_billing_account")
}

/// ENTITY     Field group of `E-WORKSPACE` — stored payment method (`README.md` L325).
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: financial reference, retained while the instrument
///            is stored. Removal DESTROYS the provider credential rather than
///            flagging it, per `S-PAYMENT`.
///
/// THIS GROUP HOLDS THE MASKED FIELD SET AND ONE POINTER, AND NOTHING ELSE.
/// `S-PAYMENT` is explicit that the instrument's number and security code must never
/// reach this product at all — collection is provider-hosted — and that the product
/// persists "only the field set the corpus shows retained: instrument kind, masked
/// identifier, network, expiry and a default flag"
/// (`00-product-overview.md` L602, frames 678, 679).
///
/// `providerCredentialRef` is an `S-SECRET` class-C OPAQUE RECORD IDENTIFIER, not a
/// token. The provider token is reusable by design, so it is the single class-C
/// secret in the commercial model: envelope-encrypted in a key-managed store, bound
/// to one workspace, decrypted only inside the provider-integration component and
/// only for the duration of a charge. This group is safe for a read path to return
/// PRECISELY BECAUSE it holds the pointer rather than the secret — which is what
/// keeps `S-SECRET`'s "no token is a field of a returned entity" rule true without
/// exception here (`README.md` L527).
model WorkspaceStoredPaymentMethod {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  kind             PaymentMethodKind @map("kind")
  maskedIdentifier String            @map("masked_identifier")
  network          String?           @map("network")

  /// The instrument's own printed expiry, as rendered (`README.md` L325, frames 674,
  /// 679). An absolute instant, resolved from the month and year the provider
  /// reports, so this column answers the same kind of question as every other
  /// deadline in this file.
  instrumentExpiresAt DateTime? @map("instrument_expires_at") @db.Timestamptz(3)

  isDefault Boolean @default(false) @map("is_default")

  /// The one pointer. Never the token. Never rendered. Unique, so two rows cannot
  /// name one stored credential and a destroyed credential cannot be silently
  /// reachable through a second row.
  providerCredentialRef String @unique @map("provider_credential_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_stored_payment_method")
}

/// ENTITY     Field group of `E-WORKSPACE` — billing contacts (`README.md` L325).
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: personal contact data, workspace-lifetime.
///            Every field is personal contact data under `S-PII`, and the person is
///            held as a REFERENCE to an account rather than as a second copy of
///            them — a second copy is a second thing to redact, and it would survive
///            the deletion that should have removed it.
model WorkspaceBillingContact {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  /// The contact's billing role and their correspondence-delivery preference;
  /// additional contacts are copied on all billing correspondence
  /// (`README.md` L325, frame 672). Strings because the catalogue evidences the
  /// fields and not their value sets.
  contactRole              String  @map("contact_role")
  correspondencePreference String? @map("correspondence_preference")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_billing_contact")
}

/// ENTITY     Field group of `E-WORKSPACE` — billing history entries (`README.md` L325).
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: financial record, APPEND-ONLY, retained for the
///            statutory window a deployment states. Append-only means append-only:
///            there is no update timestamp on this model, and a correction is a new
///            entry rather than a rewritten one.
///
/// Three of the five value columns are nullable because the catalogue evidences an
/// entry that has neither a charge nor a status: "a trial start being itself an
/// entry with neither charge nor status" (`README.md` L325, frame 670). A not-null
/// column with a zero sentinel would render a trial start as a charge of nothing.
model WorkspaceBillingHistoryEntry {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  occurredOn         DateTime @map("occurred_on") @db.Timestamptz(3)
  itemLabel          String   @map("item_label")
  statementReference String?  @map("statement_reference")

  /// Held as a decimal rather than a float, because money compared or summed as a
  /// binary float is money reported wrongly. Nullable per the trial-start case.
  chargeAmount   Decimal? @map("charge_amount") @db.Decimal(19, 4)
  chargeCurrency String?  @map("charge_currency")
  status         String?  @map("status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredOn])
  @@map("workspace_billing_history_entry")
}

/// ENTITY     Field group of `E-WORKSPACE` — renewal estimate (`README.md` L325).
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: TRANSIENT. The catalogue marks this group
///            "tenant scope, transient", and the estimate's own qualifying statement
///            says the figure will follow the member count on the renewal date
///            (`README.md` L325, frames 611, 615, 616). The row is therefore a cache
///            of a computation, replaced rather than accumulated, and one row per
///            workspace is the whole table.
///
/// HOW THE TAX FIGURE IS DERIVED IS UNCAPTURED and is governed by `S-GAP`
/// (`README.md` L325). The column exists because the surface renders a tax line and
/// `R3` forbids omitting a mechanism because a value is uncertain; the derivation
/// lives in `apps/api/src/services/workspace.ts` with its judgement registered in
/// `docs/decisions/gap-register.md`.
model WorkspaceRenewalEstimate {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @unique @map("workspace_id")

  unitPrice     Decimal       @map("unit_price") @db.Decimal(19, 4)
  memberCount   Int           @map("member_count")
  periodFactor  Int           @map("period_factor")
  lineTotal     Decimal       @map("line_total") @db.Decimal(19, 4)
  taxAmount     Decimal?      @map("tax_amount") @db.Decimal(19, 4)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(19, 4)
  currency      String        @map("currency")
  billingPeriod BillingPeriod @map("billing_period")

  /// The due-on date the estimate names (`README.md` L325, frame 611).
  dueOn DateTime @map("due_on") @db.Timestamptz(3)

  /// When this estimate was computed. A transient row needs to say how old it is, or
  /// a surface cannot tell a current figure from a stale one.
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_renewal_estimate")
}

// =============================================================================
// PEOPLE
// =============================================================================

/// ENTITY     `E-USER` — an account, carrying identity, profile and status.
/// TENANCY    TENANT-SCOPED. `workspaceId` is NOT NULLABLE.
/// RETENTION  `S-RETENTION` class: personal data, account-lifetime. Every personal
///            field below is governed by `S-PII` and NOT by `S-SECRET`: a directory
///            has to be searched, listed and projected, so these fields must stay
///            QUERYABLE and none of them is a verifier or sits in a sealed store
///            (`00-product-overview.md` L556). Three `S-PII` obligations bind them.
///            MINIMISATION — every column here serves a surface the catalogue
///            evidences. REDACTION — a personal value never reaches an application
///            log, an error report, an analytics event, a URL or a cache key, and
///            where one must be referenced outside the product it is referenced by
///            this row's opaque identifier. RETENTION AND DELETION — the stated
///            period is the account's lifetime plus the deployment's stated backup
///            window, and the deletion path must remove these values from primary
///            storage, from search indexes, from caches and from support histories,
///            as an authorized, audited operation like any other.
///
/// AN ACCOUNT IS SCOPED TO ONE WORKSPACE, and that is what makes the tenant key
/// non-nullable here. The catalogue's diagram is unambiguous — `E-WORKSPACE ||--o{
/// E-USER : "has members"` (`README.md` L419) — and the corpus corroborates it from
/// the other side: the already-signed-in list renders "an active browser session per
/// workspace" (`01-onboarding-and-auth.md` L779, frames 717, 719). The account's own
/// observation that a person belongs to several workspaces, "surfaced as one row per
/// workspace for the signed-in address" (`01-onboarding-and-auth.md` L779, frame
/// 731), is therefore several rows here sharing one email address, which the
/// switcher renders one row per. Both facts hold at once, and the isolation
/// predicate binds without a nullable tenant key.
///
/// NO CREDENTIAL MATERIAL IS A FIELD OF THIS RECORD. The catalogue names four
/// artefacts on this entity — a password with a reuse constraint and a strength
/// rating, a six-character expiring one-time code, an active browser session, and a
/// device-enrolment code — "only so that a build reading the consolidated model
/// cannot mistake their absence for an oversight", and per `S-SECRET` none is stored
/// as a field of this entity or of any entity a read path returns (`README.md` L326,
/// `01-onboarding-and-auth.md` L779). They are `PasswordVerifier`, `OneTimeCode`,
/// `Session` and `DeviceEnrolmentCode`, four tables with four lifecycles.
///
/// THERE IS NO PASSWORD-STRENGTH COLUMN ANYWHERE IN THIS SCHEMA, and this is the
/// record a reader would look on first. The rating "is computed transiently in the
/// client and neither transmitted nor stored"
/// (`01-onboarding-and-auth.md` L779, `00-product-overview.md` L542, frame 741). Its
/// absence is a contract, not an omission.
///
/// NO MARKETING OR NEWSLETTER FIELD BELONGS HERE EITHER. A marketing address, its
/// consent and its subscribed state are collected on public surfaces that create no
/// account, so they live on the `PublicFormSubmission` page-content structure and its
/// consent rows: "a lead and a workspace member are different populations and are
/// never merged into one record" (`README.md` L326, L351).
///
/// PRESENCE IS NOT A COLUMN. The dot beside an avatar is derived from a heartbeat
/// with a time-to-live and a coalesced fan-out, so it expires by itself when a client
/// stops reporting. What IS stored is what a person deliberately set: the manual away
/// flag, the status text and emoji, and the clear-after instant.
model User {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The account's identifier, entered at sign-up and echoed by every later surface
  /// (`01-onboarding-and-auth.md` L779, frames 1, 6). Unique WITHIN a workspace
  /// rather than globally, because one address legitimately holds an account in
  /// several workspaces.
  email String @map("email")

  /// The verified-address flag, surfaced as a confirmed-as line with its own change
  /// link (`01-onboarding-and-auth.md` L779, frame 6). Verification is proved by a
  /// consumed `OneTimeCode` row; this column is the settled outcome.
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  /// Telephone number (`README.md` L326, frame 519). Optional, and `S-PII` personal
  /// contact data like the address above it.
  phoneNumber String? @map("phone_number")

  /// Full name, collected as one field on the wizard's second step and again as a
  /// display name on the join page (`01-onboarding-and-auth.md` L779, frames 12, 722).
  /// `displayName` and `userName` are three distinct facts with the last two
  /// evidenced together on one typeahead row
  /// (`03-messaging-and-composer.md` L653, frame 172).
  fullName    String  @map("full_name")
  displayName String? @map("display_name")
  userName    String? @map("user_name")

  pronouns          String? @map("pronouns")
  namePronunciation String? @map("name_pronunciation")
  jobTitle          String? @map("job_title")

  /// A named IANA zone, not an offset. An offset answers "how far from universal
  /// time was it then"; a zone answers "what will this person's clock read", which is
  /// the question a scheduled send and a local-time readout both actually ask
  /// (`README.md` L326, frame 520).
  timeZone String? @map("time_zone")

  /// Workspace-facing language preference (`README.md` L326, frame 604).
  language String? @map("language")

  /// The profile photo, explicitly optional, stored from a square crop and rendered
  /// as the message-row avatar (`01-onboarding-and-auth.md` L779, frames 11, 21, 22),
  /// and the recorded name clip (`README.md` L326, frame 520). Both are references to
  /// stored files rather than bytes on this row.
  profilePhotoFileId      String? @map("profile_photo_file_id")
  namePronunciationFileId String? @map("name_pronunciation_file_id")

  /// Deliberately set status, all three parts of it, plus the clear-after time as an
  /// ABSOLUTE INSTANT rather than the duration the menu offers
  /// (`README.md` L326, frame 504).
  statusText      String?   @map("status_text")
  statusEmojiName String?   @map("status_emoji_name")
  statusClearsAt  DateTime? @map("status_clears_at") @db.Timestamptz(3)

  /// The manual away flag and the notification-pause state — both deliberate acts,
  /// unlike derived presence (`README.md` L326, frame 504). The pause carries its own
  /// absolute end instant for the same reason every other deadline here does.
  manuallyAway             Boolean   @default(false) @map("manually_away")
  notificationsPaused      Boolean   @default(false) @map("notifications_paused")
  notificationsPausedUntil DateTime? @map("notifications_paused_until") @db.Timestamptz(3)

  /// The about-me start date, entered through a date picker (`README.md` L326,
  /// frame 526).
  aboutMeStartDate DateTime? @map("about_me_start_date") @db.Timestamptz(3)

  accountType AccountType @map("account_type")

  /// The assignable role that grants a member additional permissions beyond their
  /// account type; the workspace's roles carry their own member count
  /// (`README.md` L326, frame 666). A name rather than a reference, because the
  /// catalogue evidences the role's existence and its member count and never a role
  /// definition record. `apps/api/src/authz/matrix.ts` resolves it.
  assignedRoleName String? @map("assigned_role_name")

  /// Whether this account may be a member of more than one conversation as a guest.
  /// Its stated consequence is COMMERCIAL rather than functional — a guest permitted
  /// to join more than one channel is billed as a full member — which is why the
  /// classification beside it is stored rather than derived from the account type
  /// (`README.md` L326, L339, frame 50).
  multiChannelGuest     Boolean               @default(false) @map("multi_channel_guest")
  billingClassification BillingClassification @map("billing_classification")

  /// The guest account end date, the third of the catalogue's three separate clocks
  /// (`README.md` L407, frame 54). A property of an ACCOUNT, not of a link and not of
  /// a relationship, and "an absolute date from the moment it is set" — the invitation
  /// form's date picker commits a calendar day whose stated semantics are the last
  /// minute of it, and the instant stored here is that moment resolved in the
  /// workspace's zone at the time of setting. No duration is stored and no number is
  /// written in this file.
  guestAccessEndsAt DateTime? @map("guest_access_ends_at") @db.Timestamptz(3)

  /// Two-factor state (`README.md` L326, frame 604). The enrolment artefact itself is
  /// a `DeviceEnrolmentCode` row and never a field here.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  /// The deactivated terminal state, after which the product renders only a card
  /// stating what happened and offering one outbound link (`README.md` L326,
  /// `21-states.md` L498, frames 609, 583). An absolute instant rather than a flag, so
  /// the record says WHEN as well as WHETHER, and every session for the account is
  /// invalidated in the same write.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // An authenticated-session requirement is surfaced as a page-level advisory when a
  // route needs one (`README.md` L326, frame 735). It is a property of the ROUTE and
  // is deliberately not a column here: a rendering is not a placement.

  workspace             Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profilePhoto          StoredFile? @relation("UserProfilePhoto", fields: [profilePhotoFileId], references: [id], onDelete: SetNull)
  namePronunciationClip StoredFile? @relation("UserNameClip", fields: [namePronunciationFileId], references: [id], onDelete: SetNull)

  preference            UserPreference?
  passwordVerifier      PasswordVerifier?
  oneTimeCodes          OneTimeCode[]
  deviceEnrolmentCodes  DeviceEnrolmentCode[]
  sessions              Session[]
  groupMemberships      UserGroupMember[]
  billingContactFor     WorkspaceBillingContact[]
  conversationsCreated  Conversation[]            @relation("ConversationCreator")
  memberships           ConversationMembership[]
  authoredMessages      Message[]                 @relation("MessageAuthor")
  pinnedMessages        Message[]                 @relation("MessagePinnedBy")
  reactions             Reaction[]
  customEmojiCreated    CustomEmoji[]
  emojiPacksAdded       EmojiPack[]
  filesShared           StoredFile[]              @relation("FileSharer")
  canvasesCreated       Canvas[]                  @relation("CanvasCreator")
  listRecordsAssigned   ChannelListRecord[]       @relation("ListRecordAssignee")
  invitationsIssued     Invitation[]              @relation("InvitationIssuer")
  invitationsAccepted   Invitation[]              @relation("InvitationAcceptedBy")
  capabilityLinksIssued CapabilityLink[]          @relation("CapabilityLinkIssuer")
  notifications         Notification[]
  searchQueries         SearchQuery[]
  searchHistory         SearchHistoryEntry[]
  bookmarksCreated      ConversationBookmark[]    @relation("BookmarkCreator")
  sidebarSections       SidebarSection[]
  viewerMessageState    ViewerMessageState[]
  viewerThreadState     ViewerThreadState[]
  viewerCanvasState     ViewerCanvasState[]
  viewerListState       ViewerListState[]
  viewerAppState        ViewerAppState[]
  viewerFileState       ViewerFileState[]
  viewerHuddleState     ViewerHuddleState[]
  auditEntries          AuditLogEntry[]
  idempotencyKeys       IdempotencyKey[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, accountType])
  @@index([workspaceId, deactivatedAt])
  @@index([guestAccessEndsAt])
  @@map("app_user")
}

/// ENTITY     `E-PREFERENCE` — a viewer's own settings record.
/// TENANCY    VIEWER-OWNED, and tenant-keyed as well: the settings are "properties of
///            the user within a workspace rather than of the device", because they are
///            surfaced inside that workspace's own preferences dialog rather than in
///            any browser-level surface (`00-product-overview.md` L826, frame 544).
/// RETENTION  `S-RETENTION` class: per-viewer configuration, account-lifetime.
///            Removed with the account it belongs to.
///
/// THIS IS THE TENTH PER-VIEWER PLACEMENT, and it is a placement onto an EXISTING
/// entity rather than a new join table. The relation table's last row puts "dismissed
/// banners and explanatory blocks" here — "held as fields of the viewer's own
/// `E-PREFERENCE` record rather than of the object dismissed" (`README.md` L372).
///
/// A DISMISSAL IS THE CLEAREST CASE THE PLACEMENT TEST HAS. Two people opening the
/// same surface may legitimately see different things, because one has already read
/// the banner and the other has not. Written on the banner, one person's dismissal
/// hides it from everybody who has not seen it yet — the exact failure `S-PERUSER`
/// exists to prevent, at the cost of a message nobody else ever received.
///
/// The five per-viewer groups the shell renders on the account row belong here for
/// the same reason and are declared below: rail destination visibility, sidebar
/// sections, the activity-filter and external-people scopes, colour mode and message
/// density (`00-product-overview.md` L821).
model UserPreference {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @unique @map("user_id")

  /// Dismissed banners and dismissed explanatory blocks, each held as a set of
  /// authored keys. Keys rather than object references, because a dismissal is a
  /// statement about a MESSAGE this product authored and not about a row another
  /// person can read.
  dismissedBanners           String[] @map("dismissed_banners")
  dismissedExplanatoryBlocks String[] @map("dismissed_explanatory_blocks")

  /// Colour mode and message density, both shell-wide and both per viewer
  /// (`00-product-overview.md` L821, frames 549, 560, 536).
  colorMode      ColorMode      @default(SYSTEM) @map("color_mode")
  messageDensity MessageDensity @default(COMFORTABLE) @map("message_density")

  /// The theme chosen from the first-run twelve-swatch grid
  /// (`01-onboarding-and-auth.md` L779, frame 26).
  ///
  /// STORED AS AN AUTHORED TOKEN IDENTIFIER, NEVER AS A COLOUR VALUE. There is no
  /// colour literal in this file and there must never be one: colour lives in exactly
  /// one file in this repository, `packages/ui/src/styles/tokens.ts`, whose palette is
  /// sourced from the build prompt and never sampled from a frame per `R4`. This
  /// column names one of those tokens.
  themeTokenId String? @map("theme_token_id")

  /// Rail destination visibility, held as a set of togglable destinations and
  /// clearable to none, with two of the twelve destinations non-clearable
  /// (`00-product-overview.md` L821, frames 544, 536). The non-clearable pair is
  /// enforced by `apps/api/src/services/preference.ts` rather than by a constraint,
  /// because which two they are is product vocabulary rather than a data property.
  hiddenRailDestinations String[] @map("hidden_rail_destinations")

  /// The activity-filter scope and the external-people scope, both per viewer
  /// (`00-product-overview.md` L821, frame 340).
  activityFilterScope String? @map("activity_filter_scope")
  externalPeopleScope String? @map("external_people_scope")

  /// Notification preferences: the notify-me-about scope, a mobile override, the
  /// huddle-start and thread-reply toggles, a keyword list and a delivery schedule
  /// (`README.md` L342, frame 535). The schedule is structured because it is a set of
  /// windows rather than one value.
  notifyAboutScope       NotificationScope? @map("notify_about_scope")
  mobileNotifyAboutScope NotificationScope? @map("mobile_notify_about_scope")
  notifyOnHuddleStart    Boolean            @default(false) @map("notify_on_huddle_start")
  notifyOnThreadReply    Boolean            @default(false) @map("notify_on_thread_reply")
  notificationKeywords   String[]           @map("notification_keywords")
  notificationSchedule   Json?              @map("notification_schedule")

  /// Home category: the activity-dot toggle, always-show settings, and the show and
  /// sort radio groups (`README.md` L342, frame 546).
  showActivityDot Boolean  @default(true) @map("show_activity_dot")
  homeAlwaysShow  String[] @map("home_always_show")
  homeShowScope   String?  @map("home_show_scope")
  homeSortOrder   String?  @map("home_sort_order")

  /// Audio-and-video category: the selected devices, automatic gain control, noise
  /// suppression, the when-joining-a-huddle group's large-channel warning threshold
  /// and background blur, and the when-alone group's timing select
  /// (`README.md` L342, frame 561).
  ///
  /// `largeConversationWarningThreshold` IS A PERSON'S OWN CHOSEN VALUE rather than a
  /// configured policy, which is why it sits on a record at all and why it carries NO
  /// SCHEMA DEFAULT: the value a surface arrives on is a configured default in
  /// `packages/shared/src/config/env.ts`, and a default here would be exactly the
  /// hardcoded policy literal `R3` forbids. It is a member count rather than a duration,
  /// so no instant expresses it and this file's no-duration rule does not reach it.
  microphoneDeviceId                String? @map("microphone_device_id")
  speakerDeviceId                   String? @map("speaker_device_id")
  automaticGainControl              Boolean @default(true) @map("automatic_gain_control")
  noiseSuppression                  Boolean @default(true) @map("noise_suppression")
  largeConversationWarningThreshold Int?    @map("large_conversation_warning_threshold")
  huddleBackgroundBlur              Boolean @default(false) @map("huddle_background_blur")
  whenAloneTiming                   String? @map("when_alone_timing")

  /// The per-person default skin tone the emoji picker offers
  /// (`README.md` L331, frame 214).
  ///
  /// THE DEFAULT LIVES HERE; THE APPLIED TONE LIVES ON THE REACTION. Both are real
  /// and neither replaces the other: the catalogue lists the default among
  /// `E-REACTION`'s fields because the picker renders it there, and `S-PERUSER`
  /// settles that a per-person choice is stored on the viewer's own record. The tone
  /// a particular reaction was sent with is part of that reaction's identity and is
  /// stored on `Reaction`. Range and validation are owned by
  /// `packages/shared/src/schemas/content.ts`.
  defaultEmojiSkinTone Int? @map("default_emoji_skin_tone")

  /// The diagnostics result set: one status per check, with an optional detail line,
  /// several statuses coexisting in one table (`README.md` L342, `21-states.md` L491,
  /// frames 564, 565). Structured rather than a table of its own, because a run is
  /// replaced wholesale rather than accumulated, and per `S-CONSENT` the samples that
  /// produced it are transient and are never persisted.
  diagnosticsResults Json? @map("diagnostics_results")

  /// Whether a device permission the product depends on was observed denied
  /// (`21-states.md` L491, frames 300, 565). Per viewer AND per client, so the value
  /// here is the last reported state rather than an authority.
  devicePermissionStatus DiagnosticsStatus? @map("device_permission_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("user_preference")
}

/// ENTITY     Part of `E-PREFERENCE` — a viewer-created sidebar section. NOT a
///            twenty-first entity: the shell lists "sidebar sections, each with an
///            emoji and a name" among the account's per-viewer groups and states that
///            the five such groups "belong to `E-PREFERENCE`, keyed by user and
///            workspace" (`00-product-overview.md` L821, frame 117).
/// TENANCY    VIEWER-OWNED, tenant-keyed.
/// RETENTION  `S-RETENTION` class: per-viewer configuration, account-lifetime.
///
/// A row of its own rather than a value inside the preference record, because a
/// conversation membership has to REFERENCE the section it is filed under, and a
/// reference needs something to point at. That is the whole reason this table exists.
model SidebarSection {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  name      String  @map("name")
  emojiName String? @map("emoji_name")

  /// Where this section sits among the viewer's own sections. An explicit ordinal,
  /// because the sidebar renders sections in an order the viewer controls and an
  /// implicit creation order cannot be reordered.
  position Int @default(0) @map("position")

  /// Whether the viewer has this section collapsed. Per viewer by construction — the
  /// section already is.
  collapsed Boolean @default(false) @map("collapsed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships ConversationMembership[]

  @@unique([userId, name])
  @@index([workspaceId])
  @@index([userId, position])
  @@map("sidebar_section")
}

/// ENTITY     `E-USER-GROUP` — a named, handled group of accounts.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace configuration, workspace-lifetime.
///
/// Phase-1 scope: the table exists so the closed set is complete and so a mention can
/// resolve, and its surfaces arrive with the administration phase.
///
/// THE HANDLE'S UNIQUENESS SPANS THREE POPULATIONS. The rejection that states it is
/// evidence: a handle must be unique across group names, conversation names AND
/// usernames (`21-states.md` L497, frame 647). A single-column unique index here
/// cannot express that, so the cross-population check is enforced by
/// `apps/api/src/services/workspace.ts` at the point of execution, and the constraint
/// below closes the part of it a constraint can hold. The gap is registered in
/// `docs/decisions/gap-register.md` rather than left as a comment nobody tests.
model UserGroup {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  name String @map("name")

  /// Constrained to lower case without spaces, like a conversation name
  /// (`README.md` L345, frame 646). The grammar itself is
  /// `CHANNEL_NAME_PATTERN` in `packages/shared/src/config/constants.ts`; this column
  /// stores what that grammar admitted.
  handle String @map("handle")

  purpose String? @map("purpose")

  /// Default conversations whose members are added automatically when someone joins
  /// this group (`README.md` L345, frame 646). A set of references, held as the join
  /// rows below rather than as an array, so a deleted conversation cannot leave a
  /// dangling identifier behind.
  /// The role association and the count of members needing additional permissions
  /// (`README.md` L345, frame 666). The count is DERIVED from the member rows and is
  /// deliberately not a column.
  associatedRoleName String? @map("associated_role_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace       Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members         UserGroupMember[]
  defaultChannels UserGroupDefaultConversation[]

  @@unique([workspaceId, handle])
  @@index([workspaceId])
  @@map("user_group")
}

/// ENTITY     Relation table implementing the catalogue diagram's
///            `E-USER }o--o{ E-USER-GROUP : "belongs to"` edge (`README.md` L435).
///            A many-to-many join is not an entity and carries no `E-*` identifier.
/// TENANCY    TENANT-SCOPED. The tenant key is carried HERE as well as on both ends,
///            so isolation never depends on reaching a parent row first.
/// RETENTION  `S-RETENTION` class: workspace configuration, workspace-lifetime.
model UserGroupMember {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  groupId     String @map("group_id")
  userId      String @map("user_id")

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("user_group_member")
}

/// ENTITY     Relation table carrying `E-USER-GROUP`'s optional default conversations
///            (`README.md` L345, frame 646). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace configuration, workspace-lifetime.
model UserGroupDefaultConversation {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  groupId        String @map("group_id")
  conversationId String @map("conversation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group        UserGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([groupId, conversationId])
  @@index([workspaceId])
  @@map("user_group_default_conversation")
}

// =============================================================================
// CONVERSATIONS
// =============================================================================

/// ENTITY     `E-CHANNEL` — a conversation.
/// TENANCY    TENANT-SCOPED. `workspaceId` is NOT NULLABLE.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime. Archiving is
///            REVERSIBLE and deletion is TERMINAL; both are absolute instants below.
///            A deletion must reach every derived store — search index, cache,
///            materialised counts, previews, quoted excerpts and queued notification
///            payloads — and per `S-RETENTION` "loss of access propagates": when a
///            member leaves or a collaboration ends, the retained projections of this
///            conversation are removed or redacted on their next render rather than
///            persisting because they were authorized when they were written
///            (`00-product-overview.md` L594).
///
/// NAMED `Conversation` RATHER THAN `Channel`, and the reason is the field below.
/// `conversationType` makes a direct message a VARIANT of this record rather than a
/// second entity, because the corpus gives a direct message no observable of its own
/// beyond that (`README.md` L327, frames 110, 552). Every constraint that depends on
/// this record therefore reads `conversationId`, and the threads and direct-message
/// phases add tables rather than rewriting rows.
///
/// THIS MODEL IS THE AUTHORIZATION PREDICATE'S OTHER HALF. `ConversationMembership`
/// below is the queryable join that makes a private conversation's ABSENCE provable
/// across all eight projections `R1` enumerates — counts, search results, link
/// previews, link resolution, member lists, facepiles, autocomplete suggestions and
/// notifications. The same rows that decide who may read decide who is listed, which
/// is why there is no member array on this record: an array cannot be filtered per
/// viewer, so listing it would authorize nothing.
///
/// SIX PER-MEMBER FACTS ARE DELIBERATELY ABSENT FROM THIS RECORD and live on the
/// membership relation: notification preference, the per-device override, the
/// thread-reply flag, the starred flag, the joined marker and sidebar placement
/// (`02-channels.md` L807). Storing them here would mean one person muting a
/// conversation mutes it for everyone and one person starring it moves it in
/// everyone's sidebar — and it would make one member's notification choice readable
/// by every other member, which is a disclosure of that person's behaviour.
///
/// ONE MEMBER-FACING SETTING DOES NOT MOVE, and recording the exception is part of
/// applying the rule: `autoAddOnJoin` below stays here, because its own legend names
/// it as administered rather than personal and its value is the same for every viewer
/// by design (`02-channels.md` L807, frame 72).
model Conversation {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  conversationType ConversationType       @map("conversation_type")
  visibility       ConversationVisibility @map("visibility")

  /// The name rendered behind a hash or lock glyph in the sidebar row, the header, the
  /// details-modal title, the About tab's card and the browser row
  /// (`02-channels.md` L782, frames 60, 81, 108, 125).
  ///
  /// NULLABLE, because a direct message has none: the catalogue's whole basis for
  /// treating the two as variants is that a direct message shows "no hash-prefixed
  /// name, no member count, no topic or description and no details pane"
  /// (`README.md` L327).
  ///
  /// UNIQUE PER WORKSPACE ACROSS EVERY LIFECYCLE STATE. The name is a RESOLUTION KEY:
  /// a mention chip and a copied link both resolve a name to exactly one conversation,
  /// and two matches make resolution — and therefore re-authorization on resolution —
  /// ambiguous. An archived conversation still resolves, because it renders read-only
  /// rather than disappearing, so excluding archived rows from the constraint would let
  /// one name resolve twice. Case folding is satisfied by the stored form rather than
  /// by a functional index: the name grammar in
  /// `packages/shared/src/config/constants.ts` admits lower case only, so a
  /// case-folded index and this one coincide. NULLs are distinct in PostgreSQL, so any
  /// number of direct messages coexist under this constraint.
  name String? @map("name")

  /// An optional single value whose empty state renders as a placeholder-styled prompt
  /// (`02-channels.md` L784, frames 81, 104).
  topic String? @map("topic")

  /// A multi-line rich value that may contain mention chips, editable and CLEARABLE,
  /// and not rewritten when the conversation is renamed
  /// (`02-channels.md` L785, frames 99, 102, 103, 104). Held as the structured content
  /// document `packages/shared/src/schemas/content.ts` defines, so the server
  /// re-validates the same allowlist it stores.
  description Json? @map("description")

  /// A short line rendered on a browser row beside the member count, able to contain a
  /// mention chip (`02-channels.md` L800, frames 125, 133).
  purpose String? @map("purpose")

  /// Nullable rather than not-null with an empty-string sentinel, for `topic`,
  /// `description` and `purpose` alike. "Never set" and "cleared" render identically
  /// but are different facts, and a browser row renders a purpose only when one is
  /// present. A sentinel would force every reader to know the convention; nullability
  /// puts the fact in the column.
  ///
  /// The opaque token the details modal's footer renders beside a copy control,
  /// present on the archived variant too (`02-channels.md` L788, frames 81, 136).
  /// Separate from the primary key, so a copied identifier can be rotated without
  /// rewriting every foreign key that points here.
  publicIdentifier String @unique @map("public_identifier")

  /// The creator and the creation date, rendered as one read-only row with no edit
  /// control (`02-channels.md` L787, frames 81, 76). The creator reference is nullable
  /// only so that removing an account does not remove the conversation it created.
  createdByUserId String? @map("created_by_user_id")

  /// A per-conversation setting stating that members can start and join huddles here
  /// (`02-channels.md` L795, frame 84).
  huddlesEnabled Boolean @default(true) @map("huddles_enabled")

  // THE INTEGRATIONS CARD IS NOT A COLUMN HERE, and the reason is placement rather than
  // omission. The details pane renders a card listing apps installable into the
  // conversation plus two plan-gated capabilities (`02-channels.md` L796, frame 83), and
  // that card is a projection over three facts that already have homes: what may be
  // installed is `App`'s catalogue data, whether this workspace has installed it is
  // `AppInstallation` — the catalogue is explicit that installed state is per workspace
  // (`README.md` L368) — and whether the workspace may use a gated capability is resolved
  // from its commercial-position group and nowhere else (`README.md` L341). An app's
  // presence in a conversation is evidenced only as "messages posted into a conversation
  // under the app's own author identity" (`README.md` L338, frame 120), which
  // `Message.authorAppId` already carries. A per-conversation install table would be a
  // fourth home for a fact the consolidated model does not list on this entity.

  /// The administrator-only toggle that adds anyone who joins the workspace to this
  /// conversation (`02-channels.md` L803, frames 72, 73). Stays on the conversation —
  /// see this model's doc-comment — and is authorized per `S-AUTHZ-OP` at the point of
  /// execution, so a control hidden in the client exempts nothing.
  autoAddOnJoin Boolean @default(false) @map("auto_add_on_join")

  /// Both lifecycle states, both as absolute instants
  /// (`02-channels.md` L798, L799, frames 84, 111, 112, 134).
  ///
  /// ARCHIVING IS REVERSIBLE and removes the composer, the member count, the huddle
  /// control, the bookmark row, the Members tab and the leave action; reversal restores
  /// every removed affordance at once and adds a system entry, which is why the
  /// reversal is a write to this column plus a `Message` row of subtype
  /// `CONVERSATION_UNARCHIVED` rather than a state machine of its own.
  ///
  /// DELETION IS TERMINAL and sits behind a confirmation gated by an acknowledgement
  /// checkbox. A soft marker rather than a row removal, so the authorized, audited
  /// sweep of derived stores has something to run against.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  counter           ConversationCounter?
  members           ConversationMembership[]
  messages          Message[]
  bookmarkFolders   ConversationBookmarkFolder[]
  bookmarks         ConversationBookmark[]
  threads           Thread[]
  files             StoredFile[]
  huddles           Huddle[]
  canvases          Canvas[]
  invitations       Invitation[]
  invitationScopes  InvitationConversationScope[]
  capabilityLinks   CapabilityLink[]
  externalScopes    ExternalOrganizationConversationScope[]
  userGroupDefaults UserGroupDefaultConversation[]
  forwardedMessages Message[]                               @relation("MessageForwardedFromConversation")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, conversationType])
  @@index([workspaceId, visibility, archivedAt])
  @@index([workspaceId, deletedAt])
  @@map("conversation")
}

/// ENTITY     Per-viewer relation 1 of 10 — conversation membership, keyed by
///            conversation + member (`README.md` L363). Not an entity.
/// TENANCY    TENANT-SCOPED. The tenant key is carried here as well as on both ends.
/// RETENTION  `S-RETENTION` class: per-viewer state, retained while the account and the
///            conversation both exist. A departure is recorded rather than deleted —
///            see `leftAt` below.
///
/// THIS RELATION IS THE AUTHORIZATION PREDICATE. Every read of a private conversation
/// resolves through these rows, and every one of the eight projections `R1` enumerates
/// is authorized by joining them: a count is computed inside the authorized query, a
/// member list IS these rows, a facepile is that list with a bound, an autocomplete
/// suggestion is membership plus the tenant key queried per request, and a
/// notification carries a reference rather than content. `apps/api/test/integration/
/// projections/**` asserts a private conversation's ABSENCE from all eight, and this
/// table is what makes the absence provable rather than merely likely.
///
/// WHAT MOVES ONTO IT, AND OUT OF THE CONVERSATION. The relation table's first row
/// names the unread flag and its message count, the has-draft flag, the
/// per-conversation notification scope and mute, the joined marker and the star, plus
/// "the six further per-member facts the conversation details surface renders"
/// (`README.md` L363, `02-channels.md` L807). Where the two sources overlap — the
/// notification preference, the starred flag and the joined marker appear in both —
/// the union is declared ONCE here rather than twice.
///
/// THERE IS NO DENORMALIZED UNREAD COUNTER, HERE OR ANYWHERE. A viewer's unread count
/// is a projection over the messages they are authorized to read, above the cursor
/// this row holds. A stored counter cannot be that for two reasons that compound: it
/// is one number for an object many viewers see, so it cannot be right for more than
/// one of them; and it is computed before the reader's authorization is known, so it
/// would count content the reader may not read — which the read contract names as a
/// disclosure, because a count over unreadable content discloses that the content
/// exists (`00-product-overview.md` L512). The cursor is the stored fact; the count is
/// derived from it on every read.
model ConversationMembership {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  conversationId String @map("conversation_id")
  userId         String @map("user_id")

  /// The joined marker, as two absolute instants rather than a status value.
  ///
  /// A NULL `leftAt` MEANS CURRENTLY JOINED. Deleting the row on departure would lose
  /// the distinction between "never joined" and "left", which the read path needs in
  /// order to answer a private conversation correctly, and it would silently destroy
  /// the viewer's per-conversation state on a rejoin. A status value would encode a
  /// date's worth of meaning without the date, and dates here are timestamps by rule.
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  /// THE READ CURSOR. The highest message sequence this viewer has read in this
  /// conversation, and the single stored fact every unread projection is computed from:
  /// the unread flag, the sidebar row's treatment, the numeric badge and the rail's
  /// aggregate badge are all one model keyed by viewer
  /// (`00-product-overview.md` L910, frames 340, 700, 715). Nullable — a viewer who has
  /// read nothing has no cursor, which is a different fact from having read position
  /// zero.
  lastReadSequence Int? @map("last_read_sequence")

  /// Where the labelled unread rule renders, which is not always the read cursor: a
  /// deliberate mark-as-unread moves this boundary without moving what the viewer has
  /// actually read (`README.md` L338, frames 299, 380).
  unreadBoundarySequence Int? @map("unread_boundary_sequence")

  /// The has-draft flag the sidebar renders (`README.md` L363, frame 120). Derivable
  /// from a draft `Message` row, and stored because the sidebar renders it for every
  /// row in one read and a per-row existence check would be a query per row.
  hasDraft Boolean @default(false) @map("has_draft")

  /// Per-conversation notification scope and the SEPARATE mute flag. The menu's fourth
  /// option is the mute, which is why it is a column rather than a fourth scope member
  /// (`02-channels.md` L789, frames 89, 90, 96).
  notificationScope NotificationScope? @map("notification_scope")
  muted             Boolean            @default(false) @map("muted")

  /// The per-device override applied to mobile devices only, disclosed by its own
  /// checkbox (`02-channels.md` L790, frames 93, 94). Nullable: no override is a
  /// different fact from an override that matches the primary scope.
  mobileNotificationScope NotificationScope? @map("mobile_notification_scope")

  /// The per-conversation checkbox covering all thread replies in it
  /// (`02-channels.md` L791, frame 92).
  threadReplyNotifications Boolean @default(false) @map("thread_reply_notifications")

  /// The star, whose set state relocates the conversation into a starred sidebar group
  /// (`02-channels.md` L792, frames 86, 87).
  starred Boolean @default(false) @map("starred")

  /// Sidebar placement — the default group, the starred group, or a viewer-created
  /// section (`02-channels.md` L804, frames 86, 120). The section reference is
  /// populated only for `CUSTOM_SECTION`, and it points at the viewer's OWN section
  /// rows, so one member's arrangement is unreachable from another's.
  sidebarPlacement SidebarPlacement @default(DEFAULT_GROUP) @map("sidebar_placement")
  sidebarSectionId String?          @map("sidebar_section_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sidebarSection SidebarSection? @relation(fields: [sidebarSectionId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([workspaceId])
  @@index([userId, leftAt])
  @@index([conversationId, leftAt])
  @@map("conversation_membership")
}

/// ENTITY     Infrastructure — the per-conversation sequence counter. Not an entity,
///            not a field group, and not per-viewer state.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: structural, conversation-lifetime. Holds no content
///            and no personal value, so it is retained with the conversation and
///            removed with it.
///
/// ONE ROW PER CONVERSATION, FROM THE MOMENT THE CONVERSATION IS CREATED. This is a
/// precondition rather than a nicety: `packages/db/src/sequence.ts` takes a row-level
/// lock on this row INSIDE the same transaction as the message insert, and a lock
/// needs a row to hold. `apps/api/src/services/channel.ts` therefore creates the
/// counter in the same transaction as the conversation, and both seeds do the same.
///
/// A NATIVE POSTGRESQL SEQUENCE OBJECT IS REJECTED, AND THE REASON IS NOT PREFERENCE.
/// Sequences are NON-TRANSACTIONAL by design: a value handed out is consumed whether
/// or not the surrounding transaction commits, so a rolled-back send permanently
/// removes a number from the series. That leaves a gap, and a gap here is not a
/// cosmetic defect — from the client's side it is indistinguishable from a message the
/// client is authorized to read and has not received. The whole reconnect design rests
/// on a client knowing its highest CONTIGUOUS sequence and asking for what follows, so
/// a series with holes can never become contiguous and the client would either wait
/// for a message that will never arrive or refetch on every gap. Sequences also cannot
/// satisfy "assigned on commit", because they assign on call. An ordinary row can,
/// because it participates in the ordinary transaction.
///
/// A LATER AGENT MUST NOT "SIMPLIFY" THIS INTO A SEQUENCE OR AN AUTO-INCREMENT.
/// The uniqueness constraint on `Message` is the backstop that would catch a second
/// allocator, but the gap a sequence leaves is not something a constraint can catch.
model ConversationCounter {
  /// The conversation is the primary key. One row per conversation is then a property
  /// of the table rather than a rule someone has to remember, and the lock target is
  /// addressable by the identifier the caller already holds.
  conversationId String @id @map("conversation_id")
  workspaceId    String @map("workspace_id")

  /// The next value to hand out. Starts at 1 — a structural starting point, not a
  /// policy value — and is advanced by the allocator under the row lock.
  nextSequence Int @default(1) @map("next_sequence")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("conversation_counter")
}

/// ENTITY     Part of `E-CHANNEL` — a bookmark folder (`README.md` L327,
///            `02-channels.md` L794). Not an entity: the catalogue lists bookmarks and
///            bookmark folders among the conversation's own fields.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, conversation-lifetime.
///
/// EXACTLY ONE LEVEL OF NESTING, and the shape below is what enforces it: a bookmark
/// may name a folder, and a folder has no parent column to name another with. The
/// specification evidences bookmarks and bookmark folders and never a folder inside a
/// folder (`README.md` L327, frames 263, 265, 266). Arbitrary nesting would commit the
/// schema to structure nobody asked for and every read path would then have to walk
/// it; no folders at all would drop evidenced behaviour, which `R3` prohibits.
model ConversationBookmarkFolder {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  conversationId String @map("conversation_id")

  name String @map("name")

  /// The selectable leading glyph, named by function rather than by any third-party
  /// asset (`02-channels.md` L793).
  glyphName String? @map("glyph_name")

  position Int @default(0) @map("position")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bookmarks    ConversationBookmark[]

  @@unique([conversationId, name])
  @@index([workspaceId])
  @@index([conversationId, position])
  @@map("conversation_bookmark_folder")
}

/// ENTITY     Part of `E-CHANNEL` — a bookmark (`README.md` L327,
///            `02-channels.md` L793). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, conversation-lifetime.
///
/// The destination is stored as an address and is canonicalized and allowlisted on the
/// way in by `apps/api/src/links/canonicalize.ts` per `S-LINK` — two schemes only, no
/// opener and no referrer on the way out. NO PREVIEW TEXT IS DENORMALIZED HERE:
/// stored preview text is a copy of content made when someone else was authorized, and
/// it would survive the revocation that should have removed it, so a product link
/// resolves to an object reference that is re-authorized on follow.
model ConversationBookmark {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  conversationId String @map("conversation_id")

  /// The folder this bookmark is filed under, or null for a top-level chip. This is the
  /// one-level nesting: a bookmark names a folder, a folder names nothing.
  folderId String? @map("folder_id")

  name        String  @map("name")
  destination String  @map("destination")
  glyphName   String? @map("glyph_name")
  position    Int     @default(0) @map("position")

  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  folder       ConversationBookmarkFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy    User?                       @relation("BookmarkCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([conversationId, position])
  @@index([folderId])
  @@map("conversation_bookmark")
}

// =============================================================================
// MESSAGES — AND THE FOUR STRUCTURAL INVARIANTS THE DATABASE ENFORCES
// =============================================================================

/// ENTITY     `E-MESSAGE` — a posted entry in a conversation.
/// TENANCY    TENANT-SCOPED. `workspaceId` is NOT NULLABLE.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime, with
///            deletion redacting the body IN THE SAME WRITE that sets `deletedAt`.
///            A deletion must reach every derived store — the search index, caches and
///            materialised aggregates, thumbnails and previews, notification payloads
///            already queued, export artefacts still available, and backups within the
///            stated window — because "a value that survives in an index is not
///            deleted" (`00-product-overview.md` L594).
///
/// -----------------------------------------------------------------------------
/// AUTHORSHIP IS A UNION AND IT IS OPTIONAL ON EVERY BRANCH
/// -----------------------------------------------------------------------------
///
/// `origin` is required; every author reference is nullable, INCLUDING the person one.
/// The catalogue states it outright — a message may be authored by a person, posted by
/// an app, sent by a workflow, or emitted by the system with no author at all, "so no
/// single author edge may be mandatory" (`README.md` L411) — and the diagram's `may
/// author`, `may post` and `may send` cardinalities say the same thing three times
/// (`README.md` L429, L444, L445).
///
/// A DATABASE-LEVEL CHECK that the discriminator and the populated reference agree
/// belongs in the migration SQL under `packages/db/prisma/migrations/`, not here:
/// Prisma has no check-constraint syntax, and expressing the rule as a comment while
/// pretending it is enforced would be worse than either.
///
/// -----------------------------------------------------------------------------
/// FOUR INVARIANTS, ENFORCED BY THE DATABASE RATHER THAN BY THE CODE THAT WRITES
/// -----------------------------------------------------------------------------
///
/// 1. `@@unique([conversationId, sequence])` — a second message at the same position
///    is UNREPRESENTABLE rather than merely unlikely. The sequence is allocated inside
///    the same transaction as this insert by `packages/db/src/sequence.ts`, which locks
///    the conversation's counter row; two concurrent sends serialise on that row and
///    receive consecutive values, and a send that rolls back releases the value it held
///    and leaves no hole behind. This constraint is the BACKSTOP: if a second write path
///    ever allocated a value another way, the defect surfaces as a failed insert rather
///    than as two messages claiming one position.
///
/// 2. `@@unique([conversationId, clientId])` — optimistic send, deduplicated. See
///    `clientId` below for why the column is nullable and why that is deliberate.
///
/// 3. `@@index([conversationId, sequence(sort: Desc)])` — the keyset read, declared
///    EXPLICITLY on the tuple rather than left as a side effect of the constraint above.
///    The predicate that fetches history is "the rows of this conversation whose sequence
///    precedes the last one I saw, NEWEST FIRST", and without an index on that exact
///    tuple it is correct and slow: the database finds the conversation's rows and then
///    sorts them, on every page, at a cost that grows with the conversation. With one, a
///    page is a range scan whose cost does not care whether the conversation holds a
///    thousand messages or a million.
///
///    ITS RELATIONSHIP TO THE UNIQUE CONSTRAINT'S IMPLICIT INDEX, STATED HONESTLY
///    RATHER THAN FLATTERINGLY: THE TWO OVERLAP. PostgreSQL scans a b-tree in either
///    direction at the same cost, so the ascending index the constraint creates already
///    serves a descending read — a verified plan for the keyset predicate above chooses
///    `Index Scan Backward` over that index. This declaration is therefore not what makes
///    the read fast on PostgreSQL today; the constraint's index would.
///
///    IT IS KEPT ANYWAY, FOR TWO REASONS THAT ARE ABOUT CORRECTNESS OVER TIME RATHER
///    THAN ABOUT SPEED NOW. It makes the read's dependency EXPLICIT: the keyset contract
///    in `packages/shared/src/schemas/pagination.ts` depends on this tuple being indexed,
///    and a dependency that exists only as a side effect of a uniqueness rule is one a
///    later change to that rule can remove without anyone noticing. And it states the
///    read's own DIRECTION, so the descending sort history uses is recorded where a
///    reviewer reading the schema will find it. A later agent that decides the overlap is
///    not worth the write cost on the product's busiest table may drop this index — but
///    must then move both statements above into a comment on the constraint, because the
///    keyset read's dependency has to be recorded somewhere.
///
///    OFFSET PAGINATION IS PROHIBITED EVERYWHERE and no page index exists in any
///    contract. An offset carries a row count and no context, so the database must fetch
///    and discard what it skips, and any row inserted between two page fetches shifts
///    the window and produces a duplicate — in a conversation being written to while it
///    is read, which is the normal case. This index is therefore the whole mechanism
///    behind `packages/shared/src/schemas/pagination.ts`, whose cursor is opaque and
///    encodes this exact tuple.
///
/// 4. The DURABLE SEQUENCE IS THE ORDERING AUTHORITY, and nothing else is. The
///    publish-and-subscribe bus that carries events between server instances offers
///    AT-MOST-ONCE delivery, so a dropped event is dropped silently and no reader can
///    tell "nothing happened" from "something happened and the notice was lost". A
///    transport with that property can accelerate delivery and can never be a source of
///    truth, so the database holds the ordering, the client persists its highest
///    contiguous sequence, and a reconnecting client asks over HTTP for what follows
///    before resuming live delivery. The replay window and the refetch signal live in
///    `docs/decisions/realtime-contract.md`.
model Message {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  conversationId String @map("conversation_id")

  /// THE POSITION. A plain 32-bit integer, not a big integer, and the ceiling is stated
  /// here so the choice is reviewable rather than accidental: the scale target is a
  /// million messages per conversation and the signed 32-bit range is 2,147,483,647,
  /// which is roughly two thousand times that. A big integer would double the width of
  /// the busiest index in the product to buy headroom nothing asks for.
  ///
  /// NULLABLE, AND THAT IS THE SAME REASONING AS THE NATIVE-SEQUENCE REJECTION. A
  /// sequence is "assigned on commit" — literally, in the transaction that delivers the
  /// message into the conversation — so a DRAFT and a SCHEDULED message hold none. If a
  /// draft consumed a position, a draft that is never sent would leave a permanent hole
  /// in the series, and a hole is indistinguishable from a message the client is
  /// authorized to read and has not received: exactly the failure the gapless counter
  /// exists to prevent. PostgreSQL treats NULLs as distinct in a unique index, so any
  /// number of drafts coexist in one conversation under the constraint below. History
  /// reads select delivered rows, so a null position is never served as a position.
  sequence Int? @map("sequence")

  /// THE CLIENT'S OWN IDENTIFIER, generated before the server has seen the send so the
  /// sender's own message can render immediately and be reconciled against the
  /// acknowledgement. Its format and generation are owned by
  /// `packages/shared/src/util/ulid.ts`, which states plainly that it guarantees no
  /// uniqueness itself — this column and the constraint below are "the only place it can
  /// be enforced rather than hoped for".
  ///
  /// NULLABLE, DELIBERATELY. PostgreSQL treats NULLs as distinct in a unique index, so
  /// server-originated messages — system, app and workflow — coexist freely with no
  /// client identifier at all, while EVERY client-generated send is deduplicated. A
  /// send whose response was lost is retried with the same value, the second insert
  /// fails on the constraint, the handler resolves the existing row and returns it: the
  /// duplicate is not detected and cleaned up, it is NEVER CREATED. This is also why the
  /// value is stored rather than discarded after reconciliation — a constraint can only
  /// enforce uniqueness over a column that exists.
  clientId String? @map("client_id")

  origin        MessageOrigin        @map("origin")
  deliveryState MessageDeliveryState @map("delivery_state")

  /// Every author branch, all of them nullable. See this model's doc-comment.
  authorUserId     String? @map("author_user_id")
  authorAppId      String? @map("author_app_id")
  authorWorkflowId String? @map("author_workflow_id")

  /// The rich body, held as the structured content document
  /// `packages/shared/src/schemas/content.ts` defines. It carries the inline marks for
  /// bold, italic and inline code, the block marks for bulleted list, ordered list,
  /// blockquote and code block, emoji, and the mention chips for a conversation, a
  /// person and an audience (`README.md` L328, frames 232, 235, 141, 120, 233, 236, 202,
  /// 176). A HYPERLINK IS A NODE INSIDE THIS DOCUMENT holding a separate display text
  /// and destination pair, both editable — which is where the catalogue puts it
  /// (`README.md` L328, frame 176) — so no second table is needed and none is invented.
  ///
  /// Stored as the structured document and NEVER as markup, per `S-CONTENT`: encoding
  /// happens per output sink at render time, and match highlighting is a distinct sink.
  /// The server re-validates the same allowlist independently of the editor before
  /// persisting, so a client that admits a node this schema's readers do not expect
  /// cannot write one.
  ///
  /// NULLABLE, for two reasons that are both real: a system message renders a sentence
  /// authored by this product from its subtype and references rather than a stored body,
  /// and a TOMBSTONE retains no content. See `deletedAt`.
  body Json? @map("body")

  /// The pinned flag WITH WHO PINNED IT, which the label above the author line renders
  /// (`README.md` L328, `03-messaging-and-composer.md` L651, frame 249). An absolute
  /// instant rather than a boolean, so the record says when as well as whether, and the
  /// flag is `pinnedAt != null`.
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz(3)
  pinnedByUserId String?   @map("pinned_by_user_id")

  /// The edited flag, surfaced as a marker appended to the body
  /// (`README.md` L328, frames 252, 254, 301). An absolute instant for the same reason:
  /// the flag is `editedAt != null`, and the instant is a fact the boolean would throw
  /// away.
  editedAt DateTime? @map("edited_at") @db.Timestamptz(3)

  /// Scheduled delivery: a destination conversation plus a date and a time, "interpreted
  /// in a time zone the dialog names" (`README.md` L328,
  /// `03-messaging-and-composer.md` L651, frames 179, 184, 185). The destination is
  /// `conversationId` above.
  ///
  /// THE INSTANT AND THE NAMED ZONE ARE BOTH STORED, BECAUSE THEY ANSWER DIFFERENT
  /// QUESTIONS. The instant answers "when does this go out". The zone answers "what did
  /// the person mean", which is what a surface has to render back to them and what a
  /// daylight-saving transition can change without changing the instant. Storing only
  /// the instant loses the intent; storing only the local time and the zone leaves the
  /// scheduler resolving a policy question on every tick.
  scheduledFor      DateTime? @map("scheduled_for") @db.Timestamptz(3)
  scheduledTimeZone String?   @map("scheduled_time_zone")

  /// The forwarded shape: accompanying text (this row's own body), a QUOTED ORIGINAL,
  /// and a provenance line naming the source conversation with a view-conversation link
  /// (`README.md` L328, frame 248).
  ///
  /// BOTH ENDS ARE REFERENCES, NOT COPIES. The quoted original and the provenance line
  /// are RENDERED from these two references at read time, and the render is authorized
  /// then. A denormalized quote would be a copy of content made when the forwarder was
  /// authorized, and it would survive the revocation that should have removed it — which
  /// is the same failure `S-RETENTION`'s "loss of access propagates" rule names.
  forwardedFromMessageId      String? @map("forwarded_from_message_id")
  forwardedFromConversationId String? @map("forwarded_from_conversation_id")

  /// The parent-thread reference on a reply. Present from the first migration even
  /// though the threads surfaces arrive later, which is what lets the threads phase add
  /// a table rather than rewrite rows (`README.md` L328, frames 225, 226).
  ///
  /// A reply renders inside the thread and nowhere in the conversation body, while the
  /// parent gains a summary row the conversation renders. THE SUMMARY IS A PROJECTION,
  /// not a column: the facepile, the reply count and the last-reply time are computed
  /// over the thread's replies inside the authorized query, because a stored count is
  /// one number for many viewers and is computed before the reader is known.
  parentThreadId String? @map("parent_thread_id")

  /// The also-send-to-conversation flag on a reply, whose target is a conversation of
  /// either type (`README.md` L328, frames 223, 296, 355).
  alsoSendToConversation Boolean @default(false) @map("also_send_to_conversation")

  /// The system subtype, in the forms the catalogue evidences. Null for every message
  /// that is not a system message; see `SystemMessageSubtype` for the eight forms and
  /// their citations. Whether a suppression affordance renders is derived from the
  /// subtype, and whether it has been USED is per viewer and lives on
  /// `ViewerMessageState` — the catalogue is explicit that suppression is per message
  /// rather than only per conversation (`README.md` L338, frames 110, 378).
  systemSubtype SystemMessageSubtype? @map("system_subtype")

  /// The huddle-entry fields: a title, a live flag rendered as a pill, and the variant
  /// (`README.md` L328, frames 299, 552, 268, 300). The optional
  /// participants-and-duration line and the join action are RENDERED from the referenced
  /// huddle, which already carries its participants and its duration, so neither is
  /// copied here.
  huddleId           String?               @map("huddle_id")
  huddleEntryTitle   String?               @map("huddle_entry_title")
  huddleEntryLive    Boolean               @default(false) @map("huddle_entry_live")
  huddleEntryVariant HuddleMessageVariant? @map("huddle_entry_variant")

  /// THE TOMBSTONE. Deletion sets this instant and CLEARS `body` in the same write; the
  /// row itself is never removed.
  ///
  /// THIS FOLLOWS FROM THE RECONNECTION PROTOCOL AND IS EASY TO GET WRONG. The client
  /// persists its highest CONTIGUOUS sequence and replays the gap, so a physically
  /// removed row leaves a position that can never be served: the client either stalls
  /// waiting for it or treats it as a permanently missing event. The tombstone keeps the
  /// series dense while retaining NO CONTENT, so `S-RETENTION`'s requirement that a
  /// deletion reach primary storage and every derived store is still satisfied —
  /// redacting at the write rather than at the read means no later read path can serve
  /// the body by accident.
  ///
  /// A LATER AGENT MUST NOT SIMPLIFY THIS INTO A HARD DELETE. The confirmation dialog's
  /// own wording states the action cannot be undone
  /// (`03-messaging-and-composer.md` L651, frame 255), and that promise is kept by the
  /// body being gone, not by the row being gone.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// The authored timestamp the list renders as a time of day and the delete preview
  /// renders as an absolute date-and-time (`README.md` L328, frames 202, 255).
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // A COPYABLE PERMALINK is offered from the overflow menu
  // (`03-messaging-and-composer.md` L651, frame 244) and is deliberately not a column:
  // it is composed from the workspace, the conversation and this row's identifier, and a
  // stored copy would be a second thing to keep true.

  workspace                 Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation              Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  forwardedFromConversation Conversation? @relation("MessageForwardedFromConversation", fields: [forwardedFromConversationId], references: [id], onDelete: SetNull)
  authorUser                User?         @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorApp                 App?          @relation("MessageAuthorApp", fields: [authorAppId], references: [id], onDelete: SetNull)
  authorWorkflow            Workflow?     @relation("MessageAuthorWorkflow", fields: [authorWorkflowId], references: [id], onDelete: SetNull)
  pinnedBy                  User?         @relation("MessagePinnedBy", fields: [pinnedByUserId], references: [id], onDelete: SetNull)
  parentThread              Thread?       @relation("ThreadReplies", fields: [parentThreadId], references: [id], onDelete: SetNull)
  huddle                    Huddle?       @relation("HuddleSystemMessages", fields: [huddleId], references: [id], onDelete: SetNull)
  forwardedFrom             Message?      @relation("MessageForward", fields: [forwardedFromMessageId], references: [id], onDelete: SetNull)
  forwardedCopies           Message[]     @relation("MessageForward")

  startedThread  Thread?              @relation("ThreadParent")
  reactions      Reaction[]
  attachments    StoredFile[]
  embeddedCanvas Canvas[]
  viewerState    ViewerMessageState[]
  notifications  Notification[]

  @@unique([conversationId, sequence])
  @@unique([conversationId, clientId])
  @@index([conversationId, sequence(sort: Desc)])
  @@index([workspaceId])
  @@index([conversationId, deliveryState])
  @@index([authorUserId])
  @@index([parentThreadId])
  @@index([conversationId, pinnedAt])
  @@index([deliveryState, scheduledFor])
  @@map("message")
}

/// ENTITY     `E-REACTION` — an emoji applied to a message by a specific person.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, message-lifetime. Removed with
///            the message it applies to.
///
/// ONE ROW PER MESSAGE, EMOJI AND REACTOR, UNIQUE ON THE TRIPLE, WITH THE COUNT
/// DERIVED. Three shapes were available and two are wrong for stated reasons. A count
/// column on the message cannot be authorized: a count is a projection and must be
/// computed over the AUTHORIZED set, which a stored number cannot be. One row per
/// message and emoji carrying a count cannot support removal, because removing a
/// reaction needs to know whose it was. Uniqueness on the triple additionally makes a
/// retried reaction idempotent for free — the second insert fails and the state is
/// already what the caller wanted.
///
/// The chip the surface renders is "emoji and a count" (`README.md` L331, frame 550),
/// with several reactions per message (frame 213); both are projections over these rows.
model Reaction {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  messageId   String @map("message_id")
  userId      String @map("user_id")

  /// The emoji's name — which for a custom emoji "is also the token typed to use it"
  /// (`03-messaging-and-composer.md` L648, frame 216). A name rather than a codepoint
  /// string, so a native emoji and a custom one are addressed the same way and the
  /// custom reference below can resolve.
  emojiName String @map("emoji_name")

  /// Set for a custom emoji, null for a native one. A reference rather than a copy, so
  /// removing a custom emoji from the workspace does not leave reactions rendering an
  /// image nobody can find.
  customEmojiId String? @map("custom_emoji_id")

  /// The skin tone this reaction was actually sent with, which is part of the reaction's
  /// identity. THE VIEWER'S DEFAULT CHOICE IS A DIFFERENT FACT and lives on
  /// `UserPreference` per `S-PERUSER`; see that model's `defaultEmojiSkinTone`.
  skinTone Int? @map("skin_tone")

  // THE QUICK-REACTION SET IS NOT STORED, and saying so is part of covering this
  // entity's fields. A short set is "surfaced identically on the hover action bar and in
  // the picker's handy-reactions band" (`03-messaging-and-composer.md` L648, frames 208,
  // 211) — identical across both surfaces and across every capture, which is what a
  // product-provided set looks like rather than a per-workspace or per-viewer one. It is
  // therefore authored vocabulary in `packages/shared/src/copy/en.ts` and not a row here.
  // Nothing in the corpus shows it being edited; if a later phase evidences that, the set
  // becomes per-viewer state on `UserPreference` by the placement test and never a field
  // on a shared object.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customEmoji CustomEmoji? @relation(fields: [customEmojiId], references: [id], onDelete: SetNull)

  @@unique([messageId, userId, emojiName])
  @@index([workspaceId])
  @@index([messageId])
  @@index([userId])
  @@map("reaction")
}

/// ENTITY     Part of `E-REACTION` — the custom-emoji definition the catalogue lists
///            among that entity's fields, and the same set the workspace renders as its
///            "custom emoji set" (`README.md` L325, L331, frames 216, 629). Not a
///            twenty-first entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime.
///
/// THE NAME IS UNIQUE ACROSS THE WORKSPACE, which the corpus evidences through the
/// rejection itself: the field takes a destructive border, a message explains the
/// conflict, and the conflicting emoji is rendered beneath for comparison
/// (`03-messaging-and-composer.md` L648, frames 217, 218). The wording of that message
/// is authored for this product in `packages/shared/src/copy/en.ts`; `R4` permits the
/// RULE and never the sentence a frame shows for it.
model CustomEmoji {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The name, which is also the typed token.
  name String @map("name")

  /// The uploaded square image, held as a reference to a stored file. `S-UPLOAD`
  /// governs the path it arrived by; the stated size limit is enforced at upload
  /// initiation rather than recorded here.
  imageFileId String @map("image_file_id")

  /// The pack this emoji arrived with, if it arrived with one. Null for an
  /// individually added emoji.
  packId String? @map("pack_id")

  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  image     StoredFile @relation("CustomEmojiImage", fields: [imageFileId], references: [id], onDelete: Cascade)
  pack      EmojiPack? @relation(fields: [packId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  reactions Reaction[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([packId])
  @@map("custom_emoji")
}

/// ENTITY     Part of `E-REACTION` — an emoji pack "carrying a name, an author, an
///            emoji count and its member emoji, added workspace-wide in one action"
///            (`README.md` L331, frames 220, 221, 222). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime.
///
/// The emoji count is DERIVED from the member rows and is deliberately not a column: a
/// stored count is a second copy of a fact the member rows already carry, and the two
/// would eventually disagree.
model EmojiPack {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  name String @map("name")

  /// The pack's stated author, as published text rather than an account reference: the
  /// author of a pack is not necessarily a member of this workspace.
  authorLabel String? @map("author_label")

  /// Who in this workspace added it, which is a different fact from who wrote it.
  addedByUserId String? @map("added_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy   User?         @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  emoji     CustomEmoji[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("emoji_pack")
}

/// ENTITY     `E-THREAD` — a reply set hanging off a parent message or off a session's
///            own system message.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, conversation-lifetime.
///
/// Phase-1 scope: the reference exists from the first migration — `Message` carries
/// `parentThreadId` — so the threads phase adds surfaces rather than migrating rows.
///
/// THE UNREAD BOUNDARY AND THE REPLY-NOTIFICATION STATE ARE NOT FIELDS OF THIS RECORD.
/// The catalogue makes the point explicitly and says why a build must respect it: "or
/// one reader marking a thread read will mark it read for everyone"
/// (`README.md` L329, frames 355, 244). Both live on `ViewerThreadState`.
///
/// The reply count, the participant set and the latest-reply timestamp the summary row
/// renders are all PROJECTIONS over the replies, computed inside the authorized query,
/// and none of them is a column here.
model Thread {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  conversationId String @map("conversation_id")

  /// The parent, in the two kinds the catalogue evidences: "a person's message in the
  /// channel case and the huddle's own system message in the huddle case"
  /// (`README.md` L329, frames 223, 269). One column serves both, because both parents
  /// are messages — the huddle case's parent is the huddle's system message — and the
  /// huddle reference below records which session it belongs to. Unique, because a
  /// message starts at most one thread (`README.md` L440).
  parentMessageId String @unique @map("parent_message_id")

  /// The huddle this thread hangs off, when it does (`README.md` L448, frame 269).
  huddleId String? @unique @map("huddle_id")

  /// The also-send-as-direct-message flag, offered when the thread hangs off a huddle or
  /// a conversation (`README.md` L329, frame 269).
  alsoSendAsDirectMessage Boolean @default(false) @map("also_send_as_direct_message")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentMessage Message             @relation("ThreadParent", fields: [parentMessageId], references: [id], onDelete: Cascade)
  huddle        Huddle?             @relation("HuddleThread", fields: [huddleId], references: [id], onDelete: SetNull)
  replies       Message[]           @relation("ThreadReplies")
  viewerState   ViewerThreadState[]

  @@index([workspaceId])
  @@index([conversationId])
  @@map("thread")
}

// =============================================================================
// ATTACHMENTS, SESSIONS OF WORK, AND THE STRUCTURED SURFACES
// =============================================================================

/// ENTITY     `E-FILE` — an uploaded or recorded attachment.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime, and a
///            deletion must additionally remove thumbnails and previews. Where a row
///            was produced by a DEVICE CAPTURE — a recorded clip or a staged media
///            draft — `S-CONSENT` states the capture-specific lifecycle and this
///            contract supplies the general discipline it is an instance of: a stated
///            storage scope, encryption at rest, a retention bound, deletion when the
///            draft is discarded, notification to every participant that the record is
///            being made, and a deletion path afterwards
///            (`00-product-overview.md` L578).
///
/// NAMED `StoredFile` RATHER THAN `File`, because `File` is a platform global and a
/// generated client that exports one would shadow it at every call site.
///
/// BYTES NEVER TRANSIT THE API. Uploads are pre-signed, so this row holds the object
/// key the storage adapter issued plus the upload lifecycle the surfaces render — a
/// pending tile in the composer and an in-progress bordered placeholder block
/// (`README.md` L332, frames 165, 321). A device SAMPLE taken to preview a camera,
/// drive a level meter or run a diagnostic is transient by contract and never becomes a
/// row here; only a capture deliberately turned into content does.
model StoredFile {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  kind        FileKind    @map("kind")
  uploadState UploadState @map("upload_state")

  /// The name and the type glyph the file lists render (`README.md` L332, frame 488).
  name     String  @map("name")
  mimeType String? @map("mime_type")
  byteSize Int?    @map("byte_size")

  /// The object key in pre-signed storage. Unique, because two rows naming one object
  /// would make deletion ambiguous. Not a URL: an address would be a bearer value, and
  /// a download link is an `S-SECRET` class-B capability link issued per request.
  objectKey String? @unique @map("object_key")

  /// The conversation this file was shared into and the message it is attached to, both
  /// nullable: a file may exist as a composer attachment before it is sent, and the
  /// shared-files card renders on the owning conversation
  /// (`README.md` L332, frames 90, 165).
  conversationId String? @map("conversation_id")
  messageId      String? @map("message_id")

  /// The sharer and the shared date the file lists render (`README.md` L332, frame 488).
  /// The VIEWED-AT instant that drives the viewed-today and viewed-yesterday grouping is
  /// per viewer and lives on `ViewerFileState`, not here.
  sharedByUserId String?   @map("shared_by_user_id")
  sharedAt       DateTime? @map("shared_at") @db.Timestamptz(3)

  /// A template badge where applicable (`README.md` L332, frame 488).
  isTemplate Boolean @default(false) @map("is_template")

  /// Media properties the catalogue evidences: a clip's fixed duration once attached, a
  /// selectable thumbnail on a video clip, and the waveform an audio clip renders
  /// (`README.md` L332, `03-messaging-and-composer.md` L649, frames 190, 200, 201).
  /// The waveform is a computed rendering of the audio rather than an authored value,
  /// so it is held as structured data beside the clip rather than as an image.
  ///
  /// `durationMs` IS NOT AN EXCEPTION TO THIS FILE'S NO-DURATION RULE, because that rule
  /// is about deadlines. This is a MEASURED PROPERTY OF THE MEDIA — how long the recording
  /// runs — and there is no instant that expresses it: nothing expires, nothing is
  /// configured, and no default could change its meaning. The one deliberate exception for
  /// a configured POLICY duration is `ExternalOrganization.acceptanceWindowDays`.
  durationMs      Int?    @map("duration_ms")
  thumbnailFileId String? @map("thumbnail_file_id")
  waveform        Json?   @map("waveform")

  /// Snippet fields — a snippet is "a shareable file" carrying an optional title with a
  /// default filename, a type whose default is auto-detect, line-numbered content and a
  /// wrap flag (`03-messaging-and-composer.md` L649, frames 144, 146, 148). The
  /// required-field rule (content, never title) is
  /// `SNIPPET_REQUIRED_FIELDS` in `packages/shared/src/config/constants.ts` and is
  /// enforced there rather than restated here.
  snippetTitle    String?  @map("snippet_title")
  snippetType     String?  @map("snippet_type")
  snippetContent  String?  @map("snippet_content")
  snippetWrapText Boolean? @map("snippet_wrap_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  sharedBy     User?         @relation("FileSharer", fields: [sharedByUserId], references: [id], onDelete: SetNull)
  thumbnail    StoredFile?   @relation("FileThumbnail", fields: [thumbnailFileId], references: [id], onDelete: SetNull)

  thumbnailFor     StoredFile[]      @relation("FileThumbnail")
  workspaceIconFor Workspace[]       @relation("WorkspaceIcon")
  profilePhotoFor  User[]            @relation("UserProfilePhoto")
  nameClipFor      User[]            @relation("UserNameClip")
  customEmojiImage CustomEmoji[]     @relation("CustomEmojiImage")
  canvasCoverFor   Canvas[]          @relation("CanvasCover")
  viewerState      ViewerFileState[]

  @@index([workspaceId])
  @@index([conversationId])
  @@index([messageId])
  @@index([workspaceId, uploadState])
  @@map("stored_file")
}

/// ENTITY     `E-HUDDLE` — a live audio-and-video session hosted by a conversation.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, with the TRANSCRIPT held as a
///            separate store rather than written into message history. `S-CONSENT` is
///            explicit that "a speech-derived record is a separate store from the
///            conversation's message history, and is not written into it: conflating
///            the two would silently give speech the message history's search reach,
///            export reach and retention" (`00-product-overview.md` L578) — which is
///            why `transcript` below is a column of this record and never a `Message`.
///
/// Phase-1 scope: the reference exists so a huddle system message can be represented,
/// and the surfaces arrive with the huddles phase.
///
/// EVERY PER-PARTICIPANT FACT IS ABSENT FROM THIS RECORD. Microphone state, camera
/// state, the camera background, the invited-not-yet-joined marker and the connection
/// diagnostics are per participant rather than per session
/// (`README.md` L333, L369, frames 269, 270, 271), so they live on
/// `ViewerHuddleState`. The participant list itself is those rows.
model Huddle {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  conversationId String @map("conversation_id")

  name  String? @map("name")
  topic String? @map("topic")

  /// The live flag and the duration, which runs while live and is fixed once ended
  /// (`README.md` L333, frames 268, 401, 403, 407). Both derived facts are stored as
  /// what they are: two absolute instants. The duration a surface renders is
  /// `endedAt - startedAt`, or the elapsed time since `startedAt` while `endedAt` is
  /// null, so no running number is stored and no clock can make a stored one wrong.
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  /// The session-level switches: audio-only mode, the shared theme every participant
  /// sees, the decorative background behind the tiles, and the captions display option
  /// (`README.md` L333, frames 271, 283, 270, 287). The theme and background are
  /// AUTHORED TOKEN IDENTIFIERS rather than colour or asset values — there is no colour
  /// literal in this file.
  audioOnly         Boolean          @default(false) @map("audio_only")
  themeTokenId      String?          @map("theme_token_id")
  backgroundTokenId String?          @map("background_token_id")
  captionsDisplay   CaptionsDisplay? @map("captions_display")

  /// A waiting-room selection with its own stop control, offered while a person is alone
  /// in the session (`README.md` L333, frame 407).
  waitingRoomTokenId String? @map("waiting_room_token_id")

  /// The transcript of speaker-attributed entries (`README.md` L333, frames 287, 291).
  /// A separate store from message history — see this model's doc-comment.
  transcript Json? @map("transcript")

  /// The connection diagnostics in full: an overall verdict, three group ratings for
  /// network, system and devices, and four network metrics each with a rating and a
  /// measured value (`README.md` L333, frames 271, 272). Session-level here; the
  /// per-participant device state is on the viewer relation.
  diagnostics Json? @map("diagnostics")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  thread         Thread?             @relation("HuddleThread")
  systemMessages Message[]           @relation("HuddleSystemMessages")
  viewerState    ViewerHuddleState[]

  @@index([workspaceId])
  @@index([conversationId, endedAt])
  @@map("huddle")
}

/// ENTITY     `E-CANVAS` — a titled, block-structured document.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime.
///
/// Phase-1 scope: identifier and reference only; the surfaces arrive with the canvases
/// phase. The star, the saved-for-later flag and the last-viewed timestamp are PER
/// VIEWER and live on `ViewerCanvasState` (`README.md` L366) — the catalogue lists them
/// among this entity's rendered fields because a surface renders them there, and "where
/// the two appear to disagree about a per-viewer fact, [the relation] table governs"
/// (`README.md` L374).
model Canvas {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The title, defaulting to an untitled state in the interface rather than in storage
  /// (`README.md` L334, frame 153): the placeholder is authored copy in
  /// `packages/shared/src/copy/en.ts`, so this column stays nullable and no default
  /// string is written here.
  title String? @map("title")

  /// The blocks, including an image block (`README.md` L334, frame 316). Structured
  /// content, validated against the same allowlist the server re-checks for a message
  /// body.
  blocks Json? @map("blocks")

  /// Where it came from and where it lives: a template origin chosen from a
  /// product-provided list, the hosting conversation, and the message it is embedded in
  /// when it is (`README.md` L334, L442, frames 305, 690, 150).
  templateOrigin String? @map("template_origin")
  conversationId String? @map("conversation_id")
  messageId      String? @map("message_id")

  coverImageFileId String? @map("cover_image_file_id")

  /// Session-level settings the catalogue evidences: locked edits, show-by-default, the
  /// accessibility settings, and the template badge (`README.md` L334, frames 330, 690).
  editsLocked           Boolean @default(false) @map("edits_locked")
  showByDefault         Boolean @default(false) @map("show_by_default")
  isTemplate            Boolean @default(false) @map("is_template")
  accessibilitySettings Json?   @map("accessibility_settings")

  /// The created-by and location metadata the surface renders (`README.md` L334,
  /// frame 690).
  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  coverImage   StoredFile?         @relation("CanvasCover", fields: [coverImageFileId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("CanvasCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  viewerState  ViewerCanvasState[]

  @@index([workspaceId])
  @@index([conversationId])
  @@map("canvas")
}

/// ENTITY     `E-LIST` — a structured collection with typed fields, saved views and
///            layouts.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, workspace-lifetime.
///
/// NAMED `ChannelList` RATHER THAN `List`, because `List` is the name a generated client
/// would collide with in every consumer that also imports a collection type.
///
/// Phase-1 scope: identifier only; the surfaces arrive with the lists phase. The star,
/// the last-opened timestamp and the per-record notification subscription are PER
/// VIEWER and live on `ViewerListState` (`README.md` L367).
///
/// The field definitions and the named views are held as structured values rather than
/// as tables of their own. The catalogue describes them as definitions the list carries
/// — "fields defined by a name and a type selected from a field-type list" and "named
/// views carrying item counts, each a saved set of filters, sorting and layout"
/// (`README.md` L335, frames 431, 434, 464) — and the item counts those views render are
/// projections over the records rather than stored numbers.
model ChannelList {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  name        String  @map("name")
  description String? @map("description")

  /// The layout, and the sort field with its direction and multiple levels
  /// (`README.md` L335, frames 469, 474). The levels are structured because a single
  /// column cannot hold an ordered list of them.
  layout               ListLayout?    @map("layout")
  primarySortField     String?        @map("primary_sort_field")
  primarySortDirection SortDirection? @map("primary_sort_direction")
  sortLevels           Json?          @map("sort_levels")

  fieldDefinitions Json? @map("field_definitions")
  savedViews       Json? @map("saved_views")
  groups           Json? @map("groups")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  records     ChannelListRecord[]
  viewerState ViewerListState[]

  @@index([workspaceId])
  @@map("channel_list")
}

/// ENTITY     `E-LIST-RECORD` — one row of a list, carrying that list's field values.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace content, list-lifetime.
///
/// Phase-1 scope: identifier only. The assignee edge is the diagram's
/// `E-USER ||--o{ E-LIST-RECORD : "is assigned"` (`README.md` L438), and the custom
/// field values are held as a structured value keyed by the owning list's own field
/// definitions — a column per custom field is not expressible in a fixed schema, and
/// the catalogue's own model is "custom fields added per list" (`README.md` L336).
model ChannelListRecord {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  listId      String @map("list_id")

  title       String  @map("title")
  status      String? @map("status")
  priority    String? @map("priority")
  description String? @map("description")

  assigneeUserId String?   @map("assignee_user_id")
  dueAt          DateTime? @map("due_at") @db.Timestamptz(3)

  /// People and date cells that may be empty (`README.md` L336, frame 411), plus the
  /// custom field values.
  fieldValues Json? @map("field_values")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      ChannelList @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee  User?       @relation("ListRecordAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([listId])
  @@index([assigneeUserId])
  @@map("channel_list_record")
}

/// ENTITY     `E-WORKFLOW` — an automation with a trigger and ordered steps.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: workspace configuration, workspace-lifetime.
///
/// Phase-1 scope: the reference exists so a workflow-sent message can be represented —
/// `Message.authorWorkflowId` — and the builder surfaces arrive with the workflow phase.
model Workflow {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  name      String  @map("name")
  published Boolean @default(false) @map("published")

  publicationScope WorkflowPublicationScope? @map("publication_scope")

  /// The trigger, observed in a scheduled variant, and the ordered steps each able to
  /// carry a needs-attention warning (`README.md` L337, frames 571, 572, 573).
  trigger Json? @map("trigger")
  steps   Json? @map("steps")

  templateOrigin String? @map("template_origin")

  /// The legacy classification, and the dated restriction advisory rendered above the
  /// list because of it (`README.md` L337, `21-states.md` L496, frames 568, 569). The
  /// advisory's wording is authored in `packages/shared/src/copy/en.ts`; this column is
  /// the fact that drives it.
  legacy Boolean @default(false) @map("legacy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[] @relation("MessageAuthorWorkflow")

  @@index([workspaceId])
  @@map("workflow")
}

/// ENTITY     `E-APP` — software installed into a workspace, posting under its own
///            author identity and offering its own slash commands.
/// TENANCY    CATALOG-GLOBAL. This record carries NO TENANT KEY, and that is deliberate
///            rather than an omission: the app provider's published fields — its name,
///            description, category, directory-collection membership and published tiers
///            — are catalogue data readable by a signed-out visitor on the directory
///            detail page (`README.md` L338, frames 370, 921). A tenant column here
///            would make the read that serves a signed-out directory page a read of
///            tenant state.
/// RETENTION  `S-RETENTION` class: catalogue data, published-lifetime. Carries nothing
///            personal and nothing secret.
///
/// Third-party software is named FUNCTIONALLY throughout this product — a cloud-drive
/// app, a poll app, a calendar app — per `R4`. No third-party product name appears in
/// this file, in seed data or in any fixture.
///
/// A WORKSPACE'S TIER FOR AN APP IS NOT HERE. It lives in `AppInstallation`, keyed by
/// workspace and app, "and deliberately not `E-WORKSPACE`'s commercial position group,
/// which is the workspace's subscription to this product and is governed independently"
/// (`README.md` L338). The tenant edge is to the installation and never to a catalogue
/// field — the same one-directional rule the commercial position group states for
/// published tiers.
model App {
  id String @id @default(cuid()) @map("id")

  name        String  @map("name")
  description String? @map("description")
  category    String? @map("category")

  /// A recommended flag and directory-collection membership, both published properties
  /// (`README.md` L338, frames 400, 925).
  recommended          Boolean  @default(false) @map("recommended")
  directoryCollections String[] @map("directory_collections")

  /// The app-provided slash commands, each carrying a provider-and-description sub-line,
  /// and the published tiers the directory page renders
  /// (`README.md` L338, `03-messaging-and-composer.md` L654, frames 203, 204, 370).
  /// Published definitions, never a resolved answer for any workspace.
  slashCommands  Json? @map("slash_commands")
  publishedTiers Json? @map("published_tiers")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  installations AppInstallation[]
  messages      Message[]         @relation("MessageAuthorApp")

  @@index([category])
  @@map("app")
}

/// ENTITY     Field group of `E-APP` — the per-workspace installation, keyed by
///            workspace and app (`README.md` L338). Not a twenty-first entity.
/// TENANCY    TENANT-SCOPED. This is the tenant end of the app edge, and the ONLY
///            place a workspace's tier for a third-party app is held.
/// RETENTION  `S-RETENTION` class: workspace configuration, installation-lifetime.
///            Per `S-APPGRANT` the per-install credential is an `S-SECRET` class-C
///            secret held envelope-encrypted elsewhere, and this row references it only
///            by an OPAQUE RECORD IDENTIFIER — never by the value.
model AppInstallation {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  appId       String @map("app_id")

  installedAt DateTime  @default(now()) @map("installed_at") @db.Timestamptz(3)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(3)

  /// The workspace's current tier for this app and the entitlement it resolves to,
  /// which is what makes an app's home render its own upgrade notice for one workspace
  /// and not another (`README.md` L338, frame 372).
  tierReference        String? @map("tier_reference")
  resolvedEntitlements Json?   @map("resolved_entitlements")

  /// The granted scopes, per `S-APPGRANT`'s least-privilege and re-consent-on-expansion
  /// requirements. Enforced at runtime by `apps/api/src/authz/guard.ts`; recorded here so
  /// an expansion is detectable as a change rather than inferred.
  grantedScopes String[] @map("granted_scopes")

  /// The `S-SECRET` class-C pointer. Never the credential. Unique, so a destroyed
  /// credential cannot be reachable through a second row.
  credentialRef String? @unique @map("credential_ref")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  app         App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  viewerState ViewerAppState[]

  @@unique([workspaceId, appId])
  @@index([workspaceId])
  @@index([appId])
  @@map("app_installation")
}

/// ENTITY     `E-NOTIFICATION` — the notification configuration, the activity entries it
///            produces, and the reminders attached to them.
/// TENANCY    TENANT-SCOPED, and additionally keyed by the account that receives it:
///            the diagram's edge is `E-USER ||--o{ E-NOTIFICATION : "receives"`
///            (`README.md` L433), so a row belongs to exactly one recipient.
/// RETENTION  `S-RETENTION` class: notification record, bounded. A notification is a
///            PROJECTION THAT HAS ALREADY LEFT THE PRODUCT, so per `S-AUTHZ-READ` a row
///            carries a REFERENCE and the minimum needed to route the recipient, and
///            NEVER the content itself — a payload carrying content is a projection no
///            later check can reach (`00-product-overview.md` L512). Per
///            `S-RETENTION`'s "loss of access propagates", a row whose referenced object
///            the recipient can no longer read is removed or redacted on its next
///            render rather than persisting because it was authorized when written.
///
/// EVERY PER-CONVERSATION UNREAD FACT IS ABSENT FROM THIS RECORD. The shell's own table
/// states that "every field this row lists is per-viewer" and that each is held on a
/// per-viewer relation (`00-product-overview.md` L824): the per-conversation unread flag
/// and its count live on `ConversationMembership`'s read cursor, the read boundary lives
/// there too, the per-message suppression state lives on `ViewerMessageState`, and the
/// notification configuration lives on `UserPreference`. What remains here is the
/// ACTIVITY ENTRY and its reminder.
model Notification {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  /// The classification the feed renders, observed as an app notification or a thread
  /// reply (`README.md` L338, frame 381). A string rather than an enum only where the
  /// catalogue enumerates no closed set; here it does, so the two observed values are the
  /// vocabulary and `apps/api/src/services/unread.ts` owns it. Held as a string because
  /// the activity phase will add classifications the corpus does not yet show, and an
  /// enum member added later is a migration while a value is not.
  classification String @map("classification")

  /// The referenced object. A reference, never a copy — see this model's doc-comment.
  messageId String? @map("message_id")

  /// Unread and archived state (`README.md` L338, frames 356, 396). Per recipient by
  /// construction, because the row already is.
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  /// The reminder with its due time and its overdue marker (`README.md` L338, frame 394).
  /// An ABSOLUTE INSTANT; the overdue marker is a comparison against it and is not a
  /// stored flag, so no clock can make a stored one wrong.
  remindAt    DateTime? @map("remind_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId, readAt])
  @@index([userId, remindAt])
  @@index([messageId])
  @@map("notification")
}

// =============================================================================
// INVITATION, EXTERNAL COLLABORATION, THE PUBLISHED CATALOGUE AND QUERIES
// =============================================================================

/// ENTITY     `E-INVITATION` — an outstanding or resolved offer to join a workspace or a
///            single conversation.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: personal contact data plus an access grant. The
///            recipient address is `S-PII` and must stay queryable; the record is
///            retained while the invitation is outstanding and for the audit window a
///            deployment states after it resolves.
///
/// -----------------------------------------------------------------------------
/// EVERY DEADLINE HERE IS AN ABSOLUTE INSTANT, AND NOT ONE NUMBER IS WRITTEN
/// -----------------------------------------------------------------------------
///
/// This is the only entity in the model that carries a resolved date derived from
/// another entity's duration, and the derivation runs in ONE DIRECTION ONLY: the date is
/// resolved AT ISSUANCE from the window held once on `ExternalOrganization`, a change to
/// that window governs invitations issued afterwards, and A RESOLVED EXPIRY IS IMMUTABLE
/// IN BOTH DIRECTIONS — lengthening the window never extends an outstanding invitation
/// and shortening it never cuts one short either (`README.md` L409).
///
/// That is what `revokedAt` is for, and why it is a separate column rather than a
/// rewrite of `expiresAt`. Where outstanding access must end sooner, the invitations
/// concerned are explicitly REVOKED OR REISSUED as an authorized, audited operation,
/// rather than a date being rewritten underneath a credential its recipient already
/// holds.
///
/// TWO CATALOGUE SURFACES STATE TWO DIFFERENT LIFETIMES FOR THE SAME KIND OF LINK — the
/// in-product copy confirmation states one figure and the administration console's
/// invite-links table renders a different one on the same kind of link
/// (`README.md` L405, L948). NEITHER IS RECONCILED HERE AND NO NUMBER IS WRITTEN IN THIS
/// FILE. The build settles ONE lifetime in
/// `packages/shared/src/config/env.ts` as a documented, environment-overridable default,
/// stores the RESOLVED INSTANT on this record, renders both surfaces from that stored
/// value so they cannot disagree, and enforces it server-side on redemption so an expired
/// link is refused whatever any surface says. The contradiction is described in
/// `docs/decisions/catalog-defects.md` and the chosen default in
/// `docs/decisions/observed-values.md`; `R2` requires a defect in the read-only
/// specification to be recorded rather than corrected in place.
///
/// THE SHAREABLE LINK ITSELF IS NOT A FIELD OF THIS RECORD. It is an `S-SECRET` class-B
/// reusable capability link, held on `CapabilityLink` as a non-secret selector plus a
/// keyed verifier of the secret part (`01-onboarding-and-auth.md` L782, frame 46).
model Invitation {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The recipient address, held as a removable chip in the form and echoed on the
  /// success row (`01-onboarding-and-auth.md` L782, frames 41, 47). `S-PII` personal
  /// contact data: queryable, never a verifier, and never in a log or a URL.
  recipientEmail String @map("recipient_email")

  invitedAsRole InvitationRole      @map("invited_as_role")
  scope         InvitationScope     @map("scope")
  state         InvitationState     @map("state")
  direction     InvitationDirection @map("direction")

  deliveryMechanism InvitationDeliveryMechanism @map("delivery_mechanism")
  deliveryOutcome   InvitationDeliveryOutcome?  @map("delivery_outcome")

  /// The conversation scope — optional for a member and REQUIRED for a guest — held as
  /// removable chips in the form (`01-onboarding-and-auth.md` L782, frames 44, 50, 51).
  /// The requiredness is a rule the issuing service enforces, because a nullable column
  /// cannot express "required when the role is guest"; the rows below carry the scope.
  ///
  /// A single primary conversation is also referenced directly, because the reduced modal
  /// invites to "just that channel" and the disambiguation dialog says so
  /// (`README.md` L339, frame 65).
  conversationId String? @map("conversation_id")

  /// The optional note, with a show-email-preview link beside it
  /// (`README.md` L339, frame 67), and the custom message the full modal collects
  /// collapsed by default (`01-onboarding-and-auth.md` L782, frames 40, 45). One column:
  /// the two surfaces collect the same free text into the same place.
  note String? @map("note")

  /// The multi-channel-guest allowance whose stated consequence is billing as a full
  /// member (`README.md` L339, frame 50). Its effect is commercial rather than
  /// functional, and it resolves onto the accepted account's own billing classification.
  multiChannelGuestAllowed Boolean @default(false) @map("multi_channel_guest_allowed")

  /// The guest's chosen end date, committed through a date picker on the invitation form
  /// (`README.md` L407, frames 52, 54). Resolved to an absolute instant here and copied
  /// onto the account's `guestAccessEndsAt` on acceptance, because it is a property of an
  /// ACCOUNT once the account exists.
  guestAccessEndsAt DateTime? @map("guest_access_ends_at") @db.Timestamptz(3)

  /// Whether the receiving organization requires an approval before this invitation can
  /// resolve (`README.md` L339, frame 502).
  approvalRequired Boolean @default(false) @map("approval_required")

  /// The external organization this invitation runs through, for the externally-scoped
  /// variant (`README.md` L339, L450). Null for an ordinary workspace invitation.
  externalOrganizationId String? @map("external_organization_id")

  /// A typed label the sent register groups records under (`README.md` L339, frame 503).
  /// A string, because the register's label set is not enumerated anywhere.
  invitationTypeLabel String? @map("invitation_type_label")

  /// The five instants. ISSUANCE is the sent-at time the register renders relatively
  /// (frame 503). EXPIRY is the resolved deadline the record's muted second line renders
  /// as a calendar date (frame 503) and that redemption checks server-side. ACCEPTANCE is
  /// the joined date the accepted record carries (frame 655). REVOCATION is the console's
  /// revoke action (frame 654). DEACTIVATION is the per-record scheduled date observed on
  /// the bounced record only (frame 654) — a separate fact from expiry, which is why it
  /// is a separate column.
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  deactivatesAt DateTime? @map("deactivates_at") @db.Timestamptz(3)

  issuedByUserId   String? @map("issued_by_user_id")
  acceptedByUserId String? @map("accepted_by_user_id")

  /// Whether the sender has been notified of acceptance, which the form promises
  /// (`README.md` L339, frame 498).
  senderNotifiedAt DateTime? @map("sender_notified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation         Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  externalOrganization ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id], onDelete: SetNull)
  issuedBy             User?                 @relation("InvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  acceptedBy           User?                 @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  scopedConversations InvitationConversationScope[]
  capabilityLinks     CapabilityLink[]

  @@index([workspaceId])
  @@index([workspaceId, state])
  @@index([workspaceId, recipientEmail])
  @@index([expiresAt])
  @@map("invitation")
}

/// ENTITY     Relation table carrying `E-INVITATION`'s conversation scope, which is held
///            as removable chips and may name more than one
///            (`01-onboarding-and-auth.md` L782, frames 44, 50, 51). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: access grant, invitation-lifetime.
model InvitationConversationScope {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  invitationId   String @map("invitation_id")
  conversationId String @map("conversation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitation   Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, conversationId])
  @@index([workspaceId])
  @@index([conversationId])
  @@map("invitation_conversation_scope")
}

/// ENTITY     `E-EXTERNAL-ORG` — another company a workspace collaborates with.
/// TENANCY    TENANT-SCOPED: "the destination [is] workspace-scoped and reached from
///            that workspace's rail" (`README.md` L340, frames 399, 494).
/// RETENTION  `S-RETENTION` class: relationship record plus retained history. Per
///            `S-RETENTION`'s retained-copies rule, where this product's own copy states
///            that a party keeps a copy of content after collaborating, the build states
///            what that copy comprises, where it lives, how long it is kept and how it is
///            withdrawn — which is what `channelHistoryRetained` below records.
///
/// -----------------------------------------------------------------------------
/// THE ONE DELIBERATE DURATION COLUMN IN THIS ENTIRE SCHEMA
/// -----------------------------------------------------------------------------
///
/// `acceptanceWindowDays` is a DURATION, and it is the single exception to this file's
/// otherwise absolute rule that every deadline is stored as the moment it resolves to.
/// The exception is correct here and nowhere else, for one reason: THIS IS A POLICY
/// SETTING, NOT A DEADLINE. It is not the moment anything expires — it is the rule from
/// which each issued invitation's own deadline is computed, held ONCE on the relationship
/// it belongs to (`README.md` L406, L409). Every actual deadline it produces is an
/// absolute instant on `Invitation.expiresAt`.
///
/// The distinction matters because the two failure modes are opposite. A stored duration
/// on an invitation would be a second copy of configuration that goes stale the instant
/// the first copy changes, so reading the record would no longer tell you when it
/// expires. A stored duration HERE is the configuration — one place, deliberately
/// mutable, governing invitations issued after it changes and none issued before.
///
/// DECLARED WITH NO DEFAULT. `apps/api/src/services/invitation.ts` sets it from
/// `EXTERNAL_ACCEPTANCE_WINDOW_DAYS` in `@relay/shared`, which is a documented,
/// environment-overridable default in `.env.example`. A schema default here would be
/// exactly the hardcoded policy literal `R3` forbids, and worse than an inline one
/// because no configuration could ever reach it. NO NUMBER IS WRITTEN IN THIS FILE.
model ExternalOrganization {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The organization's identity and the searchable company value, one of the people
  /// search's three accepted keys (`README.md` L340, frame 494).
  name         String  @map("name")
  companyValue String? @map("company_value")

  /// The connection state, separately managed from a manage-connections destination
  /// described in terms of approvals with trusted partners
  /// (`README.md` L340, frames 494, 495). A string because the catalogue describes the
  /// destination and never enumerates the states.
  connectionState String? @map("connection_state")

  /// The counterpart workspace, a partner who accepts setting the shared conversation up
  /// in their own workspace (`README.md` L340, frame 496). A reference by identifier
  /// rather than a Prisma relation to `Workspace`: the counterpart is a tenant this
  /// tenant must not be able to traverse into, and a declared relation would put a
  /// traversal path on the tenant root for exactly the reason the commercial edge has
  /// none on the published tier.
  counterpartWorkspaceRef String? @map("counterpart_workspace_ref")

  /// Whether members of this organization may bring their own coworkers — withheld by
  /// post-only and granted after acceptance (`README.md` L340, frames 66, 502).
  mayInviteCoworkers Boolean @default(false) @map("may_invite_coworkers")

  /// Whether channel history is retained by the counterpart on conclusion, which
  /// post-and-invite states they keep a copy of (`README.md` L340, frame 66).
  channelHistoryRetained Boolean @default(false) @map("channel_history_retained")

  /// THE POLICY SETTING. See this model's doc-comment for why a duration is correct here
  /// and nowhere else, and why it carries no default.
  acceptanceWindowDays Int? @map("acceptance_window_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace          Workspace                               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitations        Invitation[]
  conversationScopes ExternalOrganizationConversationScope[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("external_organization")
}

/// ENTITY     Relation table carrying `E-EXTERNAL-ORG`'s per-conversation permission
///            level, which is held "against the organization rather than the person"
///            (`README.md` L340, frames 66, 65). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: access grant, relationship-lifetime.
///
/// The permission is against the ORGANIZATION, which is the whole point of this table:
/// storing it against the person would let two people from one company hold different
/// levels in one conversation, which is not what the surface offers.
model ExternalOrganizationConversationScope {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  organizationId String @map("organization_id")
  conversationId String @map("conversation_id")

  permission ExternalChannelPermission @map("permission")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization ExternalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, conversationId])
  @@index([workspaceId])
  @@index([conversationId])
  @@map("external_organization_conversation_scope")
}

/// ENTITY     `E-PLAN` — a published subscription tier. The ONE catalogue object.
/// TENANCY    CATALOG-GLOBAL. NO TENANT KEY AT ALL, and this is a security boundary
///            rather than a modelling preference: the tier is "read in full on the public
///            pricing page — which is exactly why it may carry neither a secret nor a
///            tenant's state" (`README.md` L321, L341).
/// RETENTION  `S-RETENTION` class: catalogue data, published-lifetime. Carries nothing
///            personal and nothing secret.
///
/// NO RELATIONSHIP RUNS FROM THIS ENTITY TO A WORKSPACE, A CONVERSATION OR ANY OTHER
/// TENANT OBJECT — "in this model or in any area document's diagram"
/// (`README.md` L341). Count the relation fields below: there are none pointing into
/// tenant data, and there is no back-relation from the workspace's commercial-position
/// group either. That group holds the tier as a PLAIN SCALAR reference with no Prisma
/// relation declared, precisely so this model ends up with zero traversal paths, and the
/// options weighed are recorded in `WorkspaceCommercialPosition`'s doc-comment and in
/// `docs/decisions/gap-register.md`.
///
/// THE CAPABILITY MAP IS A PUBLISHED DEFINITION, NEVER A RESOLVED ANSWER. It states which
/// tier includes a capability, and that is all a signed-out visitor's read of it can
/// establish; whether a particular workspace may use that capability is resolved against
/// its commercial-position group and nowhere else. Every gated affordance therefore reads
/// two places, not one (`README.md` L341).
///
/// THE REDEEMABLE PROMOTIONAL CODE IS NOT A FIELD OF THIS ENTITY OR OF ITS OFFER GROUP.
/// Holding a redeemable value in a group read in full by an unauthenticated visitor would
/// publish the redemption credential to everyone who loads that page. Per `S-SECRET`
/// class A the code is a separately secured redemption record stored only as a keyed
/// verifier, and what a redemption PRODUCES is the applied-promotion result in the
/// workspace's tenant-scoped commercial-position group (`README.md` L341).
model Plan {
  id String @id @default(cuid()) @map("id")

  /// Tier name, description, and a positional order taken from the comparison grid's
  /// column order (`README.md` L341, frames 347, 966, 968).
  tierName        String  @unique @map("tier_name")
  tierDescription String? @map("tier_description")
  position        Int     @default(0) @map("position")

  /// The price region as a SLOT rather than a number, because the catalogue evidences it
  /// as a region carrying "a struck-through original beside a discounted price, a footnote
  /// marker, an alternative-period rate, and a contact-for-pricing substitution replacing
  /// the region entirely on the most capable tier" (`README.md` L341, frames 346, 966). A
  /// numeric column could hold none of that.
  priceRegion Json? @map("price_region")

  /// Recommendation marking, observed on exactly one tier (`README.md` L341, frame 966).
  /// The at-most-one rule is a publishing constraint enforced where tiers are published,
  /// not a database one, because "exactly one" over a whole table is not expressible as a
  /// column constraint.
  recommended Boolean @default(false) @map("recommended")

  acquisitionMode PlanAcquisitionMode? @map("acquisition_mode")

  /// The capability map, each value drawn from a seven-kind union of an inclusion mark,
  /// absence, a bare numeric limit, a rate with a unit and period, an unbounded marker,
  /// qualifying text and an add-on label, together with the capability grouping
  /// (`README.md` L341, frames 350, 968, 348). A published definition — see the
  /// doc-comment.
  capabilityMap      Json? @map("capability_map")
  capabilityGrouping Json? @map("capability_grouping")

  /// The support level with an availability window and a first-response commitment, the
  /// add-on availability, the novelty flag and the availability languages
  /// (`README.md` L341, frames 350, 966, 968, 970).
  supportLevel       Json?    @map("support_level")
  addOnAvailability  Json?    @map("add_on_availability")
  isNew              Boolean  @default(false) @map("is_new")
  availableLanguages String[] @map("available_languages")

  /// The post-trial reversion rule, and the cancellation and refund terms
  /// (`README.md` L341, frames 346, 669, 611, 614). Published text, authored for this
  /// product rather than transcribed: `R4` forbids reproducing third-party product copy,
  /// so what a deployment publishes here is its own.
  postTrialReversionRule String? @map("post_trial_reversion_rule")
  cancellationTerms      String? @map("cancellation_terms")
  refundTerms            String? @map("refund_terms")

  /// The per-tier benefit list, observed with six members and presented as what would be
  /// lost rather than what would be gained (`21-states.md` L489, frame 600). Catalogue
  /// scope, like everything else on this record.
  benefitList Json? @map("benefit_list")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotionalOffers PlanPromotionalOffer[]

  @@index([position])
  @@map("plan")
}

/// ENTITY     Field group of `E-PLAN` — the promotional offer. Not a twenty-first entity
///            (`README.md` L321, L341).
/// TENANCY    CATALOG-GLOBAL. No tenant key, readable without a session, "and therefore
///            carrying nothing secret" (`README.md` L341).
/// RETENTION  `S-RETENTION` class: catalogue data, published-lifetime.
///
/// The offer's own countdown is "distinct from the trial's and rendered in the same slot"
/// (`21-states.md` L488, frames 550, 203), which is why the end instant is here as a
/// published property AND the workspace's own applied-promotion end instant is on its
/// commercial-position group. Two facts, two places, one direction.
model PlanPromotionalOffer {
  id     String @id @default(cuid()) @map("id")
  planId String @map("plan_id")

  /// Discount magnitude as a percentage, and the scope as a stated number of initial
  /// months against a target tier (`README.md` L341, frames 550, 346).
  discountPercent    Int  @map("discount_percent")
  initialMonthsScope Int? @map("initial_months_scope")

  /// When the published offer itself stops being offered. An absolute instant, like every
  /// other deadline in this file.
  offerEndsAt DateTime? @map("offer_ends_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_promotional_offer")
}

/// ENTITY     `E-SEARCH-QUERY` — a query and its filters, in TWO CORPUS SCOPES.
/// TENANCY    MIXED-SCOPE, and classified explicitly for
///            `packages/db/src/tenancy.ts` because a blanket predicate would be wrong
///            for one of the two variants: the `WORKSPACE` variant is TENANT-SCOPED and
///            requires both an actor and a workspace; the `PUBLIC_HELP` variant is
///            reached WITHOUT A SESSION and may have neither.
/// RETENTION  `S-RETENTION` class: query history, bounded. See `SearchHistoryEntry` for
///            the viewer-owned recent-search list and its access contract; this record is
///            the resolved query and its filter state.
///
/// -----------------------------------------------------------------------------
/// THE DISCRIMINATOR IS A SECURITY BOUNDARY, NOT A CONVENIENCE
/// -----------------------------------------------------------------------------
///
/// The catalogue says so in those words. The two corpus scopes are "served by two
/// separate read paths, and a PUBLIC QUERY IS NEVER RESOLVED BY THE WORKSPACE-SCOPED
/// PATH — attaching a public unauthenticated query to the reads that carry workspace
/// content is precisely the confusion `S-AUTHZ-READ` exists to prevent"
/// (`README.md` L343). `apps/api/src/search/SearchIndex.ts` exposes the two paths
/// separately and neither can serve the other's scope.
///
/// `workspaceId` AND `userId` ARE BOTH NULLABLE, AND THAT IS VARIANCE RATHER THAN
/// LAXITY. "A public surface has no actor", which is why no edge in the catalogue's
/// diagram reaches one for the help-centre search (`README.md` L411): a build must never
/// require an account to serve it. The workspace-scoped variant requires both ends, and
/// that requiredness is enforced at the point of execution by the service that writes
/// the row — a nullable column cannot express "required when the scope is workspace".
///
/// The public variant additionally carries "no result-type tabs, no facets, no sort, no
/// pagination, no workspace scope and no per-viewer authorization filter, because its
/// corpus is public" (`README.md` L343), so every filter column below is null for it.
model SearchQuery {
  id String @id @default(cuid()) @map("id")

  corpusScope SearchCorpusScope @map("corpus_scope")

  /// Null for the public variant. See this model's doc-comment.
  workspaceId String? @map("workspace_id")
  userId      String? @map("user_id")

  /// The query text, which may embed modifier tokens (`README.md` L343, frame 684).
  /// `S-PII` and `S-SECRET`-adjacent in effect: a stored query can name colleagues and
  /// private conversations in its tokens, so it is never projected to anyone but its
  /// author and never exported.
  queryText String @map("query_text")

  /// The workspace-scoped variant's filters: sender, location, participant, date range,
  /// file type, creator, the only-my-channels and exclude-automations toggles, and the
  /// result-type scope (`README.md` L343, frames 688, 690, 693, 698). Held as structured
  /// values because the filter dimension set DIFFERS PER RESULT TYPE
  /// (`21-states.md` L493, frames 689, 691, 692), so a fixed column per dimension would
  /// be null for most rows and would still not cover the next tab.
  filters Json? @map("filters")

  sortOrder  SearchSortOrder?  @map("sort_order")
  layoutMode SearchLayoutMode? @map("layout_mode")

  /// The per-type counts, rendered even when zero on a tab that stays active and
  /// selectable (`README.md` L343, frame 692), and the public variant's total result
  /// count (frame 944). Both are PROJECTIONS captured with the resolved query rather than
  /// authorities: a count is recomputed inside the authorized query on every read, and a
  /// count stored here is a record of what this resolution returned.
  resultCounts Json? @map("result_counts")

  /// NO PAGE INDEX. The grid layout's pager renders one (`README.md` L343, frame 704) and
  /// it is a RENDERING rather than a placement: offset pagination is prohibited
  /// everywhere and no page index crosses the API boundary, so the pager is driven by the
  /// opaque keyset cursor `packages/shared/src/schemas/pagination.ts` defines and no
  /// integer page is stored.
  resolvedAt DateTime @default(now()) @map("resolved_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
  @@index([userId, resolvedAt])
  @@index([corpusScope])
  @@map("search_query")
}

// =============================================================================
// PER-VIEWER STATE — RELATIONS 2 THROUGH 9 OF THE CATALOGUE'S TEN PLACEMENTS
// =============================================================================
//
// The catalogue calls this "the single most consequential correction in the
// consolidated model", and the reason is a SECURITY reason rather than a
// normalisation preference: stored on the shared object, one person saving something
// saves it for everyone, one person's reminder fires for everyone, one person's
// reading marks it read for all — "and every one of those flags additionally
// discloses that person's behaviour to every other member of the object"
// (`README.md` L357).
//
// The test is one question, and `S-PERUSER` states it: if two people opened this at
// the same moment, could they legitimately see different values? If yes, the field
// belongs on a relation keyed by the pair and never on the object itself
// (`00-product-overview.md` L562). A SINGLE CAPTURED SESSION CAN NEVER DISTINGUISH THE
// TWO PLACEMENTS, because one session shows one viewer's values and both models render
// identically to that viewer — so every field below was placed by the contract rather
// than by a rendering.
//
// Placement 1 is `ConversationMembership`, declared with the conversations. Placement
// 10 is `UserPreference`, which is a placement onto an existing entity rather than a
// join table. The eight between them follow.
//
// EVERY ONE OF THEM CARRIES A COMPOUND UNIQUENESS CONSTRAINT ON ITS KEY PAIR and an
// index supporting the per-viewer read, so one viewer cannot hold two states for one
// object and the read that fetches a viewer's own state never scans another viewer's.

/// ENTITY     Per-viewer relation 2 of 10 — viewer–message state, keyed by viewer +
///            message (`README.md` L364). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, retained while the account and the
///            message both exist. A saved item or reminder whose message the viewer can
///            no longer read is removed or redacted on its next render, per
///            `S-RETENTION`'s loss-of-access rule.
///
/// The canonical placement for read and unread state, the unread boundary,
/// mark-as-unread, the saved-for-later flag and the reminder due time
/// (`README.md` L364, established by the activity area and contributed to by messaging
/// and threads).
model ViewerMessageState {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  messageId   String @map("message_id")

  /// Read state as an absolute instant rather than a boolean, so the record says when.
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  /// A deliberate mark-as-unread, which is a different fact from never having read it
  /// (`03-messaging-and-composer.md` L651, frame 244). The conversation-level boundary
  /// this moves lives on `ConversationMembership`; this column records the act against
  /// the specific message the viewer marked.
  markedUnreadAt DateTime? @map("marked_unread_at") @db.Timestamptz(3)

  /// Whether this message is the viewer's own unread boundary — the labelled rule in the
  /// accent colour the list renders (`README.md` L328, L338, frames 250, 382).
  isUnreadBoundary Boolean @default(false) @map("is_unread_boundary")

  /// The saved-for-later flag with its optional due time, rendered as a marker above the
  /// author line with a tinted highlight while saved
  /// (`README.md` L328, frames 387, 391). An absolute instant for the due time, like
  /// every other deadline here.
  savedAt          DateTime? @map("saved_at") @db.Timestamptz(3)
  savedDueAt       DateTime? @map("saved_due_at") @db.Timestamptz(3)
  savedCompletedAt DateTime? @map("saved_completed_at") @db.Timestamptz(3)

  /// The per-message reply-notification state, switchable off
  /// (`03-messaging-and-composer.md` L651, frame 244).
  replyNotificationsEnabled Boolean @default(true) @map("reply_notifications_enabled")

  /// The per-message notification suppression the invitation-accepted system message
  /// offers. The catalogue is explicit that this is attached to the MESSAGE rather than
  /// the conversation, "so suppression is per message, not only per conversation"
  /// (`README.md` L338, frames 110, 378) — and per `S-PERUSER` it is per viewer as well,
  /// because two readers of one system message may legitimately differ.
  notificationSuppressed Boolean @default(false) @map("notification_suppressed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([workspaceId])
  @@index([userId, savedAt])
  @@index([userId, savedDueAt])
  @@index([messageId])
  @@map("viewer_message_state")
}

/// ENTITY     Per-viewer relation 3 of 10 — viewer–thread state, keyed by viewer +
///            thread (`README.md` L365). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, thread-lifetime.
///
/// The catalogue makes the placement of these two fields explicitly, and states the
/// consequence of getting it wrong: the unread boundary and the reply-notification state
/// "are per participant, not fields of the thread — a point [the threads area] makes
/// explicitly and a build must respect, or one reader marking a thread read will mark it
/// read for everyone" (`README.md` L329, frames 355, 244).
///
/// THE UNREAD REPLY COUNT IS A CURSOR HERE, NOT A COUNT. Same reasoning as the
/// conversation's unread count: a stored number is one number for many viewers and is
/// computed before the reader's authorization is known.
model ViewerThreadState {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  threadId    String @map("thread_id")

  /// Following state — the follow state that acts as a notification source, since a
  /// preference exists for replies to followed threads (`README.md` L329, frame 535).
  following Boolean @default(false) @map("following")

  /// The read cursor within the thread. The unread reply count the summary row renders is
  /// a projection over the replies above this instant, computed inside the authorized
  /// query.
  lastReadReplyAt DateTime? @map("last_read_reply_at") @db.Timestamptz(3)

  /// Where the New divider renders for this viewer (`README.md` L329, frame 355). A
  /// separate fact from the read cursor, for the same reason it is on the conversation
  /// membership: a deliberate mark-as-unread moves the divider without moving what was
  /// read.
  unreadBoundaryAt DateTime? @map("unread_boundary_at") @db.Timestamptz(3)

  /// The per-thread reply-notification state, switchable off (`README.md` L329,
  /// frame 389).
  replyNotificationsEnabled Boolean @default(true) @map("reply_notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([workspaceId])
  @@index([userId, following])
  @@index([threadId])
  @@map("viewer_thread_state")
}

/// ENTITY     Per-viewer relation 4 of 10 — viewer–canvas state, keyed by viewer +
///            canvas (`README.md` L366). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, canvas-lifetime.
model ViewerCanvasState {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  canvasId    String @map("canvas_id")

  /// The last-viewed timestamp, the star and the saved-for-later flag — the three fields
  /// the relation table moves off the canvas (`README.md` L366, frames 330, 150).
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz(3)
  starred      Boolean   @default(false) @map("starred")
  savedAt      DateTime? @map("saved_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvas    Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasId])
  @@index([workspaceId])
  @@index([userId, starred])
  @@index([canvasId])
  @@map("viewer_canvas_state")
}

/// ENTITY     Per-viewer relation 5 of 10 — viewer–list state, keyed by viewer + list
///            (`README.md` L367). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, list-lifetime.
model ViewerListState {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  listId      String @map("list_id")

  /// The star, the last-opened timestamp and the per-record notification subscription —
  /// the three fields the relation table moves off the list (`README.md` L367,
  /// frames 408, 420).
  starred      Boolean   @default(false) @map("starred")
  lastOpenedAt DateTime? @map("last_opened_at") @db.Timestamptz(3)

  /// The subscription is per RECORD within the list, so it is a set of record identifiers
  /// on this viewer's own row rather than a column: a subscription to one record is not a
  /// property of the list, and a table per subscription would key the same pair twice.
  subscribedRecordIds String[] @map("subscribed_record_ids")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      ChannelList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([workspaceId])
  @@index([userId, starred])
  @@index([listId])
  @@map("viewer_list_state")
}

/// ENTITY     Per-viewer relation 6 of 10 — viewer–app state, keyed by viewer + app
///            (`README.md` L368). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, installation-lifetime.
///
/// UNREAD COUNT ONLY. The relation table is explicit about the boundary — "installed
/// state remains per workspace" (`README.md` L368) — and installed state therefore lives
/// on `AppInstallation`, the app's per-workspace field group. Putting installed state
/// here would make one person's installation invisible to their colleagues; putting the
/// unread count on the installation would make one person's reading clear everyone's
/// badge.
///
/// The relation is keyed to the INSTALLATION rather than to the catalogue app, because a
/// viewer's unread count is only meaningful for an app their workspace has installed, and
/// keying it to the installation makes the tenant boundary structural.
model ViewerAppState {
  id             String @id @default(cuid()) @map("id")
  workspaceId    String @map("workspace_id")
  userId         String @map("user_id")
  installationId String @map("installation_id")

  /// The read cursor for the app's own messages, from which the unread count on the
  /// sidebar app row is projected (`00-product-overview.md` L823, frame 300). A cursor
  /// rather than a counter, for the same reason as everywhere else in this file.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation AppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([workspaceId])
  @@index([installationId])
  @@map("viewer_app_state")
}

/// ENTITY     Per-viewer relation 7 of 10 — viewer–file state, keyed by viewer + file
///            (`README.md` L369). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, file-lifetime.
///
/// ONE COLUMN CARRIES THE WHOLE PLACEMENT, and the catalogue says why it matters: the
/// viewed-at timestamp "is what drives the viewed-today and viewed-yesterday grouping"
/// (`README.md` L369, frame 488). Stored on the file, that grouping would be the same for
/// everyone and would additionally disclose when each colleague last opened a document.
model ViewerFileState {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  fileId      String @map("file_id")

  viewedAt DateTime @map("viewed_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([userId, fileId])
  @@index([workspaceId])
  @@index([userId, viewedAt(sort: Desc)])
  @@index([fileId])
  @@map("viewer_file_state")
}

/// ENTITY     Per-viewer relation 8 of 10 — viewer–huddle state, keyed by viewer +
///            huddle (`README.md` L370). Not an entity.
/// TENANCY    TENANT-SCOPED.
/// RETENTION  `S-RETENTION` class: per-viewer state, session-lifetime. Per `S-CONSENT`,
///            a sample taken to drive a level meter or run a diagnostic is used
///            transiently and discarded — what is retained here is the RESULT a
///            participant's client reported, never the capture.
///
/// THESE ROWS ARE THE PARTICIPANT LIST. Microphone state, camera state, the camera
/// background and the connection diagnostics are per participant rather than per session
/// (`README.md` L333, L370, frames 269, 270, 271), so a session's participant list is a
/// projection over these rows with a bound — a facepile of a live session inherits its
/// authorization from the same rows that decide who is in it.
model ViewerHuddleState {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  huddleId    String @map("huddle_id")

  /// The invited-not-yet-joined state, rendered as a badge on that participant's tile
  /// (`README.md` L333, frames 268, 407). Two absolute instants rather than a status:
  /// invited and joined are both moments, and a null `joinedAt` with a non-null
  /// `invitedAt` is exactly the badged state.
  invitedAt DateTime? @map("invited_at") @db.Timestamptz(3)
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(3)

  /// Per-participant device state: the microphone rendered as a crossed badge on that
  /// participant's tile, the camera rendered as the toggle's crossed treatment, and the
  /// camera background (`README.md` L333, frames 269, 270, 293).
  microphoneEnabled    Boolean              @default(true) @map("microphone_enabled")
  cameraEnabled        Boolean              @default(false) @map("camera_enabled")
  cameraBackgroundMode CameraBackgroundMode @default(NONE) @map("camera_background_mode")

  /// The camera background image when the mode is `IMAGE`, as a stored-file reference by
  /// identifier. Not a Prisma relation, because a participant's chosen background is
  /// their own and a relation here would add a traversal from every file row into every
  /// session a person joined.
  cameraBackgroundFileRef String? @map("camera_background_file_ref")

  /// The per-participant diagnostics this client reported: the overall verdict, the three
  /// group ratings and the four network metrics each with a rating and a measured value
  /// (`README.md` L333, frames 271, 272).
  diagnostics Json? @map("diagnostics")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  huddle    Huddle    @relation(fields: [huddleId], references: [id], onDelete: Cascade)

  @@unique([userId, huddleId])
  @@index([workspaceId])
  @@index([huddleId, joinedAt])
  @@map("viewer_huddle_state")
}

/// ENTITY     Per-viewer relation 9 of 10 — search history, keyed by viewer
///            (`README.md` L371). Not an entity.
/// TENANCY    VIEWER-OWNED, and tenant-keyed. Already viewer-owned by construction, so
///            the placement was never in question.
/// RETENTION  `S-RETENTION` class: query history, BOUNDED — retained for the window a
///            deployment states in `packages/shared/src/config/env.ts` and pruned by a
///            running process, with a deletion path the person can invoke themselves.
///            The bound is stated here because `S-RETENTION` requires a retention class
///            declared where the data is modelled, and it is a configured value rather
///            than a number written in this file.
///
/// -----------------------------------------------------------------------------
/// THE ACCESS CONTRACT, WHICH IS WHAT THE CATALOGUE ADDS BEYOND THE PLACEMENT
/// -----------------------------------------------------------------------------
///
/// `S-SECRET`-ADJACENT, and the catalogue explains why in one clause: a stored query
/// "can name colleagues and private conversations in its tokens" (`README.md` L371).
/// Four properties therefore bind these rows, and every one of them is a read-path
/// obligation rather than a column:
///
///   - READABLE ONLY BY THEIR AUTHOR. Not by an administrator, not by a support surface.
///   - NEVER PROJECTED TO ANYONE ELSE. Not into a count, not into a suggestion index, not
///     into an autocomplete result — which are three of the eight projections `R1`
///     enumerates.
///   - NEVER EXPORTED. `S-EXPORT` scopes an export to the exporter's authorized set, and
///     no exporter's authorized set includes another person's query history.
///   - A STATED RETENTION BOUND AND A DELETION PATH, above.
model SearchHistoryEntry {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  /// The recent-search entry as the person typed it, which may embed modifier tokens, and
  /// which is retained alongside conversation and person entries in the same list
  /// (`README.md` L343, frame 684). The kind distinguishes a typed query from a picked
  /// conversation or person, because the list renders all three.
  entryKind String  @map("entry_kind")
  queryText String? @map("query_text")

  /// The picked target, when the entry is one, held as an opaque identifier rather than as
  /// a relation: the entry is a record of what this person did, and a relation would make
  /// every conversation and account row traversable into other people's histories.
  targetRef String? @map("target_ref")

  /// When this entry was last used, which is what orders the recent list and what the
  /// retention sweep compares against.
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryKind, queryText, targetRef])
  @@index([workspaceId])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("search_history_entry")
}

// =============================================================================
// CREDENTIALS — FOUR LIFECYCLE-BEARING TABLES, PLUS THE CLASS-B CAPABILITY LINK
// =============================================================================
//
// `S-SECRET` defines THREE CLASSES WITH THREE LIFECYCLES, and states plainly that
// applying a single rule to all of them "is itself a defect"
// (`00-product-overview.md` L540). No secret of any class is a field of any entity a
// read path returns; the only two things a returned entity may hold in their place are
// a class-B LOOKUP SELECTOR, which is not the secret, and a class-C OPAQUE RECORD
// IDENTIFIER, which is not the secret either.
//
// THREE PROPERTIES BIND EVERY ROW IN THIS SECTION and are stated once here so that no
// reader treats any of them as belonging to one table only. THE RAW VALUE IS NEVER
// PERSISTED — only a verifier of it, and the raw value exists once, at issuance or
// entry, on its way to or from the principal. NO ARTEFACT IS EVER PLACED IN A URL OR
// DISPLAYED IN FULL, with the deliberate class-B exception noted where it applies. NONE
// OF THEM IS EVER RETURNED BY A READ PATH OR INCLUDED IN AN EXPORT. Attempts against
// every one of them are rate-limited and bounded server-side.
//
// The catalogue names four of these artefacts on the account entity — a password, a
// six-character expiring one-time code, an active browser session and a
// device-enrolment code — "only so that a build reading the consolidated model cannot
// mistake their absence for an oversight" (`README.md` L326). They are named there and
// stored here.
//
// THEY GET FOUR TABLES RATHER THAN FOUR COLUMNS BECAUSE THEY HAVE FOUR LIFECYCLES. A
// password is a standing credential that must survive for years and be re-hashed as
// guidance moves. A one-time code must die on first use. An enrolment code is scoped to
// a single device and revoked in bulk when the grant behind it is withdrawn. A session
// must be revocable individually and collectively, and invalidated when the password
// changes. Those are four different sets of columns and four different sets of writes,
// and a column on the account can only have one of each.

/// ENTITY     Credential record — `S-SECRET` CLASS A, the password verifier. Not an
///            entity, and deliberately not a column on the account.
/// TENANCY    SUBJECT-KEYED rather than an ordinary tenant row: it is reached
///            only through the account it authenticates, and
///            `packages/db/src/tenancy.ts` classifies it as subject-keyed so no read
///            path can enumerate it by workspace. It carries no `workspaceId` for that
///            reason — a tenant predicate on a credential table would imply a read that
///            lists credentials, and there is none.
/// RETENTION  `S-RETENTION` class: credential material, account-lifetime. Destroyed with
///            the account. Never logged, never exported, never returned.
///
/// ONE CURRENT ROW PER ACCOUNT — `userId` is unique. A password is a standing credential
/// rather than an issued artefact, so it is REPLACED rather than expired: it has no
/// expiry column, and the replacement invalidates every session for that account.
///
/// -----------------------------------------------------------------------------
/// THE PARAMETERS ARE STORED BESIDE THE HASH, AND THAT IS WHAT KEEPS AN UPGRADE OPEN
/// -----------------------------------------------------------------------------
///
/// Hashing guidance changes. A verifier written under old parameters is still correct but
/// no longer current, so storing the algorithm, the memory cost, the time cost and the
/// parallelism WITH each hash means a successful authentication can detect that its row is
/// behind, compute a fresh verifier from the value the person just presented, and replace
/// the row — the documented RE-HASH-AT-NEXT-SUCCESSFUL-AUTHENTICATION path. Without the
/// parameters on the row there is nothing to compare against, and the only remaining
/// upgrade would be to invalidate everyone's password at once.
///
/// THE PARAMETER VALUES ARE NOT IN THIS FILE. They are compile-time invariants —
/// `ARGON2ID_ALGORITHM`, `ARGON2ID_MEMORY_COST_KIB`, `ARGON2ID_TIME_COST` and
/// `ARGON2ID_PARALLELISM` in `packages/shared/src/config/constants.ts` — deliberately
/// NOT environment-overridable, because they are a security floor rather than a setting.
/// These columns record what a GIVEN hash was produced with, which is a different fact
/// from what the current floor is, and the difference is precisely what the upgrade path
/// compares.
///
/// THE STRENGTH RATING IS NOT HERE AND IS NOWHERE. It is computed transiently in the
/// client, never transmitted and never stored (`00-product-overview.md` L542,
/// `01-onboarding-and-auth.md` L779). The reuse constraint the surfaces render is
/// evaluated against verifiers rather than against stored values.
model PasswordVerifier {
  id     String @id @default(cuid()) @map("id")
  userId String @unique @map("user_id")

  /// The one-way verifier. Never plaintext, and never a value this product can recover.
  verifier String @map("verifier")

  /// What this particular verifier was produced with. See the doc-comment.
  algorithm     String @map("algorithm")
  memoryCostKib Int    @map("memory_cost_kib")
  timeCost      Int    @map("time_cost")
  parallelism   Int    @map("parallelism")

  /// When this verifier was written, which is what the reuse constraint and the audit
  /// trail both need, and when it was last used successfully, which is when the re-hash
  /// check runs.
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_verifier")
}

/// ENTITY     Credential record — `S-SECRET` CLASS A, the one-time code. Not an entity.
/// TENANCY    SUBJECT-KEYED — the address it was issued to, and the account when one
///            exists. Classified explicitly for `packages/db/src/tenancy.ts` for the
///            same reason as the password verifier, and additionally because a code is
///            issued to an ADDRESS BEFORE AN ACCOUNT EXISTS: sign-up verification
///            precedes the account, so `userId` is nullable and the address is the key
///            that resolves the row.
/// RETENTION  `S-RETENTION` class: credential material, SHORT-LIVED. Pruned by a running
///            process once consumed or expired — `S-RETENTION` requires the stated period
///            to be enforced by a process rather than by the absence of a surface that
///            would show the data.
///
/// SINGLE-USE, TIME-BOUNDED, STORED ONLY AS A VERIFIER. The surfaces state that the code
/// is six characters long, that it expires shortly, and that an invalid one is rejected
/// (`01-onboarding-and-auth.md` L779, frames 4, 5, 728, 729, 730). Per `S-SECRET` class A
/// it is "held as a single-use, time-bounded, per-address verifier on its own short-lived
/// record", invalidated on use and on issuance of a replacement, and NEVER PLACED IN A
/// URL — which is what distinguishes it from the class-B link below.
///
/// The verifier is a KEYED DIGEST computed with a server-held key that is not stored
/// beside the digest, and compared in constant time
/// (`00-product-overview.md` L542). The key lives in the application's secret
/// configuration, never in this table.
///
/// THREE COLUMNS MAKE THE LIFECYCLE ENFORCEABLE RATHER THAN ASPIRATIONAL: an absolute
/// `expiresAt` resolved at issuance, a `consumedAt` instant that makes reuse detectable,
/// and an `attemptCount` bound that makes brute force detectable. `R3` requires the
/// mechanism to exist even where a value is uncertain; the bound's VALUE is configured in
/// `packages/shared/src/config/env.ts` and no number is written here.
model OneTimeCode {
  id String @id @default(cuid()) @map("id")

  /// The address the code was issued to. `S-PII` personal contact data, and the key that
  /// resolves the row before an account exists.
  email String @map("email")

  /// The account, once there is one. Nullable — see the tenancy note.
  userId String? @map("user_id")

  /// What the code is for, so a verification code cannot be replayed as a sign-in code.
  /// The narrowest object it needs to reach, per class A's scoping rule.
  purpose String @map("purpose")

  /// The keyed digest. Never the code.
  verifier String @map("verifier")

  /// The lifecycle. `expiresAt` is resolved AT ISSUANCE from a configured default and is
  /// an absolute instant; a duration here would be a second copy of configuration that a
  /// clock would make wrong.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  attemptCount  Int       @default(0) @map("attempt_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId])
  @@index([expiresAt])
  @@map("one_time_code")
}

/// ENTITY     Credential record — `S-SECRET` CLASS A, the device-enrolment code. Not an
///            entity, and DELIBERATELY NOT FOLDED INTO `OneTimeCode`.
/// TENANCY    SUBJECT-KEYED — the account enrolling the device.
/// RETENTION  `S-RETENTION` class: credential material, SHORT-LIVED. Pruned by the same
///            running process.
///
/// A SEPARATE RECORD WITH ITS OWN LIFECYCLE, because the contract lists it as a distinct
/// artefact from the one-time code (`00-product-overview.md` L542, `README.md` L326,
/// frame 714). Two differences make the separation real rather than tidy: an enrolment
/// code is scoped to a DEVICE and always has an account behind it, where a verification
/// code is scoped to an ADDRESS and may precede the account; and an enrolment code is
/// "invalidated when a replacement is issued OR THE ENROLLING SESSION ENDS"
/// (`01-onboarding-and-auth.md` L779), which is a trigger the one-time code does not
/// have and which is why `sessionId` is a column here.
///
/// It renders as a scannable square for signing the same address in on another device.
/// The value behind that rendering is never stored recoverably and is never displayed
/// again once issued.
model DeviceEnrolmentCode {
  id     String @id @default(cuid()) @map("id")
  userId String @map("user_id")

  /// The enrolling session. When it ends, this code is invalidated — which is the trigger
  /// that distinguishes this record from a one-time code.
  sessionId String? @map("session_id")

  /// A label for the device being enrolled, so a person can recognise what they
  /// authorised. Not an identifier the product trusts for anything.
  deviceLabel String? @map("device_label")

  /// The keyed digest. Never the code.
  verifier String @map("verifier")

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  attemptCount  Int       @default(0) @map("attempt_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("device_enrolment_code")
}

/// ENTITY     Credential record — `S-SECRET` CLASS A, the session. Not an entity.
/// TENANCY    TENANT-SCOPED as well as subject-keyed, because the corpus renders "an
///            active browser session PER WORKSPACE" (`01-onboarding-and-auth.md` L779,
///            frames 717, 719). The tenant key is carried so a sign-out-everywhere within
///            one workspace is expressible without reaching another.
/// RETENTION  `S-RETENTION` class: credential material, bounded by the two instants below.
///            Pruned by a running process once expired or revoked.
///
/// A SESSION IS A ROW, NOT A TOKEN. It is referenced by an HTTP-only, same-site cookie
/// carrying an OPAQUE IDENTIFIER rather than a claim, so revocation is a write to this
/// table and takes effect on the next request. That is the whole reason the model holds
/// sessions at all: a self-contained token in the client cannot be revoked, and a build
/// that stores authorization state where the client keeps it has no way to end a session
/// it has decided to end. Because the session is a row and the cookie is opaque, the
/// synchronizer-token pattern is available for mutating requests, which is what the
/// request-forgery protection depends on.
///
/// TWO ABSOLUTE INSTANTS, NOT ONE, AND NOT A DURATION. `S-SECRET` class A requires "an
/// idle and an absolute lifetime" (`00-product-overview.md` L542), and they answer
/// different questions: the idle bound expires a session nobody is using, the absolute
/// bound expires a session somebody is using continuously. Both are resolved from
/// configured defaults in `packages/shared/src/config/env.ts` —
/// `SESSION_IDLE_TIMEOUT_MINUTES` and `SESSION_ABSOLUTE_TIMEOUT_HOURS` — and NO NUMBER IS
/// WRITTEN IN THIS FILE. The idle bound is re-resolved on each request; the absolute bound
/// never moves once set.
///
/// NO BEARER MATERIAL IS STORED IN A RECOVERABLE FORM AND NONE IS EVER RETURNED BY A READ
/// PATH. The already-signed-in list "projects only the workspace identity, never the
/// credential" (`01-onboarding-and-auth.md` L779). Revocation is individual, collective
/// for one account, automatic on credential change, and available as a
/// sign-out-everywhere operation that invalidates the server-side rows rather than only
/// clearing the client.
model Session {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  /// The non-secret lookup selector the cookie carries. Unique and resolvable, and NOT
  /// the credential: the secret half is verified against `verifier` below, so a reader of
  /// this table holds nothing they could present.
  selector String @unique @map("selector")

  /// The keyed verifier of the cookie's secret half, compared in constant time.
  verifier String @map("verifier")

  /// Context enough for a person to recognise and end a session they do not recognise.
  /// Deliberately minimal: `S-PII` and `S-TELEMETRY` both minimise device- and
  /// network-identifying detail, so this is a coarse label rather than a fingerprint.
  clientLabel String? @map("client_label")

  /// The two bounds and the revocation. See the doc-comment.
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// When this session was last seen, which is what the idle bound is re-resolved from.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  enrolmentCodes DeviceEnrolmentCode[]

  @@index([workspaceId])
  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("app_session")
}

/// ENTITY     Credential record — `S-SECRET` CLASS B, a reusable capability link. Not an
///            entity, and deliberately not a field of the invitation it grants.
/// TENANCY    TENANT-SCOPED, because a link grants a capability over a tenant object and
///            bulk revocation is a tenant operation.
/// RETENTION  `S-RETENTION` class: credential material, bounded by `expiresAt` and
///            removed on revocation. The value is additionally stripped from every
///            server, proxy, analytics and error log rather than merely not logged
///            deliberately.
///
/// -----------------------------------------------------------------------------
/// CLASS B IS NOT CLASS A, AND THE DIFFERENCE IS WHAT THIS TABLE'S SHAPE RECORDS
/// -----------------------------------------------------------------------------
///
/// The corpus shows this class being copied deliberately, shared, listed and revoked in
/// bulk, so "class A's never-in-a-URL and single-use rules DO NOT APPLY to it — a link
/// that may not travel in a URL cannot be a link, and a link an inviter shares with a
/// team cannot be single-use unless the product's own copy says so"
/// (`00-product-overview.md` L544, frames 46, 267, 599, 656).
///
/// Its own contract instead, and every clause of it is visible below. The value is
/// generated as a high-entropy opaque token SPLIT INTO A NON-SECRET LOOKUP SELECTOR AND A
/// SECRET PART, and only a KEYED VERIFIER of the secret part is stored — so the store
/// still holds nothing a reader could redeem. It is scoped to exactly one capability and
/// one object. It carries an expiry RESOLVED AT ISSUANCE and ENFORCED SERVER-SIDE. It is
/// REVOCABLE INDIVIDUALLY AND IN BULK, which is the behaviour the console's
/// deactivate-all action already exposes — `revokedAt` per row for the first, and a
/// predicate over `workspaceId` or `invitationId` for the second.
///
/// REDEMPTION IS AN AUTHORIZATION EVENT, NOT A LOOKUP: the selector resolves the row, the
/// verifier is compared in constant time, the expiry and revocation state are re-checked,
/// and the capability is granted per `S-AUTHZ-OP` — NEVER INHERITED FROM WHOEVER ISSUED
/// IT.
///
/// NO SURFACE RENDERS THE VALUE IN FULL. A rendering is abbreviated with a copy affordance
/// that puts the whole value on the clipboard without displaying it, which is a
/// DELIBERATE DEPARTURE from the one capture that renders a code whole
/// (`00-product-overview.md` L544, frame 656). The departure is recorded rather than
/// hidden, with the observation left intact.
model CapabilityLink {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The capability this link grants and the object it grants it over. Scoped to exactly
  /// one of each, per class B.
  capability String @map("capability")

  invitationId   String? @map("invitation_id")
  conversationId String? @map("conversation_id")

  /// The non-secret half. Unique and resolvable, and useless on its own.
  selector String @unique @map("selector")

  /// The keyed verifier of the secret half. Never the token.
  verifier String @map("verifier")

  /// The server-enforced expiry, resolved at issuance. Absolute, and immutable in both
  /// directions: a change to the configured default governs links issued afterwards and
  /// never rewrites this one. See `Invitation`'s doc-comment for the two contradictory
  /// lifetimes the catalogue states and why no number is written in this file.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Individual revocation. Bulk revocation is a predicate over the tenant or the
  /// invitation, so it needs no second column.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// How many times it has been redeemed, and when last. A reusable link is not
  /// single-use, so a count is the honest record; a bound on it is a configured value and
  /// is not written here.
  redemptionCount Int       @default(0) @map("redemption_count")
  lastRedeemedAt  DateTime? @map("last_redeemed_at") @db.Timestamptz(3)

  issuedByUserId String?  @map("issued_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitation   Invitation?   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  issuedBy     User?         @relation("CapabilityLinkIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, revokedAt])
  @@index([invitationId])
  @@index([expiresAt])
  @@map("capability_link")
}

// =============================================================================
// THE MARKETING POPULATION — A DIFFERENT POPULATION, NEVER MERGED
// =============================================================================
//
// `S-MARKETING` and `S-PII` agree on this and state it from two directions: "an address
// collected from a public form is never merged into a workspace member's account record
// and never becomes a route into the product"
// (`00-product-overview.md` L584), and "no observed public submission creates an account,
// so a lead and a workspace member are different populations and are never merged into one
// record" (`README.md` L351).
//
// The catalogue places the marketing address on the PUBLIC FORM SUBMISSION page-content
// structure, which is deliberately NOT in the entity table at all: "none of them is a
// product entity, so none of them carries an `E-*` identifier", because "a read that
// serves a marketing page must never be a read of product data, and giving published
// content an entity identifier is the first step towards exactly that"
// (`README.md` L347).
//
// FIVE FURTHER PAGE-CONTENT STRUCTURES ARE DELIBERATELY NOT DECLARED HERE — the content
// item, the job posting, the service health record, the store product and the shopping
// basket. They belong to a deferred phase and are outside this run's scope. The placement
// rule is recorded so it is not lost when they arrive: each of them carries NO `E-*`
// IDENTIFIER AND NO TENANT KEY, exactly like the submission below, and the basket's
// per-viewer state is `S-PERUSER` state on the viewer and never a field on the product.
// The basket additionally has NO ACTOR, because it is reached without a session.

/// ENTITY     PAGE-CONTENT STRUCTURE — the public form submission. NO `E-*` IDENTIFIER
///            AND NO TENANT KEY, both deliberately. Not one of the twenty entities, and
///            not a field group of one.
/// TENANCY    PUBLIC-SUBMISSION — neither tenant-scoped nor catalogue-global in the
///            entity sense. Reached without a session and belonging to no
///            workspace. `packages/db/src/tenancy.ts` classifies it explicitly so the
///            isolation predicate does not attempt to bind a tenant key that must not
///            exist. A tenant column here would make a marketing read a tenant read.
/// RETENTION  `S-RETENTION` class: personal data, PURPOSE-BOUNDED. Every field is `S-PII`
///            and each carries the retention period the consent's own wording named, with
///            a deletion path that reaches primary storage, backups within the stated
///            window and every derived store. `S-PII` MINIMISATION applies at the column
///            level: each field below exists because a form the catalogue evidences
///            collects it for a stated purpose, and a field with no stated purpose is not
///            collected. `S-PII` REDACTION applies to all of them: no value here reaches a
///            log, an error report, an analytics event, a URL or a cache key, and where one
///            must be referenced outside it is referenced by this row's opaque identifier.
///
/// The values three public lead forms collect, plus the newsletter subscriber, which "is
/// this same population rather than a workspace account" (`README.md` L351, frames 788,
/// 810, 981, 983, 875).
///
/// A CONFIRMATION SURFACE INTERPOLATES SUBMITTED VALUES BACK INTO RENDERED COPY
/// (`00-product-overview.md` L558, frame 985), which carries a second obligation: a
/// personal value rendered back to a page is stored content in the sense of `S-CONTENT`
/// and is escaped on output like any other.
model PublicFormSubmission {
  id String @id @default(cuid()) @map("id")

  /// Which form this came from, since "a source surface [is] implied by which form was
  /// submitted" (`README.md` L351, frames 788, 810). Stored explicitly rather than
  /// inferred, because the purpose the person consented to is the one the form named and a
  /// row has to be able to state it.
  sourceSurface String @map("source_surface")

  /// The work email address, which is the only field every form collects and the key a
  /// suppression is matched against.
  email String @map("email")

  givenName        String? @map("given_name")
  familyName       String? @map("family_name")
  organisationName String? @map("organisation_name")
  organisationSize String? @map("organisation_size")
  department       String? @map("department")
  jobRole          String? @map("job_role")

  /// Telephone number with a format-masked placeholder on the form; the mask is a
  /// rendering and the stored value is what was typed (`README.md` L351, frame 983).
  telephone String? @map("telephone")

  /// A pre-filled state-or-province and territory (`README.md` L351, frame 981).
  /// PRE-FILLED IS A RENDERING, and this column records what the person committed.
  stateOrProvince String? @map("state_or_province")
  territory       String? @map("territory")

  statedNeed      String? @map("stated_need")
  freeTextMessage String? @map("free_text_message")

  /// The newsletter subscribed state, "whose succeeded rendering replaces the field's own
  /// affordance with a confirmation line" (`README.md` L351, frame 876). A DERIVED VIEW of
  /// the consent rows below rather than an independent flag would be preferable, and this
  /// column is deliberately not that: it records whether the SUBSCRIPTION mechanism
  /// currently holds, which a suppression can end without a consent row being deleted. The
  /// consent history stays the evidence; this is the operational answer.
  subscribed Boolean @default(false) @map("subscribed")

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  consentRecords MarketingConsentRecord[]

  @@index([email])
  @@index([sourceSurface, submittedAt])
  @@map("public_form_submission")
}

/// ENTITY     Consent record for `S-MARKETING`. Not an entity, not a field group, and
///            EMPHATICALLY NOT A BOOLEAN COLUMN ANYWHERE.
/// TENANCY    PUBLIC-SUBMISSION scope, like its subject. No tenant key.
/// RETENTION  `S-RETENTION` class: consent evidence, retained for the whole retention
///            period the wording named and for as long as the purpose is relied on.
///            Deleting a grant would delete the proof that the purpose was ever permitted.
///
/// -----------------------------------------------------------------------------
/// CONSENT IS A RECORD OF AN ACT, WHICH IS WHY IT IS A TABLE
/// -----------------------------------------------------------------------------
///
/// A boolean records a state and loses the act, and the act is the only thing that makes
/// the state defensible later. `S-MARKETING` requires "the act, its timestamp, the exact
/// wording that was presented, the surface it was presented on, and the version of the
/// policy it referenced" — all stored together, "so that what the person agreed to can be
/// reproduced later rather than asserted" (`00-product-overview.md` L584). None of that
/// fits in a column, and every one of those five is a column below.
///
/// A PRE-TICKED CONTROL IS A RENDERING AND NEVER A CONSENT. The corpus renders the
/// marketing checkbox already ticked on one surface and unticked on its sibling, and shows
/// nothing at all about what is submitted or stored
/// (`01-onboarding-and-auth.md` L779, frames 6, 746, 748). A tick therefore produces a row
/// only from a DISTINCT AFFIRMATIVE ACT; a default state produces no row, and THE ABSENCE
/// OF A ROW IS THE ABSENCE OF CONSENT. That is a property of the shape rather than a rule
/// someone has to remember: there is nowhere here for a rendering to be recorded.
///
/// A WITHDRAWAL IS A ROW OF THE SAME FIDELITY AS THE GRANT, not a deletion of one and not a
/// flag flipped on it — see `MarketingConsentAct`. Withdrawal is a first-class operation
/// available WITHOUT A SESSION where the messages themselves are, which is another reason
/// this population has no account behind it.
///
/// PURPOSE LIMITATION: the consent covers the purposes named in that wording and no
/// others, and a new purpose needs a new act rather than an inference from the old one.
/// `purpose` is therefore a column and the row is scoped by it.
model MarketingConsentRecord {
  id String @id @default(cuid()) @map("id")

  /// THE SUBJECT IS THE PUBLIC SUBMISSION, NEVER AN ACCOUNT. The catalogue places the
  /// marketing address on that structure and not on the account entity
  /// (`README.md` L326, L351). Nullable so that a withdrawal arriving without a session,
  /// through a link in a message, can be recorded against the address alone when the
  /// original submission cannot be resolved — a withdrawal must be honoured whether or not
  /// the grant can be found.
  submissionId String? @map("submission_id")

  /// The address the act concerned, stored on the row itself so a withdrawal is
  /// self-describing and so a suppression can be matched without resolving the subject.
  email String @map("email")

  act MarketingConsentAct @map("act")

  /// The purpose the wording named. See the doc-comment: a new purpose needs a new act.
  purpose String @map("purpose")

  /// THE EXACT WORDING THAT WAS PRESENTED. Stored verbatim as this product authored it —
  /// `packages/shared/src/copy/en.ts` is where the wording lives and `R4` forbids
  /// transcribing any third party's — so that what the person agreed to can be reproduced
  /// rather than asserted.
  wordingPresented String @map("wording_presented")

  /// The surface it was presented on, and the version of the policy it referenced.
  surfacePresentedOn String @map("surface_presented_on")
  policyVersion      String @map("policy_version")

  /// When the act happened. Absolute, like every other instant in this file.
  actedAt DateTime @default(now()) @map("acted_at") @db.Timestamptz(3)

  submission PublicFormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([email, purpose, actedAt])
  @@index([submissionId])
  @@map("marketing_consent_record")
}

/// ENTITY     Suppression record for `S-MARKETING`. Not an entity.
/// TENANCY    PUBLIC-SUBMISSION scope. No tenant key.
/// RETENTION  `S-RETENTION` class: suppression evidence, RETAINED INDEFINITELY BY DESIGN.
///            This is the one class in the model whose retention is deliberately not
///            bounded, and the reason is below.
///
/// -----------------------------------------------------------------------------
/// A SUPPRESSION OUTLIVES THE DELETION OF THE CONTACT
/// -----------------------------------------------------------------------------
///
/// `S-MARKETING` states the requirement and the failure it prevents in one clause: "a
/// suppression record outlives the deletion of the contact, so that erasing an address
/// cannot silently make it contactable again" (`00-product-overview.md` L584).
///
/// THAT IS WHY THIS TABLE HAS NO FOREIGN KEY. It carries the address as its own value and
/// references nothing, so deleting the submission, the consent rows, and every other trace
/// of the person leaves this row standing. A relation with a cascade would delete it
/// exactly when it is most needed; a relation with `SetNull` would leave a row that no
/// longer knows what it suppresses. Neither is acceptable, so there is no relation at all —
/// and this is a case where the ABSENCE of a foreign key is the requirement rather than an
/// oversight. A later agent must not "tidy" it into a relation.
///
/// The address is `S-PII` personal contact data and is still governed by redaction: it
/// never reaches a log, an analytics event, a URL or a cache key. It is held here, and only
/// here, for the sole purpose of refusing to contact it.
model MarketingSuppression {
  id String @id @default(cuid()) @map("id")

  /// The suppressed address. Unique per purpose, so one row answers one question and a
  /// second suppression of the same address for the same purpose is not a second row.
  email   String @map("email")
  purpose String @map("purpose")

  /// Why it was suppressed — a withdrawal, a bounce, a complaint. A string because the
  /// catalogue evidences the requirement and not a closed set of reasons, and because
  /// refusing to contact an address must never depend on the reason parsing.
  reason String @map("reason")

  suppressedAt DateTime @default(now()) @map("suppressed_at") @db.Timestamptz(3)

  @@unique([email, purpose])
  @@index([email])
  @@map("marketing_suppression")
}

// =============================================================================
// INFRASTRUCTURE — THE AUDIT LOG AND THE IDEMPOTENCY-KEY STORE
// =============================================================================

/// ENTITY     Infrastructure — the audit log. Not an entity, not a field group.
/// TENANCY    TENANT-SCOPED WITH A NULLABLE TENANT KEY, and this is the ONE model where
///            that combination is correct. It is classified explicitly for
///            `packages/db/src/tenancy.ts` as AUDIT scope: the log is tenant-isolated for
///            every event that has a tenant, and a PRE-WORKSPACE event — a rejected
///            sign-in, an invitation redemption that failed before a workspace was
///            resolved — has none, and refusing to record it would defeat the table's
///            whole purpose. A blanket predicate would silently drop exactly the attempts
///            worth reviewing.
/// RETENTION  `S-RETENTION` class: audit record, retained for the audit window a
///            deployment states and pruned by a running process. Longer than the content
///            it refers to, deliberately: an audit trail that expires with the object it
///            describes cannot answer a question asked afterwards.
///
/// -----------------------------------------------------------------------------
/// APPEND-ONLY. THERE IS NO UPDATE TIMESTAMP ON THIS MODEL, AND THAT IS THE POINT.
/// -----------------------------------------------------------------------------
///
/// A row is written once and never revised. No `updatedAt`, no soft-delete marker, no
/// status column that a later write could flip. A correction is a new row.
///
/// TWO CLASSES OF EVENT WRITE HERE, and the trigger set is deliberately wider than
/// "errors":
///
///   - EVERY AUTHORIZATION DENIAL, whether it came from the operation guard in
///     `apps/api/src/authz/guard.ts` or the projection guard beside it. A denial is the
///     interesting event precisely because nothing else records it: the request produced no
///     row, changed no state and returned no content, so without this table it leaves no
///     trace at all and a pattern of probing is invisible.
///   - EVERY ADMINISTRATIVE ACTION — role changes, invitation issuance and revocation,
///     conversation archival, unarchival, conversion and deletion, member removal, export,
///     and every change to workspace configuration.
///
/// THE ACTOR IS NULLABLE, AND THAT IS DELIBERATE RATHER THAN LAX: a denial can come from a
/// caller with NO VALID SESSION AT ALL, and that is exactly the attempt worth recording.
/// `actorType` carries `ANONYMOUS` for that case, so a null actor is a stated fact rather
/// than missing data.
///
/// NO PERSONAL VALUE AND NO SECRET MAY ENTER `context`, OR ANY OTHER COLUMN HERE. Content
/// never enters a row either; a reference does. An audit trail that copies message bodies
/// becomes a second uncontrolled read path for them, and one that copies personal values
/// defeats `S-PII` redaction — which names logs, error reports and analytics events
/// explicitly. `apps/api/src/observability/audit-log.ts` is the only writer, and it is
/// where that exclusion is enforced.
model AuditLogEntry {
  id String @id @default(cuid()) @map("id")

  /// Nullable for a pre-workspace event. See the tenancy note.
  workspaceId String? @map("workspace_id")

  /// WHO attempted it, server-derived and never caller-supplied — `R1` forbids resting any
  /// authorization decision on a caller-supplied actor identifier, and it forbids resting a
  /// record of one on it too. Nullable; see the doc-comment.
  actorUserId     String?        @map("actor_user_id")
  actorType       AuditActorType @map("actor_type")
  actorSessionRef String?        @map("actor_session_ref")

  /// WHAT they attempted, by the same identifier the guard's operation union uses, so a
  /// row and a policy name the same thing.
  action String @map("action")

  /// AGAINST WHICH OBJECT — a type and an identifier, never a copy of the object.
  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  outcome AuditOutcome @map("outcome")

  /// WHY IT WAS REFUSED — the failing policy and the capability it required, as a stable
  /// code rather than a rendered sentence. The sentence a person reads is authored in
  /// `packages/shared/src/copy/en.ts`.
  denialReasonCode String? @map("denial_reason_code")

  /// The request correlation identifier, so one row can be tied to the request that
  /// produced it across the log stream without either carrying the other's content.
  requestId String? @map("request_id")

  /// Structured context, permitted and bounded: NO PERSONAL VALUE AND NO SECRET MAY ENTER
  /// IT. See the doc-comment.
  context Json? @map("context")

  /// When it happened. The only instant on this row, because the row never changes.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([action, outcome, occurredAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_log_entry")
}

/// ENTITY     Infrastructure — the idempotency-key store. Not an entity.
/// TENANCY    TENANT-SCOPED and additionally scoped by the ACTING PRINCIPAL, which is the
///            scoping that actually matters here. Classified explicitly for
///            `packages/db/src/tenancy.ts` as scope-keyed.
/// RETENTION  `S-RETENTION` class: operational record, BOUNDED by `expiresAt` and pruned
///            by a running process. A table that only grows becomes an availability
///            problem on the busiest write path. The bound is a compile-time constant in
///            shared configuration rather than an observed value, so the environment
///            surface stays closed at its documented set and no number is written here.
///
/// THE DURABLE COUNTERPART OF `packages/shared/src/schemas/idempotency.ts`, which names
/// this file explicitly as the place its header contract is made real: "a retried mutation
/// is recognised rather than repeated, and a replay returns the original outcome". Without
/// a durable record, a client that never saw a response has no safe move — retrying risks a
/// duplicate and not retrying risks a lost write.
///
/// -----------------------------------------------------------------------------
/// KEYED BY SCOPE PLUS KEY, AND THE SCOPE IS NOT OPTIONAL
/// -----------------------------------------------------------------------------
///
/// The shared module states the obligation it cannot itself enforce: a key is scoped PER
/// ACTOR, server-side, and "the durable store is keyed by the principal the acting session
/// identifies TOGETHER WITH THE KEY — never by the key alone". Under a key-only store,
/// presenting somebody else's key would return their result, which would turn a header into
/// a read primitive. The uniqueness constraint below is over the principal, the operation
/// and the key, so a replay is served only to the same principal that performed the
/// original mutation.
///
/// -----------------------------------------------------------------------------
/// THE FINGERPRINT IS WHAT MAKES A CONFLICT DETECTABLE RATHER THAN SILENT
/// -----------------------------------------------------------------------------
///
/// Three behaviours follow from the columns below. A FIRST ARRIVAL inserts the row INSIDE
/// THE SAME TRANSACTION AS THE MUTATION, so a committed effect and its record commit
/// together or not at all. A REPEAT ARRIVAL with the same key and a MATCHING fingerprint
/// returns the stored outcome without re-executing. A REPEAT ARRIVAL with the same key and
/// a DIFFERENT fingerprint is REFUSED rather than served, because two different requests
/// sharing a key is a client defect and answering one with the other's result would hide
/// it. Without the fingerprint the third case is indistinguishable from the second.
///
/// FOR SENDING A MESSAGE THIS STORE IS THE SECOND LINE RATHER THAN THE FIRST: the
/// uniqueness constraint on `Message`'s conversation-and-client-identifier pair already
/// makes a duplicate send unrepresentable.
model IdempotencyKey {
  id          String @id @default(cuid()) @map("id")
  workspaceId String @map("workspace_id")

  /// The acting principal, server-derived. Not nullable: an unauthenticated caller has no
  /// mutation to make idempotent.
  userId String @map("user_id")

  /// The route or operation the key was presented against, so one key reused across two
  /// endpoints is two rows rather than one collision.
  operation String @map("operation")

  /// The client-supplied key. Its format and validation are owned by
  /// `packages/shared/src/schemas/idempotency.ts`; this column stores what that schema
  /// admitted.
  idempotencyKey String @map("idempotency_key")

  /// The fingerprint of the request payload. A hex digest, whose length bounds and pattern
  /// are owned by the shared schema. See the doc-comment for why it is load-bearing.
  requestFingerprint String @map("request_fingerprint")

  outcome IdempotencyOutcome @map("outcome")

  /// The stored first response, returned verbatim on a matching replay so that a client
  /// receives the same answer twice rather than two different truths.
  storedResponse Json? @map("stored_response")

  /// The response status the first execution produced, stored beside the body so a replay
  /// reproduces the whole answer rather than half of it.
  storedStatusCode Int? @map("stored_status_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// The absolute expiry. Resolved at insertion from the compile-time bound; a duration
  /// here would be a second copy of that bound.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, idempotencyKey])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("idempotency_key")
}
