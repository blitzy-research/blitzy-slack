{
  "name": "@relay/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "cd ../.. && prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "seed": "pnpm run build && node --env-file=../../.env dist/prisma/seed.js",
    "seed:bulk": "pnpm run build && node --env-file=../../.env dist/prisma/seed-bulk.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@relay/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
