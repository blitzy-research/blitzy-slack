{
  "name": "@relay/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/tokens.module.css": "./src/styles/tokens.module.css",
    "./styles/reset.css": "./src/styles/reset.css",
    "./styles/theme-light.css": "./src/styles/theme-light.css",
    "./styles/theme-dark.css": "./src/styles/theme-dark.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project ui"
  },
  "dependencies": {
    "@lexical/react": "0.49.0",
    "@relay/shared": "workspace:*",
    "lexical": "0.49.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
