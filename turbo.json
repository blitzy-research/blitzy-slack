{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", ".npmrc", ".nvmrc"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "API_HOST",
    "API_PORT",
    "DATABASE_URL",
    "EMAIL_FROM",
    "LOG_LEVEL",
    "PUBLIC_API_URL",
    "PUBLIC_APP_URL",
    "PUBLIC_SOCKET_URL",
    "REDIS_URL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SESSION_COOKIE_NAME",
    "SESSION_SECRET",
    "SMTP_URL",
    "WEB_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed:bulk": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
