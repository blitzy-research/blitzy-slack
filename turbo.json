{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": [
    ".env.example",
    ".npmrc",
    ".nvmrc",
    "eslint.config.js",
    "pnpm-lock.yaml",
    "prettier.config.cjs",
    "tsconfig.base.json",
    "vitest.config.ts"
  ],
  "globalEnv": ["CI", "NODE_ENV"],
  "globalPassThroughEnv": [
    "API_HOST",
    "API_PORT",
    "DATABASE_URL",
    "EMAIL_FROM",
    "EXTERNAL_ACCEPTANCE_WINDOW_DAYS",
    "GUEST_CHANNEL_LIMIT",
    "INVITE_EXPIRY_DAYS",
    "LOG_LEVEL",
    "PUBLIC_API_URL",
    "PUBLIC_APP_URL",
    "PUBLIC_SOCKET_URL",
    "RATE_LIMIT_AUTH_MAX",
    "RATE_LIMIT_AUTH_WINDOW_SECONDS",
    "RATE_LIMIT_SEND_MAX",
    "RATE_LIMIT_SEND_WINDOW_SECONDS",
    "REDIS_URL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_PUBLIC_ENDPOINT",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "SESSION_ABSOLUTE_TIMEOUT_HOURS",
    "SESSION_COOKIE_NAME",
    "SESSION_IDLE_TIMEOUT_MINUTES",
    "SESSION_SECRET",
    "SMTP_URL",
    "TEST_DATABASE_URL",
    "WEB_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@relay/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["PUBLIC_API_URL", "PUBLIC_APP_URL", "PUBLIC_SOCKET_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "@relay/shared#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@relay/db#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@relay/ui#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@relay/api#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@relay/web#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DOCKER_CERT_PATH", "DOCKER_HOST", "DOCKER_TLS_VERIFY", "TESTCONTAINERS_*"]
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DOCKER_CERT_PATH", "DOCKER_HOST", "DOCKER_TLS_VERIFY", "TESTCONTAINERS_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@relay/web#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "with": ["@relay/api#dev"]
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed:bulk": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
