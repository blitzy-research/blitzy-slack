# Dependency resolution posture for the workspace.
#
# engine-strict is deliberately left OFF. Two pinned development dependencies
# declare a Node engine above the project runtime (Node 20.20.2):
#   - @testing-library/jest-dom@7.0.1 -> engines.node >= 22
#   - testcontainers@12.1.0           -> engines.node >= 22.22
# Turning engine-strict on would hard-fail install on the pinned set instead of
# warning, so the mismatch is reported as a warning and documented instead.
engine-strict=false

# Internal packages are linked from the workspace, never fetched from a registry.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Keep resolution reproducible: exact versions, no silent range widening.
save-exact=true
resolution-mode=highest

# Fail fast in CI rather than silently resolving around a stale lockfile.
strict-peer-dependencies=false
auto-install-peers=true
