{
  "name": "@relay/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP and WebSocket server: authorization chokepoint, realtime gateway, domain services.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "bench": "vitest bench --dir test/bench",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/index.js",
    "start": "node --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@aws-sdk/s3-request-presigner": "3.1110.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3",
    "@relay/db": "workspace:*",
    "@relay/shared": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "ioredis": "5.11.1",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "ulid": "3.0.2",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.1",
    "@types/ws": "8.18.1",
    "pino-pretty": "13.1.3",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
