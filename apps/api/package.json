{
  "name": "@relay/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --build tsconfig.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/src/index.js",
    "test": "vitest run test/unit --config /dev/null",
    "test:integration": "vitest run test/integration --config /dev/null --testTimeout=120000 --no-file-parallelism",
    "bench": "vitest bench test/bench/*.bench.ts --config /dev/null",
    "lint": "eslint ."
  },
  "dependencies": {
    "@relay/shared": "workspace:*",
    "@relay/db": "workspace:*",
    "fastify": "5.12.0",
    "@fastify/websocket": "11.3.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.3",
    "ws": "8.21.3",
    "ioredis": "5.11.1",
    "pino": "10.3.1",
    "@node-rs/argon2": "2.1.0",
    "ulid": "3.0.2",
    "nodemailer": "9.0.5",
    "@aws-sdk/client-s3": "3.1110.0",
    "@aws-sdk/s3-request-presigner": "3.1110.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.1.0"
  }
}
