# =============================================================================
# Relay - the environment surface, committed
# =============================================================================
# This template IS the environment surface. Copying it produces a working local
# system with no external account of any kind: mail is captured by a local sink
# instead of being sent, and object storage is a local S3-compatible service.
#
#   cp .env.example .env
#   docker compose up -d
#
# NOTHING HERE IS A REAL CREDENTIAL. Every value is a local development default,
# and the two that would matter in a deployed system - the session secret and
# the object-storage keys - are obvious placeholders that MUST be replaced
# outside local development.
#
# -----------------------------------------------------------------------------
# THE CONFIGURATION SURFACE IS SPLIT IN TWO, AND THIS IS HALF OF IT
# -----------------------------------------------------------------------------
# INVARIANTS are rules rather than settings and are deliberately NOT listed
# here: the channel-name grammar with its eighty-character ceiling, the
# pre-selected channel visibility, the snippet's content-only-required rule, the
# password-hashing parameters and the realtime replay-window bound all live in
# packages/shared/src/config/constants.ts, beyond the reach of any variable.
# Listing one here would hand a deployment a downgrade path - most sharply for
# the hashing parameters, where an override IS the downgrade.
#
# CONFIGURABLE DEFAULTS are settings, and every one is listed here with the
# default this project chose. A literal value at a point of use is a defect:
# each consumer imports the constant, and this file documents what it resolves
# to. See docs/decisions/observed-values.md for the evidence behind each.
#
# -----------------------------------------------------------------------------
# DURATIONS ARE CONFIGURED HERE; RECORDS STORE ABSOLUTE TIMESTAMPS
# -----------------------------------------------------------------------------
# Every day-, hour- and minute-valued setting below is an INPUT to a resolution
# that happens once, at the moment something is issued. The resolved moment is
# what gets written to the record - never the duration itself. That is what lets
# a default change here without invalidating a single record already written,
# and it is why lengthening a window never extends something already issued and
# shortening one never cuts it short. Ending outstanding access sooner is an
# explicit, authorized, audited revocation, never a rewritten date.
#
# -----------------------------------------------------------------------------
# THREE VIEWS OF ONE TRUTH
# -----------------------------------------------------------------------------
# This file, packages/shared/src/config/env.ts and
# docs/decisions/observed-values.md describe the same values and MUST move
# together. Adding a variable, renaming one or changing a default means editing
# all three in the same change. The operating manual's variable table in
# README.md is the fourth reader and follows the same rule.
#
# Field order below follows env.ts so the two can be read side by side: the
# connection and credential surface first, then the five configurable product
# defaults, then the keys that exist for the container tool. The container-tool
# block at the foot of this file is what makes the documented compose command
# work from the repository root - see docs/decisions/compose-and-env.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Selects development behaviour across the toolchain: unminified builds, the
# human-readable log formatter, and the console mail transport below.
NODE_ENV=development

# Minimum severity the structured logger emits. Raise to `warn` to quieten a
# run; drop to `debug` while diagnosing one. `info` is the documented default
# because it keeps the authorization-denial audit trail visible without burying
# it in per-request noise.
LOG_LEVEL=info

# Interface the API binds. The unspecified address is deliberate: it makes the
# server reachable from a container on the same host as well as from the host
# itself, which the container-backed test suite depends on.
API_HOST=0.0.0.0

# Port the API listens on. It is a variable rather than a literal because the
# cross-instance fan-out proof runs a SECOND API instance alongside the first
# and reaches it on a different port; a hardcoded port would make that proof
# impossible to run. Keep this in step with PUBLIC_API_URL and PUBLIC_SOCKET_URL
# below, which the client's dev-server proxy resolves against.
API_PORT=3001

# Port the client's dev server listens on. Keep in step with PUBLIC_APP_URL.
WEB_PORT=5173


# -----------------------------------------------------------------------------
# PostgreSQL 16 - primary datastore and full-text search
# -----------------------------------------------------------------------------
# The four keys in this block are read by the container tool when it starts the
# stack, never by application code, which receives the same facts already
# composed into the connection string beneath them. Changing one means changing
# that connection string in the same edit.

POSTGRES_USER=relay
POSTGRES_PASSWORD=relay_local_only
POSTGRES_DB=relay
POSTGRES_PORT=5432

# The connection string application code actually uses. Required with no
# default: a datastore location is the single most damaging value to guess on a
# deployment's behalf, because a wrong one lets a process start and read and
# write somewhere nobody intended, silently.
DATABASE_URL=postgresql://relay:relay_local_only@localhost:5432/relay?schema=public

# Fallback for suites that do not provision their own throwaway database. The
# container-backed integration suite starts a disposable instance per run and
# supplies its own connection string, so this is used only when that route is
# unavailable. A separate database, never the one above: an integration run
# truncates tables.
TEST_DATABASE_URL=postgresql://relay:relay_local_only@localhost:5432/relay_test?schema=public


# -----------------------------------------------------------------------------
# Redis 7 - presence, socket registry, cross-instance fan-out
# -----------------------------------------------------------------------------
# Published port for the container tool; the connection string is what
# application code reads.
REDIS_PORT=6379

# Presence heartbeats, the socket registry, and the publish/subscribe bus that
# carries a message to sockets held by another API instance. The bus is a
# transport and never a source of truth: ordering and completeness come from the
# durable per-conversation sequence in the datastore, which the client
# reconciles against over HTTP after a reconnect.
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Signs the cookie that carries the acting session. A session is a server-side
# revocable record behind an HTTP-only, same-site cookie - no token is ever put
# in browser storage - and every server-side authorization check is evaluated
# against that session, so a guessable secret is not a weak setting, it is a
# forgeable identity. THIS PLACEHOLDER MUST BE REPLACED with a long random
# value outside local development. At least 32 characters, and longer is never
# worse.
SESSION_SECRET=development-only-session-secret-replace-before-any-deployment

# Name of that cookie. Configurable so two deployments can share a hostname
# without colliding.
SESSION_COOKIE_NAME=relay_session


# -----------------------------------------------------------------------------
# Object storage (S3-compatible) - pre-signed uploads, bytes never proxied
# -----------------------------------------------------------------------------

# Endpoint the API signs against, reached from inside the network.
S3_ENDPOINT=http://localhost:9000

# Endpoint the BROWSER resolves a pre-signed URL against. Identical locally and
# deliberately separate, because a deployment where the API reaches storage on
# an internal address must still hand the client one it can reach. It is also
# the origin the content-security policy admits for images, media and
# connections; nothing else is added to that policy for storage.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Region label. The local service ignores it, but the signing algorithm does
# not, so it must be set and must match whatever a real deployment uses.
S3_REGION=us-east-1

# Bucket uploads land in. The stack's bootstrap step creates it on first start
# and leaves it private - uploads are pre-signed, so it is never public.
S3_BUCKET=relay-uploads

# Credentials for the local storage service. Placeholders, matched by the
# container tool when it starts that service; replace both outside local
# development.
S3_ACCESS_KEY_ID=relay_local_access
S3_SECRET_ACCESS_KEY=relay_local_secret

# Addresses buckets as a path rather than a subdomain. Required by the local
# service, which serves one host; a managed provider usually wants `false`.
S3_FORCE_PATH_STYLE=true

# Published ports for the container tool: the storage API, then its own console.
OBJECT_STORE_PORT=9000
OBJECT_STORE_CONSOLE_PORT=9001


# -----------------------------------------------------------------------------
# Email - captured locally, no provider account required
# -----------------------------------------------------------------------------

# Transport the local sink listens on. It accepts any credentials and sends
# nothing onward, so verification codes, invitations and reset links are all
# readable in its web interface instead of reaching a real inbox.
SMTP_URL=smtp://localhost:1025

# Which transport the provider-agnostic mail adapter selects: `console` writes
# each message to the log, `smtp` hands it to the transport above. `console` is
# the development default because it needs no service running at all; the local
# sink is there for anyone who would rather read mail in a browser.
EMAIL_TRANSPORT=console

# Sender address. Quoted because the value contains angle brackets: this file is
# read by the container tool and the configuration loader, and is also sourced
# by shells. The domain is a placeholder that cannot resolve, which is the point
# - nothing should ever reply to it.
EMAIL_FROM="Relay <no-reply@relay.localhost>"

# Published ports for the container tool: the sink's SMTP port, then the web
# interface where captured mail is read.
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025


# -----------------------------------------------------------------------------
# Public origins
# -----------------------------------------------------------------------------

# Where the client is served. The server builds every link it puts in an email
# against this, so it must be an absolute origin the recipient can actually open.
PUBLIC_APP_URL=http://localhost:5173

# Where the API is served. The client's dev server proxies to this, so the
# browser sees ONE origin in development: the session cookie stays first-party
# and the WebSocket upgrade carries it with no cross-origin exception.
PUBLIC_API_URL=http://localhost:3001

# Socket origin, as the server understands it. Distinct from the two above
# because a deployment may terminate WebSocket traffic somewhere else entirely.
PUBLIC_SOCKET_URL=ws://localhost:3001/realtime


# -----------------------------------------------------------------------------
# Client-exposed configuration - the ONLY two variables the browser ever sees
# -----------------------------------------------------------------------------
# The bundler exposes exactly the VITE_-prefixed namespace to the browser
# bundle. Anything named this way is therefore PUBLIC, shipped verbatim to every
# visitor, and readable with a text editor. Nothing secret may ever carry this
# prefix: not the session secret, not a connection string, not a storage key.
# The two names below are origins, and origins are not secrets.
#
# Both are SAME-ORIGIN paths rather than absolute URLs, which is what keeps the
# session cookie first-party and lets the content-security policy admit only the
# app's own origin for connections. The dev server proxies both paths to the API
# in development and a reverse proxy does the same in a deployment, so neither
# value carries a port and neither changes between the two. The socket client
# resolves its path against the current page and swaps the scheme to `ws` or
# `wss` to match.
VITE_API_URL=/api
VITE_SOCKET_URL=/realtime


# -----------------------------------------------------------------------------
# Rate limits - authentication and send paths
# -----------------------------------------------------------------------------
# Requests permitted per window, per caller. These protect the two paths worth
# attacking cheaply: credential submission and message send.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_SEND_MAX=60
RATE_LIMIT_SEND_WINDOW_SECONDS=60


# =============================================================================
# Configurable product defaults
# =============================================================================
# Exactly five, and the set is closed: a sixth here with no row in
# docs/decisions/observed-values.md, or a row there with no entry here, is a
# defect. Each is a CHOSEN DEFAULT rather than an observed invariant - a figure
# read from a single frame is a hypothesis about a default, so the mechanism it
# belongs to ships as working, enforced functionality and the figure becomes a
# documented, overridable setting. Build the timer; configure the duration.
#
# Each row in that record carries the value, the frame it was read from, whether
# the frame showed an ORIGINAL duration or the REMAINDER of one already running,
# the default chosen and the reasoning. That distinction is what does the real
# work: identically shaped evidence read the two ways leads to opposite
# conclusions, as the first two settings below demonstrate.
# -----------------------------------------------------------------------------

# Lifetime of a workspace invitation link, in days.
#
# Two surfaces state two different lifetimes for the same kind of link: an
# in-product confirmation reads nineteen days (frame 46) while an administration
# table reads one month. Nineteen is not a conventional configured lifetime, and
# a link issued some days before capture would report exactly that figure as a
# REMAINDER - so thirty days is the chosen conventional round default and the
# reading is kept as corroborating evidence rather than adopted as the setting.
# The contradiction is recorded, not corrected in place. Enforced on redemption
# against the absolute expiry stored on the invitation.
# Reasoning: docs/decisions/observed-values.md - contradiction:
# docs/decisions/catalog-defects.md
INVITE_EXPIRY_DAYS=30

# Window in which an external collaborator may accept an invitation, in days.
#
# Read as fourteen days (frame 500) and adopted UNCHANGED, because that surface
# describes a window that has not begun to run: it is an ORIGINAL duration with
# nothing elapsed, so there is no remainder to reconstruct and the round-default
# substitution that governs the setting above does not apply here. Identically
# shaped evidence to the one above, read the other way.
# Reasoning: docs/decisions/observed-values.md
EXTERNAL_ACCEPTANCE_WINDOW_DAYS=14

# Channels a guest may be scoped to without the separate multi-channel
# allowance.
#
# No figure is stated anywhere in the specification - the distinction is
# evidenced (frames 49, 50), the number is not. Channel scope is required for a
# guest and a separate allowance exists to admit more than one, so the budget
# without that allowance is exactly one: the smallest coherent behaviour
# consistent with the evidence, where anything larger would pre-grant what the
# allowance exists to grant. Enforced server-side when a guest is scoped to a
# further channel. The billing consequence of holding that allowance is a rule
# rather than a setting and is not configurable; only this limit is.
# Reasoning: docs/decisions/observed-values.md
GUEST_CHANNEL_LIMIT=1

# Idle bound on a session, in minutes. Authored: a single authenticated capture
# cannot show a session ending, so no frame evidences this. A day-long bound
# keeps a returning member's session usable across one working day while still
# ending an unattended one. Enforced server-side against the absolute expiry
# stored on the session record.
# Reasoning: docs/decisions/observed-values.md
SESSION_IDLE_TIMEOUT_MINUTES=1440

# Absolute maximum lifetime of a session, in hours - thirty days. Authored for
# the same reason. An idle bound alone would let a session live indefinitely
# under regular use, so a maximum is written once at sign-in beside it. The two
# bounds are INDEPENDENT: reaching either ends the session, and neither is
# derived from the other.
# Reasoning: docs/decisions/observed-values.md
SESSION_ABSOLUTE_TIMEOUT_HOURS=720


# =============================================================================
# Container-tool reconciliation
# =============================================================================
# These two keys are the whole reason the documented command works.
#
# The clean-machine sequence runs `docker compose up -d` from the repository
# ROOT, verbatim. Given no other instruction the tool looks for its file in the
# directory it was invoked from - so the plain reading of that line is a compose
# file at the root. The project's write boundary does not allow one: new code
# goes only under apps/, packages/, infra/ and tools/, and infra/ is where the
# compose file therefore lives. Moving it to the root would breach the boundary
# for no benefit, and documenting a different command would make the
# documentation wrong instead. Fidelity is preserved by making the literal
# documented command work.
#
# The mechanism is that the tool reads a .env file from the directory it is
# invoked in BEFORE it resolves which compose file to load, so both keys can be
# supplied by the file the sequence created one line earlier. Invoked from a
# subdirectory, or with the copy step skipped, neither key is read and the
# fallback is the explicit `-f infra/docker-compose.yml` form.
# Reasoning: docs/decisions/compose-and-env.md
COMPOSE_FILE=infra/docker-compose.yml

# Fixes the project name so the same containers, volumes and network are found
# every time. The tool otherwise derives it from the checkout directory's name,
# and a checkout directory is not a stable input.
COMPOSE_PROJECT_NAME=relay

# Offset convention for parallel checkouts, read by whoever is setting them up
# rather than by application code or by the tool itself: give each clone a
# distinct integer and shift every published port above by that amount, so two
# checkouts can run their stacks at once. Zero is the single-clone default and
# needs no other change. See infra/README.md.
CLONE_INDEX=0
