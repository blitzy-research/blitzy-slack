# =============================================================================
# Relay - environment template
# =============================================================================
# Copy this file to .env and the local system works with no external accounts:
#
#   cp .env.example .env
#
# Every value here is a non-sensitive local development default. Nothing in this
# file is a real credential. The two secrets that matter in a deployed system -
# SESSION_SECRET and the object-storage keys - are obvious placeholders and must
# be replaced outside development.
#
# Product values are split in two on purpose:
#   * INVARIANTS live in packages/shared/src/config/constants.ts and are NOT
#     listed here, because an environment variable must never weaken them.
#   * CONFIGURABLE DEFAULTS live in packages/shared/src/config/env.ts and are
#     listed here, each with the default the project chose.
# A literal value at a point of use is a defect: every consumer imports the
# constant instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose reconciliation
# -----------------------------------------------------------------------------
# The compose file lives under infra/ while the documented command is run from
# the repository root. Compose reads this file before it resolves either key, so
# `docker compose up -d` works verbatim from the root.
COMPOSE_FILE=infra/docker-compose.yml
COMPOSE_PROJECT_NAME=relay

# Parallel checkouts: set CLONE_INDEX to a distinct integer per clone and shift
# every published port below by that offset (see infra/README.md). CLONE_INDEX=0
# is the single-clone default and needs no other change.
CLONE_INDEX=0

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SOCKET_URL=ws://localhost:3001/realtime

# -----------------------------------------------------------------------------
# PostgreSQL 16 - primary datastore and full-text search
# -----------------------------------------------------------------------------
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay_local_only
POSTGRES_DB=relay
POSTGRES_PORT=5432
DATABASE_URL=postgresql://relay:relay_local_only@localhost:5432/relay?schema=public
# Integration tests provision their own throwaway database; this is the fallback
# used when a container-backed database is not being started per test run.
TEST_DATABASE_URL=postgresql://relay:relay_local_only@localhost:5432/relay_test?schema=public

# -----------------------------------------------------------------------------
# Redis 7 - presence, socket registry, cross-instance fan-out
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Sessions and password verifiers
# -----------------------------------------------------------------------------
# Server-side revocable session records behind an HTTP-only cookie. No token is
# ever placed in local storage.
SESSION_SECRET=development-only-session-secret-replace-before-any-deployment
SESSION_COOKIE_NAME=relay_session

# -----------------------------------------------------------------------------
# Object storage (S3 compatible) - pre-signed uploads, bytes never proxied
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=relay-uploads
S3_ACCESS_KEY_ID=relay_local_access
S3_SECRET_ACCESS_KEY=relay_local_secret
S3_FORCE_PATH_STYLE=true
OBJECT_STORE_PORT=9000
OBJECT_STORE_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Email - local capture, no provider account required
# -----------------------------------------------------------------------------
SMTP_URL=smtp://localhost:1025
# Quoted because the value contains angle brackets: this file is sourced by
# shells as well as read by the configuration loader and by Compose.
EMAIL_FROM="Relay <no-reply@relay.localhost>"
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# -----------------------------------------------------------------------------
# Configurable product defaults
# -----------------------------------------------------------------------------
# Invitation link lifetime. One frame reads 19 days, an administration table
# reads one month for the same kind of link; 30 days is the chosen round default
# and the record stores an absolute expiry timestamp, never a duration.
INVITE_EXPIRY_DAYS=30

# Window in which an external collaborator may accept an invitation.
EXTERNAL_ACCEPTANCE_WINDOW_DAYS=14

# Channel budget for a single-channel guest.
GUEST_CHANNEL_LIMIT=1

# Session bounds: idle expiry and absolute maximum lifetime.
SESSION_IDLE_TIMEOUT_MINUTES=1440
SESSION_ABSOLUTE_TIMEOUT_HOURS=720

# -----------------------------------------------------------------------------
# Rate limits (authentication and send paths)
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_SEND_MAX=60
RATE_LIMIT_SEND_WINDOW_SECONDS=60
