{
  "name": "@relay/ac-manifest",
  "version": "0.0.0",
  "private": true,
  "description": "Regenerates the acceptance-criteria traceability manifest and reconciles the per-area subtotals.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "pnpm run build && node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
