{
  "name": "@relay/ac-manifest",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.20.2 <21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "ac:manifest": "tsc -p tsconfig.json && node dist/index.js",
    "ac:manifest:check": "tsc -p tsconfig.json && node dist/index.js --check"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.43"
  }
}
